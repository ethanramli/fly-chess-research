{
  "name": "fly-chess-research-feasibility",
  "private": true,
  "type": "module",
  "scripts": {
    "train": "node --max-old-space-size=256 .codebase/scripts/supervised-baselines/train-pilot.mjs",
    "evaluate": "node --max-old-space-size=256 .codebase/scripts/supervised-baselines/evaluate-position.mjs",
    "fly:pawn": "node --max-old-space-size=256 .codebase/scripts/evaluation-and-performance/fly-pawn-move.mjs",
    "puzzle:round": "node --max-old-space-size=256 .codebase/scripts/puzzle-learning/puzzle-round.mjs",
    "condition:fly": "node --max-old-space-size=256 .codebase/scripts/neural-learning/condition-fly.mjs",
    "validate:learning": "node --max-old-space-size=256 .codebase/scripts/neural-learning/validate-learning.mjs",
    "play": "node --max-old-space-size=256 .codebase/scripts/browser/play-server.mjs",
    "test": "node --test --test-concurrency=1 .codebase/tests/runtime/*.test.mjs .codebase/tests/supervised-baselines/*.test.mjs .codebase/tests/neural-learning/*.test.mjs .codebase/tests/chess-input/*.test.mjs .codebase/tests/puzzle-learning/*.test.mjs .codebase/tests/search-and-feedback/*.test.mjs .codebase/tests/evaluation-and-performance/*.test.mjs",
    "fetch:graph": "node .codebase/scripts/runtime/fetch-graph.mjs",
    "benchmark": "node --max-old-space-size=256 .codebase/scripts/evaluation-and-performance/benchmark.mjs",
    "flybench": "node --max-old-space-size=256 .codebase/scripts/evaluation-and-performance/flybench.mjs --cpu-duty 0.5",
    "fetch:nova": "node .codebase/scripts/evaluation-and-performance/fetch-nova.mjs",
    "test:flybench": "node --test .codebase/tests/evaluation-and-performance/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "onnxruntime-web": "1.30.0"
  }
}
