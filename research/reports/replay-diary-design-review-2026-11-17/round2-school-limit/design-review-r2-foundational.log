31:// Sparse cosine similarity keyed by index. Answers by similarity only; never learns.
32:const vector = cue => new Map(cue.map(x => [x.index, x.current]));
33:const norm = v => Math.sqrt([...v.values()].reduce((sum, x) => sum + x * x, 0));
34:const dot = (a, b) => [...a].reduce((sum, [k, x]) => sum + (b.has(k) ? x * b.get(k) : 0), 0);
35:const cosine = (a, b) => { const na = norm(a), nb = norm(b); return na === 0 || nb === 0 ? 0 : dot(a, b) / (na * nb); };
36:
37:export function similarBoardRecall(cue, stored) {
38:  if (stored.some(({ value }) => value !== -1 && value !== 1)) throw Error('Stored value must be -1 or +1');
39:  const query = vector(cue);
40:  let best = null;
41:  for (const entry of stored) {
42:    const similarity = cosine(query, vector(entry.cue));
43:    if (best === null || similarity > best.similarity) best = { value: entry.value, similarity };
44:  }
45:  return best === null || best.similarity === 0 ? { value: 0, similarity: 0 } : best;
46:}
