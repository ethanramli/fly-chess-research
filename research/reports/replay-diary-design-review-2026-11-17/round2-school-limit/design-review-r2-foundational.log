186:  if (boards.filter(b => b.expandPass).length >= 2) return { verdict: 'expand to 12 boards', reason: `${boards.filter(b => b.expandPass).length} boards meet all three expansion cutoffs`, failures, boards };
187:  if (quietEligible.every(b => under(b.quiet.advantage, RULES.drop))) return { verdict: 'drop the quiet, rescaled circuit', reason: 'the quiet circuit beats swapped labels by under 5 points on every board that qualifies in it', failures, boards };
