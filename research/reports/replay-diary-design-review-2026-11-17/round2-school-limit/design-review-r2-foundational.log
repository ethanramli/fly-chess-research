6:// Scores every candidate from one unchanged memory state, forward and then reversed.
7:export function frozenScores(candidates, score, fingerprint) {
8:  if (!Array.isArray(candidates) || candidates.length === 0) throw Error('No candidates');
9:  const before = fingerprint();
10:  const scoreOne = candidate => {
11:    const s = score(candidate);
12:    if (!Number.isFinite(s)) throw Error('Score is not finite');
13:    if (fingerprint() !== before) throw Error('Memory changed during scoring');
14:    return s;
15:  };
16:  const forward = candidates.map(scoreOne);
17:  const reverse = new Array(candidates.length);
18:  for (let i = candidates.length - 1; i >= 0; i--) reverse[i] = scoreOne(candidates[i]);
19:  if (forward.some((s, i) => !Object.is(s, reverse[i]))) throw Error('Candidate order changed a score');
20:  return forward;
21:}
22:
23:// Same key rule as cue() in audit-long-term-memory-v1-live.mjs: [index, current] pairs sorted by index.
24:export const cueKey = cue => JSON.stringify(cue.map(x => [x.index, x.current]).sort((a, b) => a[0] - b[0]));
25:
26:export function exactRepeats(testCues, trainingCues) {
27:  const seen = new Set(trainingCues.map(cueKey));
28:  return testCues.flatMap((cue, i) => seen.has(cueKey(cue)) ? [i] : []);
29:}
