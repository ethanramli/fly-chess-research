180:    row.expandPass = row.eligibleInBoth && atLeast(row.quiet.conditions.correct.closure, RULES.closure) && atLeast(row.quiet.advantage, RULES.advantage)
181:      && atLeast(row.quiet.advantage - row.current.advantage, RULES.overCurrent);
182:    return row;
