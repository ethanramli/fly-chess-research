131:    for (const b of r.boards) {
132:      const want = expected.get(b.boardId);
133:      if (!want) continue; // wrong boards, reported above
134:      const name = `${circuit} ${condition} ${b.boardId}`;
135:      if (!same(b.experiences, want.experiences) || !same(b.safeMoves, want.safeMoves)) fail(`${name}: lesson list or safe captures differ from the board packet`);
136:      // Every pass must hold the packet's four lessons, in order, with the labels the condition assigns: 24 in all.
137:      const labels = lessonLabels(want.experiences, condition), n = labels.length;
138:      if (b.lessons.length !== PASSES * n || b.lessons.some((l, k) => l.pass !== Math.floor(k / n) + 1 || l.index !== k % n || l.move !== labels[k % n].move || l.label !== labels[k % n].label))
139:        fail(`${name}: lessons missing, repeated, out of order or wrongly labelled (${b.lessons.length} recorded, ${PASSES * n} expected)`);
140:      if (b.checkpoints.length !== PASSES + 1 || b.checkpoints.some((c, i) => c.pass !== i || !same(Object.keys(c.scores).sort(), want.legal)))
