153:  if (failures.length) return { verdict: 'inconclusive', reason: 'a required check failed', failures, boards: [] };
154:  // Fresh start: the three conditions of a circuit begin from identical scores.
155:  for (const circuit of Object.keys(CIRCUITS)) BOARD_IDS.forEach((id, i) => {
