42:  const best = xs => xs.reduce((a, b) => (b.score > a.score ? b : a));
43:  const safeList = list.filter(s => safe.has(s.move)), otherList = list.filter(s => !safe.has(s.move));
44:  if (!safeList.length || !otherList.length) throw Error('Board needs a safe capture and another legal move');
