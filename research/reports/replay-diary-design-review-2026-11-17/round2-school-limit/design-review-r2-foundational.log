50:// Share of the edge-weighted rate difference between two moves that survives capping at scale; null when the rates are identical.
51:export function capKept(a, b, weights, scale) {
52:  let original = 0, kept = 0;
53:  for (let k = 0; k < weights.length; k++) {
54:    original += weights[k] * Math.abs(a[k] - b[k]);
55:    kept += weights[k] * Math.abs(Math.min(a[k], scale) - Math.min(b[k], scale));
56:  }
57:  return original === 0 ? null : kept / original;
