48:// Locked pass rule for twin pairs. Game-level bootstrap of primary-minus-comparator pair wins.
49:export function pairGate({ arms, games, primary, comparators, minCorrect, minMargin, resamples = 10000, seed = 20261103 }) {
50:  if (games.length === 0) throw Error('No games');
51:  if (comparators.length === 0) throw Error('No comparators');
52:  for (const name of [primary, ...comparators]) if (!Array.isArray(arms[name])) throw Error(`Missing arm ${name}`);
53:  for (const [name, values] of Object.entries(arms)) if (values.length !== games.length) throw Error(`Arm ${name} length differs from games`);
54:  const count = xs => xs.filter(Boolean).length;
55:  const P = arms[primary], correct = count(P);
56:  const groups = new Map();
57:  games.forEach((game, i) => { if (!groups.has(game)) groups.set(game, []); groups.get(game).push(i); });
58:  const G = [...groups.values()];
59:  const result = {};
60:  comparators.forEach((c, k) => {
61:    const C = arms[c], rand = mulberry32(seed ^ k);
62:    const sums = Array.from({ length: resamples }, () => {
63:      let sum = 0;
64:      for (let d = 0; d < G.length; d++) {
65:        for (const i of G[Math.floor(rand() * G.length)]) sum += (P[i] ? 1 : 0) - (C[i] ? 1 : 0);
66:      }
67:      return sum;
68:    });
69:    sums.sort((a, b) => a - b);
70:    result[c] = { margin: correct - count(C), lower: sums[Math.floor(0.025 * resamples)] };
71:  });
72:  const pass = correct >= minCorrect && Object.values(result).every(r => r.margin >= minMargin && r.lower > 0);
73:  return { pass, correct, total: games.length, comparators: result };
74:}

