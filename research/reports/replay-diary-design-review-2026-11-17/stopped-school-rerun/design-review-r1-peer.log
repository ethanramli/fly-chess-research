  32: // Mean firing per dopamine type (rate / 1.5, as in v2) and the learning signal per output type.
  33: export function dopamineSignal(h, danCells) {
  34:   const danMean = Object.fromEntries(DAN_TYPES.map(t => [t, avg(danCells[t].map(j => Math.max(0, h[j]) / ACT))]));
  35:   const D = Object.fromEntries([...VALENCE.keys()].map(m => [m, DAN_TYPES.reduce((sum, t) => sum + (W[t][m] ?? 0) * danMean[t], 0)]));
