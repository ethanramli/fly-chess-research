  13: // Closures are ratios of score differences, so a result meant to sit exactly on a cutoff can land a hair either side
  14: // (with the real first board's gap, scores built to close 20% compute as 0.19999999999994725). That rounding is about 1e-13;
  15: // 1e-9 (a billionth of the gap) is far above it and far below any difference that matters, so a value within 1e-9 of a cutoff
  16: // counts as on it. The cutoffs are unchanged.
  17: export const CUTOFF_SLACK = 1e-9;
  18: export const atLeast = (value, cutoff) => value >= cutoff - CUTOFF_SLACK; // "at least 20%": exactly 20% meets it
  19: export const under = (value, cutoff) => value < cutoff - CUTOFF_SLACK; // "under 5 points": exactly 5 points does not
