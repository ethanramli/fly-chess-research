   4: export const MIN_GAIN = 0.2, MAX_GAIN = 1.8, ACT = 1.5, ETA = 0.5, PULSE = 0.75, PASSES = 6, CAP_KEEP = 0.99;
   5: export const BOARD_IDS = ['Q04sIPQ5:13', 'SjmcbcGu:16', '5XRGyGSj:13'];
   6: export const CIRCUITS = { current: { bias: null, kcScale: null }, quiet: { bias: 0, kcScale: 0.014047 } }; // null bias: trainer default 0.01
   7: export const CONDITIONS = ['correct', 'swapped', 'off'];
   8: export const VALENCE = new Map([['MBON11', 1], ['MBON12', 1], ['MBON02', 1], ['MBON05', -1], ['MBON01', -1], ['MBON15', -1]]);
   9: export const DAN_TYPES = ['PAM07', 'PAM02', 'PAM03', 'PPL101', 'PPL103'], REWARD_TYPES = ['PAM07', 'PAM02'], PUNISH_TYPES = ['PPL101', 'PPL103'];
  10: export const W = { PAM07: { MBON05: -1 }, PPL101: { MBON11: -1 }, PAM02: { MBON01: -1, MBON02: 0.3 }, PPL103: { MBON12: -1 - 0.3, MBON15: 0.3 - 1 }, PAM03: { MBON02: -1, MBON01: -0.3 } };
  11: export const RULES = { closure: 0.20, advantage: 0.20, overCurrent: 0.10, drop: 0.05, eligibleTolerances: 100 };
