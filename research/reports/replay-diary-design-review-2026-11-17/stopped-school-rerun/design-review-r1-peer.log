   1: // Eyes v2 (2026-11-03) is Eyes v1 plus a dim picture of the piece removed by a capture, drawn on the square it was removed from
   2: // (for en passant, the passed pawn's square, not the landing square). Reason: peer review 2026-11-02 found capture and
   3: // non-capture moves gave identical input. It states no attack, pin, legality or safety fact.
   4: import { Chess } from 'chess.js';
   5: import { createHash } from 'node:crypto';
   6: import { createEyesV1 } from './eyes-v1.mjs';
   7: 
   8: export { loadRetina } from './eyes-v1.mjs';
   9: 
  10: const CAPTURED = 0.25; // [choice] dimmer than the opponent's own pieces (0.5), fixed before any eye test.
  11: const hash = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
  12: 
  13: export function createEyesV2(retina, pictures) {
  14:   const v1 = createEyesV1(retina, pictures);
  15:   const { retina_idx, retina_square } = retina;
  16:   if (new Set(retina_idx).size !== retina_idx.length) throw Error('Eyes v2 needs unique photoreceptor indices');
  17:   const identity = hash({ schema: 'eyes-v2', base: v1.identity, captured: CAPTURED });
  18: 
  19:   function encode(position, action) {
  20:     const fen = typeof position === 'string' ? position : position.fen();
  21:     const base = v1.encode(fen, action);
  22:     const board = new Chess(fen);
  23:     const move = board.moves({ verbose: true }).find(m => m.from + m.to + (m.promotion ?? '') === action);
  24:     const mover = board.turn();
  25:     const current = new Map(base.stimulation.map(x => [x.index, x.current]));
  26:     if (move.captured) {
  27:       const removed = move.flags.includes('e') ? move.to[0] + move.from[1] : move.to;
  28:       const ink = v1.pictureInk(move.captured);
  29:       for (let k = 0; k < retina_idx.length; k++) {
  30:         const s = retina_square[k];
  31:         const rank = mover === 'w' ? Math.floor(s / 8) : 7 - Math.floor(s / 8);
  32:         if ('abcdefgh'[s % 8] + (rank + 1) === removed) {
  33:           current.set(retina_idx[k], (current.get(retina_idx[k]) ?? 0) + CAPTURED * ink[k]);
  34:         }
  35:       }
  36:     }
  37:     const stimulation = [];
  38:     for (const index of retina_idx) {
  39:       const c = current.get(index);
  40:       if (c > 0) stimulation.push({ index, current: c });
  41:     }
  42:     const scope = 'Engineered rendering of the board after the candidate move plus a dim picture of any captured piece; no attack, pin, legality or safety fact; legal moves come from outside.';
  43:     return { schema: 'eyes-v2', identity, action, stimulation, scope };
  44:   }
  45: 
  46:   return Object.freeze({
  47:     identity,
  48:     config: Object.freeze({ ...v1.config, captured: CAPTURED }),
  49:     encode,
  50:     pictureInk: v1.pictureInk,
  51:     cells: v1.cells,
  52:   });
  53: }
  54: 
  55: // Groups items whose eye input is identical; a group is reported only when its answers differ.
  56: export function inputCollisions(eyes, items) {
  57:   if (!Array.isArray(items)) throw Error('inputCollisions needs an array of items');
  58:   const groups = new Map();
  59:   items.forEach(({ fen, action }, i) => {
  60:     const pairs = eyes.encode(fen, action).stimulation
  61:       .map(({ index, current }) => [index, current])
  62:       .sort((a, b) => a[0] - b[0]);
  63:     const key = hash(pairs);
  64:     if (!groups.has(key)) groups.set(key, []);
  65:     groups.get(key).push(i);
  66:   });
  67:   return [...groups].flatMap(([key, members]) => {
  68:     const answers = [...new Set(members.map(i => items[i].answer))];
  69:     return answers.length > 1 ? [{ hash: key, answers, items: members }] : [];
  70:   });
  71: }

