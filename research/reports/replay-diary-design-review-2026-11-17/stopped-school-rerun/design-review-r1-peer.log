  93:         const capped = [];
  94:         rates.forEach((r, k) => { if (r > 0) { active += weights[k]; if (r >= kcScale) { atCap += weights[k]; capped.push(k); } } });
  95:         cap = { worstKept: kept.length ? Math.min(...kept) : null, comparisons: kept.length, activeShareAtCap: active ? atCap / active : 0,
  96:           cappedCells: capped.length, cappedCellsActiveInRival: capped.filter(k => rivalRates[k] > 0).length, rival };
  97:       }
  98:       passRates.push(rates);
  99:       let changed = 0;
 100:       if (condition !== 'off') mask.forEach((e, i) => {
 101:         const k = kcReading(h[maskPre[i]], kcScale);
 102:         const next = Math.min(MAX_GAIN, Math.max(MIN_GAIN, gains[i] + ETA * D[maskType[i]] * (k + gains[i] - 1)));
 103:         if (next !== gains[i]) { changed++; gains[i] = next; setMagnitude(e, base[i] * next); }
 104:       });
 105:       lessons.push({ pass, index, move, label, danMean, D, changed, atLimit: gains.filter(g => g === MIN_GAIN || g === MAX_GAIN).length, cap });
 106:     });
 107:     checkpoints.push(checkpoint(pass));
 108:   }
 109:   return { boardId: record.boardId, safeMoves, experiences: record.experiences.map(e => ({ move: e.move, pulse: e.pulse })), checkpoints, lessons };
 110: }
 111: 
 112: // Decision rules, fixed before data. results[circuit][condition] is a result.json object or { failed: reason };
 113: // baseline is { boardId, scores: { move: score } } from the replay's valence-baseline/probe.json;
 114: // packet is the verified board records (boards.jsonl). Lessons, legal moves and safe captures are checked against the packet, not the run.
 115: export function decide(results, baseline, packet) {
 116:   const failures = [];
 117:   const fail = reason => failures.push(reason);
 118:   const expected = new Map(BOARD_IDS.map(id => {
 119:     const r = packet.find(x => x.boardId === id);
 120:     if (!r) { fail(`packet: board ${id} missing`); return [id, null]; }
 121:     if (r.experiences.length !== LESSONS_PER_PASS) fail(`packet ${id}: ${r.experiences.length} lessons, expected ${LESSONS_PER_PASS}`);
 122:     return [id, { legal: [...r.legal].sort(), safeMoves: r.legal.filter(m => r.outcomes[m] === true), experiences: r.experiences.map(e => ({ move: e.move, pulse: e.pulse })) }];
 123:   }));
 124:   if (failures.length) return { verdict: 'inconclusive', reason: 'a required check failed', failures, boards: [] };
 125:   const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
 126:   for (const circuit of Object.keys(CIRCUITS)) for (const condition of CONDITIONS) {
 127:     const r = results[circuit]?.[condition];
 128:     if (!r || r.failed) { fail(`${circuit} ${condition}: run missing or failed${r?.failed ? ` (${r.failed})` : ''}`); continue; }
 129:     if (r.circuit !== circuit || r.condition !== condition) fail(`${circuit} ${condition}: file says ${r.circuit} ${r.condition}`);
 130:     if (JSON.stringify(r.boards.map(b => b.boardId)) !== JSON.stringify(BOARD_IDS)) fail(`${circuit} ${condition}: wrong boards`);
 131:     for (const b of r.boards) {
 132:       const want = expected.get(b.boardId);
 133:       if (!want) continue; // wrong boards, reported above
 134:       const name = `${circuit} ${condition} ${b.boardId}`;
 135:       if (!same(b.experiences, want.experiences) || !same(b.safeMoves, want.safeMoves)) fail(`${name}: lesson list or safe captures differ from the board packet`);
 136:       // Every pass must hold the packet's four lessons, in order, with the labels the condition assigns: 24 in all.
 137:       const labels = lessonLabels(want.experiences, condition), n = labels.length;
 138:       if (b.lessons.length !== PASSES * n || b.lessons.some((l, k) => l.pass !== Math.floor(k / n) + 1 || l.index !== k % n || l.move !== labels[k % n].move || l.label !== labels[k % n].label))
 139:         fail(`${name}: lessons missing, repeated, out of order or wrongly labelled (${b.lessons.length} recorded, ${PASSES * n} expected)`);
 140:       if (b.checkpoints.length !== PASSES + 1 || b.checkpoints.some((c, i) => c.pass !== i || !same(Object.keys(c.scores).sort(), want.legal)))
 141:         fail(`${name}: checkpoints missing, out of order, or not scoring every legal move`);
 142:       // Check 2: the step-size guard (the probe stops on it; this rechecks the records).
 143:       if (b.lessons.some(l => Object.values(l.D).some(d => ETA * Math.abs(d) > 1))) fail(`${circuit} ${condition} ${b.boardId}: a lesson exceeds the step-size guard`);
 144:       // Check 1: learning off changes nothing.
 145:       if (condition === 'off') {
 146:         const start = b.checkpoints[0].scores;
 147:         if (b.lessons.some(l => l.changed !== 0) || b.checkpoints.some(c => Object.keys(start).some(m => !Object.is(c.scores[m], start[m])))) fail(`${circuit} off ${b.boardId}: scores moved with learning off`);
 148:       }
 149:       // Check 3: the cap keeps at least 99% of every move difference during feedback.
 150:       if (circuit === 'quiet' && b.lessons.some(l => !l.cap || (l.cap.worstKept !== null && l.cap.worstKept < CAP_KEEP))) fail(`quiet ${condition} ${b.boardId}: cap keeps under 99% of a move difference during feedback, or the cap record is missing`);
 151:     }
 152:   }
 153:   if (failures.length) return { verdict: 'inconclusive', reason: 'a required check failed', failures, boards: [] };
 154:   // Fresh start: the three conditions of a circuit begin from identical scores.
 155:   for (const circuit of Object.keys(CIRCUITS)) BOARD_IDS.forEach((id, i) => {
 156:     const s = CONDITIONS.map(c => results[circuit][c].boards[i].checkpoints[0].scores);
 157:     if (s.some(x => Object.keys(s[0]).some(m => !Object.is(x[m], s[0][m])))) fail(`${circuit} ${id}: conditions do not start from the same scores`);
 158:   });
 159:   // Check 4: the current circuit reproduces the replay baseline exactly.
 160:   const start = results.current.correct.boards.find(b => b.boardId === baseline.boardId)?.checkpoints[0].scores ?? {};
 161:   for (const [move, score] of Object.entries(baseline.scores)) if (!Object.is(start[move], score)) fail(`current ${baseline.boardId}: ${move} starts at ${start[move]}, baseline ${score}`);
 162:   if (failures.length) return { verdict: 'inconclusive', reason: 'a required check failed', failures, boards: [] };
 163: 
 164:   const boards = BOARD_IDS.map((boardId, i) => {
 165:     const row = { boardId }, { safeMoves } = expected.get(boardId);
 166:     for (const circuit of Object.keys(CIRCUITS)) {
 167:       // Best safe capture, rival and gap are recomputed from the recorded scores and the packet's safe captures.
 168:       const ranks = c => results[circuit][c].boards[i].checkpoints.map(cp => rankMoves(cp.scores, safeMoves)), first = ranks('correct')[0];
 169:       const tolerance = 1e-9 + 1e-7 * first.maxAbs, eligible = first.gap >= RULES.eligibleTolerances * tolerance;
 170:       const conditions = Object.fromEntries(CONDITIONS.map(c => {
 171:         const cps = ranks(c), a = cps[0], z = cps[PASSES];
 172:         return [c, { closure: (a.gap - z.gap) / a.gap, closureByPass: cps.map(cp => (a.gap - cp.gap) / a.gap),
 173:           safe: { from: a.bestSafe, to: z.bestSafe, change: z.bestSafe.score - a.bestSafe.score },
 174:           rival: { from: a.rival, to: z.rival, change: z.rival.score - a.rival.score }, gapChange: z.gap - a.gap, safeOnTop: z.above === 0 }];
 175:       }));
 176:       row[circuit] = { gap: first.gap, tolerance, eligible, gapShareOfRange: first.gap / first.range, movesAboveSafe: first.above,
 177:         conditions, advantage: conditions.correct.closure - conditions.swapped.closure };
 178:     }
 179:     row.eligibleInBoth = row.current.eligible && row.quiet.eligible;
 180:     row.expandPass = row.eligibleInBoth && atLeast(row.quiet.conditions.correct.closure, RULES.closure) && atLeast(row.quiet.advantage, RULES.advantage)
 181:       && atLeast(row.quiet.advantage - row.current.advantage, RULES.overCurrent);
 182:     return row;
 183:   });
 184:   const both = boards.filter(b => b.eligibleInBoth), quietEligible = boards.filter(b => b.quiet.eligible);
 185:   if (both.length < 2) return { verdict: 'inconclusive', reason: `only ${both.length} board(s) qualify in both circuits; at least 2 are needed`, failures, boards };
 186:   if (boards.filter(b => b.expandPass).length >= 2) return { verdict: 'expand to 12 boards', reason: `${boards.filter(b => b.expandPass).length} boards meet all three expansion cutoffs`, failures, boards };
 187:   if (quietEligible.every(b => under(b.quiet.advantage, RULES.drop))) return { verdict: 'drop the quiet, rescaled circuit', reason: 'the quiet circuit beats swapped labels by under 5 points on every board that qualifies in it', failures, boards };
 188:   return { verdict: 'inconclusive', reason: 'the result falls between the expansion and drop cutoffs', failures, boards };
 189: }
