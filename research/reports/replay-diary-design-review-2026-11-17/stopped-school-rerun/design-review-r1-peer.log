  38: 
  39: // Best safe capture and strongest rival (best move that is not a verified safe capture). gap > 0: the safe capture is behind.
  40: export function rankMoves(scores, safeMoves) {
  41:   const safe = new Set(safeMoves), list = Object.entries(scores).map(([move, score]) => ({ move, score }));
  42:   const best = xs => xs.reduce((a, b) => (b.score > a.score ? b : a));
  43:   const safeList = list.filter(s => safe.has(s.move)), otherList = list.filter(s => !safe.has(s.move));
