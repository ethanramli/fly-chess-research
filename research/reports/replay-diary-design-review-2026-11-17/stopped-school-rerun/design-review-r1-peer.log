   9: export function certifyLandingSquare(board, move, { maxReplies = 256 } = {}) {
  10:   if (!Number.isSafeInteger(maxReplies) || maxReplies < 1 || maxReplies > 256)
  11:     throw Error('Invalid reply bound');
  12:   const beforeFen = board.fen(), beforePgn = board.pgn();
  13:   const action = board.moves({ verbose: true }).find(candidate => uci(candidate) === move);
  14:   if (!action) throw Error('Task requires a legal move');
  15:   if (action.piece === 'k') throw Error('King moves are outside these tasks');
  16:   const actor = board.turn(), opponent = actor === 'w' ? 'b' : 'w', target = action.to;
  17:   board.move(action);
  18:   try {
  19:     const legal = board.moves({ verbose: true });
  20:     const replies = legal.map(uci).sort();
  21:     if (replies.length > maxReplies) return { status: 'unknown', certificate: null };
  22:     const captures = legal.filter(reply => reply.to === target && Boolean(reply.captured));
  23:     const recaptures = captures.map(uci).sort();
  24:     const attackers = board.attackers(target, opponent).sort();
  25:     const inCheckAfter = board.inCheck();
  26:     // When the opponent is not in check, a non-king attacker that cannot legally capture is pinned to its king.
  27:     let kingSquare = null;
  28:     for (const file of 'abcdefgh') for (const rank of '12345678') {
  29:       const piece = board.get(file + rank);
  30:       if (piece && piece.type === 'k' && piece.color === opponent) kingSquare = file + rank;
  31:     }
  32:     const capturingSquares = new Set(captures.map(reply => reply.from));
  33:     const pinnedAttackers = inCheckAfter ? [] : attackers
  34:       .filter(square => square !== kingSquare && !capturingSquares.has(square)).sort();
  35:     const moverValue = PIECE_VALUES[action.piece];
  36:     const capturedValue = action.captured ? PIECE_VALUES[action.captured] : 0;
  37:     const certificate = { schema: 'landing-square-certificate-v1', rootFen: beforeFen,
  38:       rootPgn: beforePgn, actor, move, target, capture: Boolean(action.captured), replies,
  39:       recaptures, attackers, pinnedAttackers, inCheckAfter, moverValue, capturedValue };
  40:     return { status: recaptures.length ? 'failure' : 'success', certificate,
  41:       certificateSha256: digest(certificate) };
  42:   } finally {
  43:     board.undo();
  44:     if (board.fen() !== beforeFen || board.pgn() !== beforePgn)
  45:       throw Error('Certificate generation changed the source position');
