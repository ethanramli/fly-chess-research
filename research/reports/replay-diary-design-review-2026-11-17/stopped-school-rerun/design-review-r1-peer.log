   1: #!/usr/bin/env node
   2: // Three-board feedback test (documentation/design/neural-learning/three-board-feedback-test-2026-11-14.md): one circuit, one condition, three development boards.
   3: // Same rule, pulses and scoring as probe-wide-learning-v2.mjs (kept unchanged as journal item 31 evidence). New here: conditions, the quiet circuit,
   4: // fresh memory for every board, every legal move's score at every checkpoint, per-lesson dopamine and cap records, and a manifest.
   5: // Usage (repo root): node --max-old-space-size=512 .codebase/scripts/neural-learning/probe-wide-learning-v3.mjs --config CONFIG --circuit current|quiet --condition correct|swapped|off --out DIR
   6: import { createHash } from 'node:crypto';
   7: import { createReadStream, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
   8: import { createInterface } from 'node:readline';
   9: import os from 'node:os';
  10: import { join } from 'node:path';
  11: import { parseArgs } from 'node:util';
  12: import { fileURLToPath } from 'node:url';
  13: import { loadGraph, readNpz } from '../../src/runtime/graph.mjs';
  14: import { SparseTrainer } from '../../src/supervised-baselines/trainer.mjs';
  15: import { createEyesV2, loadRetina } from '../../src/chess-input/eyes-v2.mjs';
  16: import { installLocalApl } from '../../src/neural-learning/fly-connections-apl-v1.mjs';
  17: import { loadLocalAplPackage } from '../../src/neural-learning/fly-connections-apl-data-v1.mjs';
  18: import { BOARD_IDS, CIRCUITS, CONDITIONS, DAN_TYPES, PULSE, PUNISH_TYPES, REWARD_TYPES, VALENCE, W, runBoard } from '../../src/neural-learning/three-board-feedback-v1.mjs';
  19: const { values: args } = parseArgs({ options: { config: { type: 'string' }, circuit: { type: 'string' }, condition: { type: 'string' }, out: { type: 'string' } } });
  20: const MiB = 2 ** 20, MASK_EDGES = 6046;
  21: // Resource guard around every forward: RSS <= 2048 MiB, free memory >= 256 MiB.
  22: const guard = () => { if (process.memoryUsage().rss > 2048 * MiB) throw Error('RSS above 2048 MiB'); if (os.freemem() < 256 * MiB) throw Error('Free memory below 256 MiB'); };
  23: const avg = xs => xs.reduce((sum, x) => sum + x, 0) / xs.length;
  24: const readJson = path => JSON.parse(readFileSync(path, 'utf8').replace(/^���/, ''));
  25: const sha256 = path => new Promise((resolve, reject) => { const h = createHash('sha256'); createReadStream(path).on('data', d => h.update(d)).on('end', () => resolve(h.digest('hex'))).on('error', reject); });
  26: // Writes DIR/name atomically: partial file, then rename.
  27: function writeAtomic(name, value) {
  28:   const path = join(args.out, name);
  29:   writeFileSync(`${path}.partial`, `${JSON.stringify(value, null, 1)}\n`); renameSync(`${path}.partial`, path);
  30: }
  31: // One streamed pass over the annotation TSV. Exact type match; both sides' cells, as in v2.
  32: async function annotate(path, indices) {
  33:   const kc = new Set(), mbon = [], dan = [];
  34:   let col;
  35:   for await (const line of createInterface({ input: createReadStream(path), crlfDelay: Infinity })) {
  36:     const fields = line.split('\t');
  37:     if (!col) {
  38:       if (!['root_id', 'cell_class', 'hemibrain_type'].every(key => fields.includes(key))) throw Error('Missing annotation column');
  39:       col = { root_id: fields.indexOf('root_id'), cell_class: fields.indexOf('cell_class'), hemibrain_type: fields.indexOf('hemibrain_type') };
  40:       continue;
  41:     }
  42:     const index = indices.get(fields[col.root_id]); if (index === undefined) continue;
  43:     const cls = fields[col.cell_class], type = fields[col.hemibrain_type];
  44:     if (cls === 'Kenyon_Cell') kc.add(index);
  45:     else if (cls === 'DAN' && DAN_TYPES.includes(type)) dan.push({ index, type });
  46:     else if (VALENCE.has(type)) mbon.push({ index, type });
  47:   }
  48:   return { kc, mbon: mbon.sort((a, b) => a.index - b.index), dan };
  49: }
  50: async function work(manifest) {
  51:   const { paths, model: modelConfig, pins = {} } = readJson(args.config);
  52:   // Every pinned input must match before any graph work.
  53:   for (const [path, expected] of Object.entries(pins)) {
  54:     const actual = await sha256(path);
  55:     if (actual !== expected) throw Error(`Pin mismatch for ${path}: ${actual}, expected ${expected}`);
  56:     manifest.pins[path] = actual;
  57:   }
  58:   const self = fileURLToPath(import.meta.url), shared = fileURLToPath(new URL('../../src/neural-learning/three-board-feedback-v1.mjs', import.meta.url));
  59:   for (const path of [args.config, self, shared]) manifest.pins[path] = await sha256(path);
  60:   writeAtomic('manifest.json', manifest);
  61:   const { bias, kcScale } = CIRCUITS[args.circuit];
  62:   const records = readFileSync(join(paths.packet, 'boards.jsonl'), 'utf8').split('\n').filter(l => l.trim()).map(l => JSON.parse(l));
  63:   const selected = BOARD_IDS.map(id => records.find(r => r.boardId === id && r.group === 'A'));
  64:   if (selected.some(r => !r)) throw Error(`Missing a development board: ${BOARD_IDS.join(', ')}`); // only these three; no sealed games are read
  65:   const graph = loadGraph(paths.graph);
  66:   const rootIds = readNpz(paths.graph, ['root_ids']).root_ids;
  67:   if (!(rootIds instanceof BigInt64Array) || rootIds.length !== graph.row.length - 1) throw Error('Invalid root IDs');
  68:   const { kc, mbon, dan } = await annotate(paths.annotations, new Map(Array.from(rootIds, (id, i) => [id.toString(), i])));
  69:   const cellsOf = (list, types) => Object.fromEntries(types.map(t => [t, list.filter(c => c.type === t).map(c => c.index)]));
  70:   const danCells = cellsOf(dan, DAN_TYPES), mbonCells = cellsOf(mbon, [...VALENCE.keys()]);
  71:   const sizes = Object.fromEntries(Object.entries({ ...danCells, ...mbonCells }).map(([t, c]) => [t, c.length]));
  72:   if (Object.values(sizes).includes(0)) throw Error(`Missing cells: ${JSON.stringify(sizes)}`);
  73:   // graph.row[j]..graph.row[j+1] lists the incoming edges of cell j; keep the positive KC edges onto each MBON cell.
  74:   const mask = [], maskType = [], maskPre = [];
  75:   for (const cell of mbon) for (let e = graph.row[cell.index]; e < graph.row[cell.index + 1]; e++) if (graph.sign[e] === 1 && kc.has(graph.col[e])) { mask.push(e); maskType.push(cell.type); maskPre.push(graph.col[e]); }
  76:   if (mask.length !== MASK_EDGES) throw Error(`Mask has ${mask.length} edges, expected ${MASK_EDGES}`);
  77:   const count = new Map(); for (const j of maskPre) count.set(j, (count.get(j) ?? 0) + 1);
  78:   const cells = [...count.keys()].sort((a, b) => a - b), weights = cells.map(j => count.get(j)); // each cell counted once per learnable edge, as in check_scale.mjs
  79:   const eyes = createEyesV2(loadRetina(paths.graph)), apl = await loadLocalAplPackage(paths.aplPackage);
  80:   const stim = types => types.flatMap(t => danCells[t].map(index => ({ index, current: PULSE })));
  81:   const pulses = { reward: stim(REWARD_TYPES), punish: stim(PUNISH_TYPES) };
  82:   const attraction = mbon.filter(c => VALENCE.get(c.type) > 0).map(c => c.index), avoidance = mbon.filter(c => VALENCE.get(c.type) < 0).map(c => c.index);
  83:   const scoreOf = h => avg(attraction.map(j => h[j])) - avg(avoidance.map(j => h[j]));
  84:   const model = new SparseTrainer(graph, modelConfig);
  85:   if (bias !== null) model.params.bias.fill(bias);
  86:   installLocalApl(model, apl, { mode: 'local' });
  87:   const base = Float64Array.from(mask, e => model.params.magnitude[e]); // copied before any change; runBoard restores it for every board
  88:   const zeros = new Float32Array(model.inputDim);
  89:   const forward = (fen, move, pulse) => {
  90:     guard();
  91:     model.forward(zeros, [...eyes.encode(fen, move).stimulation, ...(pulse ? pulses[pulse] : [])], null);
  92:     guard();
  93:     return model.h[model.steps];
  94:   };
  95:   const boards = selected.map(record => runBoard({ record, condition: args.condition, kcScale, forward, setMagnitude: (e, v) => model.setMagnitude(e, v),
  96:     base, mask, maskType, maskPre, cells, weights, danCells, scoreOf, log: line => console.log(`${args.circuit} ${args.condition} ${line}`) }));
  97:   writeAtomic('result.json', { schema: 'three-board-feedback-v1', circuit: args.circuit, condition: args.condition, bias, kcScale, maskEdges: mask.length,
  98:     learnableCells: cells.length, modulation: W, pulse: PULSE, boards });
  99: }
 100: async function main() {
 101:   if (!args.config || !args.out || !(args.circuit in CIRCUITS) || !CONDITIONS.includes(args.condition)) throw Error(`Need --config, --out, --circuit (${Object.keys(CIRCUITS).join('|')}) and --condition (${CONDITIONS.join('|')})`);
 102:   if (existsSync(join(args.out, 'manifest.json'))) throw Error(`${args.out} already holds a run; use a new directory`);
 103:   mkdirSync(args.out, { recursive: true });
 104:   const manifest = { schema: 'three-board-feedback-run-v1', status: 'running', pid: process.pid, argv: process.argv, nodeVersion: process.version,
 105:     volume: 2, chapter: '3 To Learn; 5 Evidence for Learning', circuit: args.circuit, condition: args.condition, sealedBoards: 0, pins: {}, startedAt: new Date().toISOString() };
 106:   writeAtomic('manifest.json', manifest);
 107:   try { await work(manifest); manifest.status = 'complete'; }
 108:   catch (error) { manifest.status = 'failed'; manifest.error = error.message; console.error(error.stack ?? error.message); process.exitCode = 1; }
 109:   manifest.endedAt = new Date().toISOString();
 110:   writeAtomic('manifest.json', manifest);
 111: }
 112: main().catch(error => { console.error(error.stack ?? error.message); process.exitCode = 1; });
