  21: const avg = xs => xs.reduce((sum, x) => sum + x, 0) / xs.length;
  22: 
  23: // Label delivered per lesson. Swapped reverses every label; learning off delivers the correct labels but never changes a gain.
  24: export function lessonLabels(experiences, condition) {
