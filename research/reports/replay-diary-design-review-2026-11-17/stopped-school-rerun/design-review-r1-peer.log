  28: 
  29: // How a Kenyon cell's rate enters the rule: current circuit rate / 1.5; quiet circuit min(1, rate / kcScale).
  30: export const kcReading = (rate, kcScale) => kcScale === null ? Math.max(0, rate) / ACT : Math.min(1, Math.max(0, rate) / kcScale);
