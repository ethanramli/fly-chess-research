   1 // Eyes v1 (2026-10-31): a fixed, engineered renderer of the board after a candidate move onto the
   2 // fly's photoreceptors. Nothing here is trained, and it states no attack, pin, legality or safety fact.
   3 // Legal moves come from outside; the renderer only maps the position reached by one move.
   4 // Credit: the photoreceptor-to-square placement (retina_idx, retina_square, retina_uv in .cache/full.npz)
   5 // and the mirror-when-Black-moves convention (the board is seen from the side to move, rank 1 at the
   6 // bottom of the field) come from Esposito, C. (2026), fly-chess, commit
   7 // 3c83567dfb6fa71cecc1556c75f17c8bb38fd5cf, MIT (research/literature/cesp99-retina-2026-10-28/README.md;
   8 // docs/RETINA.md section 1). His trained weights w_ret and W_in and his gains are not used.
   9 // This is an engineered interface, not a measured model of fly vision.
  10 // Picture digits come from the DejaVu Sans glyphs (licence: eyes-v1-pictures-LICENSE.txt), generated
  11 // once by .codebase/scripts/chess-input/build-eyes-v1-pictures.py.
  12 import { Chess } from 'chess.js';
  13 import { createHash } from 'node:crypto';
  14 import { readFileSync } from 'node:fs';
  15 import { readNpz } from '../runtime/graph.mjs';
  16 
  17 const MOVER = 1, OPPONENT = 0.5, MARK = 0.5;
  18 const TYPES = 'pnbrqk';
  19 const bundled = JSON.parse(readFileSync(new URL('./eyes-v1-pictures.json', import.meta.url), 'utf8'));
  20 const hash = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
  21 const bytesOf = array => new Uint8Array(array.buffer, array.byteOffset, array.byteLength);
  22 
  23 // Hash of the raw retina bytes, in the order retina_idx, retina_square, retina_uv.
  24 function retinaHash({ retina_idx, retina_square, retina_uv }) {
  25   const h = createHash('sha256');
  26   for (const array of [retina_idx, retina_square, retina_uv]) h.update(bytesOf(array));
  27   return h.digest('hex');
  28 }
  29 
  30 export function loadRetina(path) {
  31   return readNpz(path, ['retina_idx', 'retina_square', 'retina_uv']);
  32 }
  33 
  34 export function createEyesV1(retina, pictures = bundled) {
  35   const { retina_idx, retina_square, retina_uv } = retina;
  36   const n = retina_idx.length, size = pictures.size;
  37   if (retina_square.length !== n || retina_uv.length !== 2 * n) throw Error('Eyes retina length mismatch');
  38   for (const s of retina_square) if (!Number.isInteger(s) || s < 0 || s > 63) throw Error('Eyes retina square outside 0..63');
  39   for (const t of TYPES) {
  40     const rows = pictures.pictures?.[t];
  41     if (!Array.isArray(rows) || rows.length !== size
  42       || rows.some(r => typeof r !== 'string' || r.length !== size || !/^[0-9]+$/.test(r)))
  43       throw Error(`Invalid eyes picture ${t}`);
  44   }
  45   const identity = hash({ schema: 'eyes-v1', mover: MOVER, opponent: OPPONENT, mark: MARK,
  46     pictures: pictures.pictures, retina: retinaHash(retina) });
  47 
  48   // Viewing cell per photoreceptor. Photoreceptors of one square are split by their distinct u and v values.
  49   // y goes down the picture, so v = 1 (top of the field) is the top of the picture.
  50   const digits = TYPES.split('').map(t => Uint8Array.from(pictures.pictures[t].join(''), c => c.charCodeAt(0) - 48));
  51   const bySquare = Array.from({ length: 64 }, () => []);
  52   for (let k = 0; k < n; k++) bySquare[retina_square[k]].push(k);
  53   const cellArr = new Float32Array(4 * n), ink = new Float32Array(TYPES.length * n);
  54   for (const members of bySquare) {
  55     const us = [...new Set(members.map(k => retina_uv[2 * k]))].sort((a, b) => a - b);
  56     const vs = [...new Set(members.map(k => retina_uv[2 * k + 1]))].sort((a, b) => a - b);
  57     const nx = us.length, ny = vs.length;
  58     for (const k of members) {
  59       const ix = us.indexOf(retina_uv[2 * k]), iy = vs.indexOf(retina_uv[2 * k + 1]);
  60       const x0 = ix / nx, x1 = (ix + 1) / nx, y0 = 1 - (iy + 1) / ny, y1 = 1 - iy / ny;
  61       cellArr.set([x0, x1, y0, y1], 4 * k);
  62       // Ink: mean of digit/9 over the picture pixels inside the cell (at least one pixel per axis).
  63       const px0 = Math.floor(x0 * size), px1 = Math.min(size, Math.max(Math.ceil(x1 * size), px0 + 1));
  64       const py0 = Math.floor(y0 * size), py1 = Math.min(size, Math.max(Math.ceil(y1 * size), py0 + 1));
  65       const count = (px1 - px0) * (py1 - py0);
  66       for (let t = 0; t < TYPES.length; t++) {
  67         let sum = 0;
  68         for (let y = py0; y < py1; y++) for (let x = px0; x < px1; x++) sum += digits[t][y * size + x] / 9;
  69         ink[t * n + k] = sum / count;
  70       }
  71     }
  72   }
  73 
  74   const pictureInk = type => {
  75     if (typeof type !== 'string' || type.length !== 1 || !TYPES.includes(type)) throw Error('Unknown eyes picture type');
  76     const t = TYPES.indexOf(type);
  77     return ink.subarray(t * n, (t + 1) * n);
  78   };
  79 
  80   const scope = 'Engineered rendering of the board after the candidate move; no attack, pin, legality or safety fact; legal moves come from outside.';
  81 
  82   function encode(position, action) {
  83     const fen = typeof position === 'string' ? position : position.fen();
  84     const board = new Chess(fen);
  85     const move = board.moves({ verbose: true }).find(m => m.from + m.to + (m.promotion ?? '') === action);
  86     if (!move) throw Error('Illegal eye action');
  87     const mover = board.turn();
  88     const after = new Chess(fen);
  89     after.move(move);
  90     // Board square seen by each seat index: rank * 8 + file, ranks flipped when Black moves. Files are not mirrored.
  91     const squareOfSeat = Array.from({ length: 64 }, (_, s) => {
  92       const rank = mover === 'w' ? Math.floor(s / 8) : 7 - Math.floor(s / 8);
  93       return 'abcdefgh'[s % 8] + (rank + 1);
  94     });
  95     const stimulation = [];
  96     for (let k = 0; k < n; k++) {
  97       const q = squareOfSeat[retina_square[k]];
  98       const piece = after.get(q);
  99       const pieceInk = piece ? (piece.color === mover ? MOVER : OPPONENT) * ink[TYPES.indexOf(piece.type) * n + k] : 0;
 100       const current = pieceInk + (q === move.from || q === move.to ? MARK : 0);
 101       if (current > 0) stimulation.push({ index: retina_idx[k], current });
 102     }
 103     return { schema: 'eyes-v1', identity, action, stimulation, scope };
 104   }
 105 
 106   return Object.freeze({
 107     identity,
 108     config: Object.freeze({ mover: MOVER, opponent: OPPONENT, mark: MARK, pictureSize: size }),
 109     encode,
 110     pictureInk,
 111     cells: () => cellArr.slice(),
 112   });
 113 }
