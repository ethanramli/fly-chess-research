  44   }
  45 
  46   return Object.freeze({
  47     identity,
  48     config: Object.freeze({ ...v1.config, captured: CAPTURED }),
  49     encode,
  50     pictureInk: v1.pictureInk,
  51     cells: v1.cells,
  52   });
  53 }
  54 
  55 // Groups items whose eye input is identical; a group is reported only when its answers differ.
  56 export function inputCollisions(eyes, items) {
  57   if (!Array.isArray(items)) throw Error('inputCollisions needs an array of items');
  58   const groups = new Map();
  59   items.forEach(({ fen, action }, i) => {
  60     const pairs = eyes.encode(fen, action).stimulation
  61       .map(({ index, current }) => [index, current])
  62       .sort((a, b) => a[0] - b[0]);
  63     const key = hash(pairs);
  64     if (!groups.has(key)) groups.set(key, []);
  65     groups.get(key).push(i);
  66   });
  67   return [...groups].flatMap(([key, members]) => {
  68     const answers = [...new Set(members.map(i => items[i].answer))];
  69     return answers.length > 1 ? [{ hash: key, answers, items: members }] : [];
  70   });
  71 }
