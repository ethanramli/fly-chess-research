  14 export const CAPTURE_CRITERION = 'capture-retention-one-ply-nonking-safe-v1';
  15 export const R_CRITERION = 'experimental-contingency-v1';
  16 export const TASK = Object.freeze({ objective: 'capture-retention', plies: 1 });
  17 export const TIE_RULE = 'abs(diff)<=1e-9+1e-7*max(abs(scores))';
  18 export const NONKING_SCOPE = 'does not meet nonking-capture criterion';
  19 export const R_SCOPE = 'experimental-contingency legal membership; no chess consequence claimed';
  20 const MEMBER_SCHEMA = 'fly-connections-membership-proof-v1';
  21 const INELIGIBLE_SCHEMA = 'fly-connections-board-ineligible-v1';
  22 const MARKS = [8, 16, 32];
  23 const UCI = /^[a-h][1-8][a-h][1-8][qrbn]?$/;
  24 
  25 const digest = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
  26 const byText = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
  27 const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
  28 // Fixed selection order: SHA-256 of board and action identity, independent of scores and neural state.
  29 const ordered = (boardId, moves) => [...moves].sort((a, b) => byText(digest(['order-v1', boardId, a]), digest(['order-v1', boardId, b])));
  30 const flagsFor = (moves, target) => Object.fromEntries(moves.map(m => [m, m === target]));
  31 // Same hash as Eyes v2 collision checks: sorted [index,current] pairs.
  32 export const inputHash = (eyes, fen, move) => digest(eyes.encode(fen, move).stimulation.map(({ index, current }) => [index, current]).sort((a, b) => a[0] - b[0]));
  33 const twoOf = list => [list[0], list[list.length > 1 ? 1 : 0]];
  34 
  35 // Independent source read: GameId and the standard-start main line of the supplied PGN text.
  36 function sourceLine(pgn, gameId) {
  37   if (typeof pgn !== 'string' || gameIdOf(pgn) !== gameId) throw Error('Row GameId does not match the supplied source PGN');
  38   if (/^\[(SetUp|FEN) "/m.test(pgn)) throw Error('Only standard-start PGN is supported; Setup/FEN games are rejected');
  39   const game = new Chess();
  40   game.loadPgn(pgn);
  41   const headers = game.getHeaders();
  42   if ('SetUp' in headers || 'FEN' in headers) throw Error('Only standard-start PGN is supported; Setup/FEN games are rejected');
  43   return game.history({ verbose: true }).map(move => move.from + move.to + (move.promotion ?? ''));
  44 }
  45 
  46 function applyUci(board, move) {
  47   if (typeof move !== 'string' || !UCI.test(move)) throw Error(`Malformed UCI move ${JSON.stringify(move)}`);
  48   const from = move.slice(0, 2), to = move.slice(2, 4);
  49   const done = board.move(move.length === 5 ? { from, to, promotion: move[4] } : { from, to });
  50   if (!done || uciOf(done) !== move) throw Error(`Move ${move} is not the exact legal move`);
  51 }
  52 
  53 // Rebuilds the board from the full UCI history (repetition, castling and en passant retained). No FEN-only path.
  54 export function replayPacketBoard(record) {
  55   const { gameId, ply, fen, history, boardId } = record;
  56   if (!Array.isArray(history) || ply !== history.length) throw Error('ply must equal the history length');
  57   const board = new Chess();
  58   for (const move of history) applyUci(board, move);
  59   if (board.fen() !== fen) throw Error('Recorded FEN does not match the replayed history');
  60   if (boardId !== `${gameId}:${ply}`) throw Error('boardId must equal gameId:ply');
  61   return board;
  62 }
  63 
  64 const legalActions = board => new Map(board.moves({ verbose: true }).map(m => [uciOf(m), m]));
  65 
  66 // Legal-membership proof for a king, quiet or experimental action. It never claims a chess consequence.
  67 function membershipProof(board, move, scope, history) {
  68   const action = legalActions(board).get(move);
  69   if (!action) throw Error(`${move} is not legal in this board`);
  70   const certificate = { schema: MEMBER_SCHEMA, rootFen: board.fen(), historySha256: digest(history), move,
  71     piece: action.piece, captured: action.captured ?? null, scope };
  72   return { status: 'membership', certificate, certificateSha256: digest(certificate) };
  73 }
  74 
  75 function checkMembership(board, move, proof, history, scope) {
  76   const action = legalActions(board).get(move);
  77   const c = proof?.certificate;
  78   if (!action || proof?.status !== 'membership' || c?.schema !== MEMBER_SCHEMA || c.rootFen !== board.fen()
  79     || c.historySha256 !== digest(history) || c.move !== move || c.piece !== action.piece
  80     || c.captured !== (action.captured ?? null) || c.scope !== scope || proof.certificateSha256 !== digest(c))
  81     throw Error(`Membership proof for ${move} does not bind to this action`);
  82 }
  83 
  84 // Certificate from the existing generator, then the existing independent checker. Unknown is returned as-is.
  85 function captureProof(board, move, maxReplies) {
  86   const options = { maxReplies };
  87   const proof = certifyCaptureRetentionAction(board, move, TASK, options);
  88   if (proof.status === 'unknown') return proof;
  89   const check = checkCaptureRetentionAction(board, move, TASK, proof, options);
  90   if (check.verified !== true || check.learningAllowed !== true || check.status !== proof.status)
  91     throw Error(`Independent recheck rejects the certificate for ${move}`);
  92   return proof;
  93 }
  94 
  95 // Four experiences per A/B board: two safe then two unsafe, each in fixed selection order; one-member classes repeat.
  96 function prescribed(boardId, safe, unsafe, proofs) {
  97   return [
  98     ...twoOf(ordered(boardId, safe)).map(move => ({ move, pulse: true, proofSha: proofs[move].certificateSha256 })),
  99     ...twoOf(ordered(boardId, unsafe)).map(move => ({ move, pulse: false, proofSha: proofs[move].certificateSha256 })),
 100   ];
 101 }
 102 
 103 // Builds one board record from a source row. Ineligible boards return a structured result, never an unsafe label.
 104 export function buildBoardRecord(row, { group, pgn, eyes, maxReplies = 256 } = {}) {
 105   if (!GROUPS.includes(group)) throw Error(`Unknown group ${group}`);
 106   if (typeof eyes?.encode !== 'function' || typeof eyes.identity !== 'string') throw Error('Eyes v2 encoder with identity required');
 107   const { gameId, ply, fen, history } = row;
 108   const source = sourceLine(pgn, gameId);
 109   if (!Array.isArray(history) || history.length !== ply || source.length < ply || !same(history, source.slice(0, ply))) {
 110     const firstDiff = Array.isArray(history) ? history.findIndex((m, i) => m !== source[i]) : -1;
 111     throw Error(`Row ${gameId}:${ply} history is not the exact UCI prefix of the source PGN `
 112       + `(row has ${Array.isArray(history) ? history.length : 'no'} moves, source has ${source.length}, first difference at index ${firstDiff})`);
 113   }
 114   const boardId = `${gameId}:${ply}`;
 115   const prefix = source.slice(0, ply);
 116   const board = replayPacketBoard({ gameId, ply, fen, history: prefix, boardId });
 117   const actions = legalActions(board);
 118   if (!actions.size || actions.size > 256) throw Error('Board needs 1..256 legal actions');
 119   const moves = [...actions.keys()].sort(byText);
 120   const isR = group === 'R';
 121   const ineligible = (reason, extra = {}) => ({ schema: INELIGIBLE_SCHEMA, eligible: false, boardId, gameId, ply, group, reason, ...extra });
 122 
 123   const proofs = {}, kinds = {}, unknown = [];
 124   for (const move of moves) {
 125     const action = actions.get(move);
 126     if (!isR && action.captured && action.piece !== 'k') {
 127       const proof = captureProof(board, move, maxReplies);
 128       if (proof.status === 'unknown') { unknown.push(move); continue; }
 129       proofs[move] = proof;
 130       kinds[move] = proof.status === 'success' ? 'safe' : 'unsafe';
 131     } else {
 132       proofs[move] = membershipProof(board, move, isR ? R_SCOPE : NONKING_SCOPE, prefix);
 133       kinds[move] = 'membership';
 134     }
 135   }
 136   if (unknown.length) return ineligible('unknown-certificate', { unknownMoves: unknown });
 137   const safe = moves.filter(m => kinds[m] === 'safe'), unsafe = moves.filter(m => kinds[m] === 'unsafe');
 138   if (!isR && !safe.length) return ineligible('no-safe-nonking-capture');
 139   if (!isR && !unsafe.length) return ineligible('no-unsafe-nonking-capture');
 140 
 141   const inputHashes = Object.fromEntries(moves.map(m => [m, inputHash(eyes, board.fen(), m)]));
 142   let rTargets = [], outcomes, experiences = [];
 143   if (isR) {
 144     const order = ordered(boardId, moves);
 145     const second = order.find(m => inputHashes[m] !== inputHashes[order[0]]);
 146     if (second === undefined) return ineligible('no-distinct-rendered-targets');
 147     rTargets = [order[0], second];
 148     outcomes = { R1: flagsFor(moves, rTargets[0]), R2: flagsFor(moves, rTargets[1]) };
 149   } else {
 150     outcomes = Object.fromEntries(moves.map(m => [m, kinds[m] === 'safe']));
 151     if (group === 'A' || group === 'B') experiences = prescribed(boardId, safe, unsafe, proofs);
 152   }
 153   return { schema: BOARD_SCHEMA, boardId, gameId, ply, fen: board.fen(), history: prefix, group,
 154     criterion: isR ? R_CRITERION : CAPTURE_CRITERION, legal: moves, outcomes, proofs, inputHashes,
 155     eyesIdentity: eyes.identity, experiences, rTargets };
 156 }
 157 
 158 // Independent verification of a board record. Throws on any mismatch; never mutates the record.
 159 export function verifyPacketBoard(record, { phase = 'chess' } = {}) {
 160   if (record?.schema !== BOARD_SCHEMA) throw Error('Not an eligible board record');
 161   const { group } = record;
 162   if (!GROUPS.includes(group)) throw Error(`Unknown group ${group}`);
 163   const isR = group === 'R';
 164   if (isR ? !['R1', 'R2'].includes(phase) : phase !== 'chess') throw Error(`Phase ${phase} is invalid for group ${group}`);
 165   if (record.criterion !== (isR ? R_CRITERION : CAPTURE_CRITERION)) throw Error('Criterion identity mismatch');
 166   const board = replayPacketBoard(record);
 167   const actions = legalActions(board);
 168   const moves = [...actions.keys()].sort(byText);
 169   if (moves.length > 256 || !same(record.legal, moves)) throw Error('Legal action domain mismatch');
 170   for (const field of ['proofs', 'inputHashes']) if (!same(Object.keys(record[field] ?? {}), moves)) throw Error(`${field} domain mismatch`);
 171 
 172   const kinds = {};
 173   for (const move of moves) {
 174     const action = actions.get(move), proof = record.proofs[move];
 175     if (!isR && action.captured && action.piece !== 'k') {
 176       if (proof?.status === 'unknown') throw Error(`Unknown certificate for ${move} cannot be used`);
 177       const check = checkCaptureRetentionAction(board, move, TASK, proof, {});
 178       if (check.verified !== true || check.learningAllowed !== true || check.status !== proof.status
 179         || !['success', 'failure'].includes(check.status)) throw Error(`Certificate for ${move} fails the independent check`);
 180       kinds[move] = check.status === 'success' ? 'safe' : 'unsafe';
 181     } else {
 182       checkMembership(board, move, proof, record.history, isR ? R_SCOPE : NONKING_SCOPE);
 183       kinds[move] = 'membership';
 184     }
 185   }
 186   if (isR) {
 187     const order = ordered(record.boardId, moves);
 188     const second = order.find(m => record.inputHashes[m] !== record.inputHashes[order[0]]);
 189     if (second === undefined || !same(record.rTargets, [order[0], second])) throw Error('R targets do not match the fixed selection rule');
 190     if (!same(record.experiences, [])) throw Error('R records carry no training experiences');
 191     const outcomes = { R1: flagsFor(moves, record.rTargets[0]), R2: flagsFor(moves, record.rTargets[1]) };
 192     if (!same(record.outcomes, outcomes)) throw Error('R outcomes do not match the contingency rule');
 193     return { board, outcomes: outcomes[phase], legal: moves };
 194   }
 195   const safe = moves.filter(m => kinds[m] === 'safe'), unsafe = moves.filter(m => kinds[m] === 'unsafe');
 196   if (!safe.length || !unsafe.length) throw Error('A/B/test boards need a safe and an unsafe nonking capture');
 197   const outcomes = Object.fromEntries(moves.map(m => [m, kinds[m] === 'safe']));
 198   if (!same(record.outcomes, outcomes)) throw Error('Outcomes do not match the verified certificates');
 199   const expected = group === 'A' || group === 'B' ? prescribed(record.boardId, safe, unsafe, record.proofs) : [];
 200   if (!same(record.experiences, expected)) throw Error('Experiences do not match the verified prescribed set');
 201   if (!same(record.rTargets, [])) throw Error('Chess records carry no R targets');
 202   return { board, outcomes, legal: moves };
 203 }
 204 
 205 // Seeded experience tape. Seed permutes board and action order; arms share this tape.
 206 export function buildExperienceTape(boards, seed) {
 207   if (!Number.isSafeInteger(seed)) throw Error('seed must be a safe integer');
 208   const seenBoards = new Set(), seenGames = new Set();
 209   for (const group of GROUPS) {
 210     if (!Array.isArray(boards?.[group])) throw Error(`boards.${group} must be an array`);
 211     for (const record of boards[group]) {
 212       if (record?.group !== group) throw Error(`Board ${record?.boardId} is tagged ${record?.group}, not ${group}`);
 213       if (seenBoards.has(record.boardId) || seenGames.has(record.gameId)) throw Error(`Duplicate board or game ${record.boardId}`);
 214       seenBoards.add(record.boardId);
 215       seenGames.add(record.gameId);
 216       if (group === 'R') { verifyPacketBoard(record, { phase: 'R1' }); verifyPacketBoard(record, { phase: 'R2' }); }
 217       else verifyPacketBoard(record);
 218     }
 219   }
 220   for (const group of ['A', 'B', 'R']) if (!boards[group].length) throw Error(`Group ${group} needs at least one board`);
 221 
 222   const rng = mulberry32(seed);
 223   const permute = (list, next) => {
 224     const a = [...list];
 225     for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(next() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
 226     return a;
 227   };
 228   const shuffle = list => permute(list, rng);
 229   const events = [], probeAfter = [], ranges = [];
 230   let rankingPasses = 0;
 231   const probe = phase => probeAfter.push({ cursor: events.length, phase });
 232   const push = (phase, record, move, pulse, proofSha) => {
 233     const sequence = events.length;
 234     events.push({ sequence, eventId: digest({ seed, sequence, phase, boardId: record.boardId, move, criterion: record.criterion }),
 235       phase, group: record.group, boardId: record.boardId, move, pulse, criterion: record.criterion, proofSha });
 236     rankingPasses += record.legal.length;
 237   };
 238   const phaseRun = (phase, fill) => {
 239     const start = events.length;
 240     fill();
 241     ranges.push({ phase, start, end: events.length });
 242   };
 243   // A and B: board order permuted, then the four prescribed actions of each board permuted. Probes at 8/16/32 and end.
 244   const train = group => phaseRun(group, () => {
 245     const n = boards[group].length;
 246     shuffle(boards[group]).forEach((record, index) => {
 247       for (const e of shuffle(record.experiences)) push(group, record, e.move, e.pulse, e.proofSha);
 248       const k = index + 1;
 249       if (k === n) probe(`${group}-end`);
 250       else if (MARKS.includes(k)) probe(`${group}-${k}`);
 251     });
 252   });
 253   // R: board order permuted; four cycles, each cycle presents both targets in permuted order.
 254   const rounds = phase => phaseRun(phase, () => {
 255     const targetIndex = phase === 'R1' ? 0 : 1;
 256     shuffle(boards.R).forEach(record => {
 257       for (let cycle = 0; cycle < 4; cycle++) {
 258         for (const move of shuffle(record.rTargets)) push(phase, record, move, move === record.rTargets[targetIndex], record.proofs[move].certificateSha256);
 259       }
 260     });
 261     probe(`${phase}-end`);
 262   });
 263   train('A');
 264   rounds('R1');
 265   train('B');
 266   rounds('R2');
 267 
 268   // Pulse-count-preserving shuffle within each complete phase, from a separate stream so the primary order is unchanged.
 269   const shuffledPulses = events.map(e => e.pulse);
 270   const pulseRng = mulberry32(seed ^ 0x9e3779b9);
 271   for (const { start, end } of ranges) {
 272     permute(events.slice(start, end).map(e => e.pulse), pulseRng).forEach((p, i) => { shuffledPulses[start + i] = p; });
 273   }
 274   const sum = (list, f) => list.reduce((total, x) => total + f(x), 0);
 275   const abLegal = sum([...boards.A, ...boards.B], r => r.legal.length);
 276   const rLegal = sum(boards.R, r => r.legal.length);
 277   const byPhase = Object.fromEntries(ranges.map(({ phase, start, end }) => [phase, {
 278     events: end - start,
 279     pulses: events.slice(start, end).filter(e => e.pulse).length,
 280     shuffledPulses: shuffledPulses.slice(start, end).filter(Boolean).length,
 281   }]));
 282   const counts = {
 283     boards: Object.fromEntries(GROUPS.map(g => [g, boards[g].length])),
 284     events: events.length,
 285     positivePulses: events.filter(e => e.pulse).length,
 286     byPhase,
 287     rankingPasses,
 288     teachingReplayPasses: events.length,
 289     probes: {
 290       initial: 1,
 291       checkpoints: probeAfter.length,
 292       rankingPasses: abLegal * (1 + probeAfter.length) + rLegal * probeAfter.filter(p => p.phase.startsWith('R')).length,
 293     },
 294   };
 295   return { seed, events, shuffledPulses, sha256: digest({ seed, events, shuffledPulses }), counts,
 296     initialProbe: { cursor: 0, phase: 'T0' }, probeAfter };
 297 }
