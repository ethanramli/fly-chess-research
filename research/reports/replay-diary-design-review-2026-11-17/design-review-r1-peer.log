   1 // Three-board feedback test (documentation/design/neural-learning/three-board-feedback-test-2026-11-14.md).
   2 // Shared by probe-wide-learning-v3.mjs (runs one circuit and condition) and apply-three-board-rules-v1.mjs (applies the fixed rules).
   3 // The learning rule, pulses and modulation matrix are copied unchanged from probe-wide-learning-v2.mjs.
   4 export const MIN_GAIN = 0.2, MAX_GAIN = 1.8, ACT = 1.5, ETA = 0.5, PULSE = 0.75, PASSES = 6, CAP_KEEP = 0.99;
   5 export const BOARD_IDS = ['Q04sIPQ5:13', 'SjmcbcGu:16', '5XRGyGSj:13'];
   6 export const CIRCUITS = { current: { bias: null, kcScale: null }, quiet: { bias: 0, kcScale: 0.014047 } }; // null bias: trainer default 0.01
   7 export const CONDITIONS = ['correct', 'swapped', 'off'];
   8 export const VALENCE = new Map([['MBON11', 1], ['MBON12', 1], ['MBON02', 1], ['MBON05', -1], ['MBON01', -1], ['MBON15', -1]]);
   9 export const DAN_TYPES = ['PAM07', 'PAM02', 'PAM03', 'PPL101', 'PPL103'], REWARD_TYPES = ['PAM07', 'PAM02'], PUNISH_TYPES = ['PPL101', 'PPL103'];
  10 export const W = { PAM07: { MBON05: -1 }, PPL101: { MBON11: -1 }, PAM02: { MBON01: -1, MBON02: 0.3 }, PPL103: { MBON12: -1 - 0.3, MBON15: 0.3 - 1 }, PAM03: { MBON02: -1, MBON01: -0.3 } };
  11 export const RULES = { closure: 0.20, advantage: 0.20, overCurrent: 0.10, drop: 0.05, eligibleTolerances: 100 };
  12 export const LESSONS_PER_PASS = 4;
  13 // Closures are ratios of score differences, so a result meant to sit exactly on a cutoff can land a hair either side
  14 // (with the real first board's gap, scores built to close 20% compute as 0.19999999999994725). That rounding is about 1e-13;
  15 // 1e-9 (a billionth of the gap) is far above it and far below any difference that matters, so a value within 1e-9 of a cutoff
  16 // counts as on it. The cutoffs are unchanged.
  17 export const CUTOFF_SLACK = 1e-9;
  18 export const atLeast = (value, cutoff) => value >= cutoff - CUTOFF_SLACK; // "at least 20%": exactly 20% meets it
  19 export const under = (value, cutoff) => value < cutoff - CUTOFF_SLACK; // "under 5 points": exactly 5 points does not
  20 
  21 const avg = xs => xs.reduce((sum, x) => sum + x, 0) / xs.length;
  22 
  23 // Label delivered per lesson. Swapped reverses every label; learning off delivers the correct labels but never changes a gain.
  24 export function lessonLabels(experiences, condition) {
  25   if (!CONDITIONS.includes(condition)) throw Error(`Unknown condition ${condition}`);
  26   return experiences.map(e => ({ move: e.move, label: (condition === 'swapped' ? !e.pulse : e.pulse) ? 'reward' : 'punish' }));
  27 }
  28 
  29 // How a Kenyon cell's rate enters the rule: current circuit rate / 1.5; quiet circuit min(1, rate / kcScale).
  30 export const kcReading = (rate, kcScale) => kcScale === null ? Math.max(0, rate) / ACT : Math.min(1, Math.max(0, rate) / kcScale);
  31 
  32 // Mean firing per dopamine type (rate / 1.5, as in v2) and the learning signal per output type.
  33 export function dopamineSignal(h, danCells) {
  34   const danMean = Object.fromEntries(DAN_TYPES.map(t => [t, avg(danCells[t].map(j => Math.max(0, h[j]) / ACT))]));
  35   const D = Object.fromEntries([...VALENCE.keys()].map(m => [m, DAN_TYPES.reduce((sum, t) => sum + (W[t][m] ?? 0) * danMean[t], 0)]));
  36   return { danMean, D };
  37 }
  38 
  39 // Best safe capture and strongest rival (best move that is not a verified safe capture). gap > 0: the safe capture is behind.
  40 export function rankMoves(scores, safeMoves) {
  41   const safe = new Set(safeMoves), list = Object.entries(scores).map(([move, score]) => ({ move, score }));
  42   const best = xs => xs.reduce((a, b) => (b.score > a.score ? b : a));
  43   const safeList = list.filter(s => safe.has(s.move)), otherList = list.filter(s => !safe.has(s.move));
  44   if (!safeList.length || !otherList.length) throw Error('Board needs a safe capture and another legal move');
  45   const bestSafe = best(safeList), rival = best(otherList), values = list.map(s => s.score);
  46   return { bestSafe, rival, gap: rival.score - bestSafe.score, above: list.filter(s => s.score > bestSafe.score).length,
  47     maxAbs: Math.max(...values.map(Math.abs)), range: Math.max(...values) - Math.min(...values) };
  48 }
  49 
  50 // Share of the edge-weighted rate difference between two moves that survives capping at scale; null when the rates are identical.
  51 export function capKept(a, b, weights, scale) {
  52   let original = 0, kept = 0;
  53   for (let k = 0; k < weights.length; k++) {
  54     original += weights[k] * Math.abs(a[k] - b[k]);
  55     kept += weights[k] * Math.abs(Math.min(a[k], scale) - Math.min(b[k], scale));
  56   }
  57   return original === 0 ? null : kept / original;
  58 }
  59 
  60 // One board from a fresh memory state: 7 checkpoints (before teaching, then after each pass) and 24 lesson records.
  61 // forward(fen, move, pulse) returns the endpoint state; pulse is 'reward', 'punish' or null. setMagnitude changes one learnable edge.
  62 // mask[i] is an edge, maskType[i] its output type, maskPre[i] its presynaptic cell; cells/weights list distinct presynaptic cells and edge counts.
  63 export function runBoard({ record, condition, kcScale, forward, setMagnitude, base, mask, maskType, maskPre, cells, weights, danCells, scoreOf, log = () => {} }) {
  64   const gains = new Float64Array(mask.length).fill(1);
  65   mask.forEach((e, i) => setMagnitude(e, base[i])); // fresh memory: every learnable edge back to its starting value
  66   const safeMoves = record.legal.filter(m => record.outcomes[m] === true);
  67   const ratesOf = h => Float64Array.from(cells, j => Math.max(0, h[j]));
  68   const before = new Map(); // move -> learnable-cell rates before teaching
  69   let rival = null, rivalRates = null;
  70   const checkpoint = pass => {
  71     const scores = {}, rates = new Map();
  72     for (const move of record.legal) { const h = forward(record.fen, move, null); scores[move] = scoreOf(h); rates.set(move, ratesOf(h)); }
  73     if (pass === 0) for (const [m, r] of rates) before.set(m, r);
  74     const ranked = rankMoves(scores, safeMoves);
  75     rival = ranked.rival.move; rivalRates = rates.get(rival);
  76     const gainsAtLimit = gains.filter(g => g === MIN_GAIN || g === MAX_GAIN).length;
  77     log(`${record.boardId} pass ${pass}: safe ${ranked.bestSafe.move} rival ${ranked.rival.move} gap ${ranked.gap.toExponential(4)} above ${ranked.above}`);
  78     return { pass, scores, ...ranked, gainsAtLimit, meanAbsGainDev: avg(Array.from(gains, g => Math.abs(g - 1))) };
  79   };
  80   const checkpoints = [checkpoint(0)], lessons = [];
  81   const labels = lessonLabels(record.experiences, condition);
  82   for (let pass = 1; pass <= PASSES; pass++) {
  83     const passRates = [];
  84     labels.forEach(({ move, label }, index) => {
  85       const h = forward(record.fen, move, label);
  86       const { danMean, D } = dopamineSignal(h, danCells);
  87       if (Object.values(D).some(d => ETA * Math.abs(d) > 1)) throw Error(`Teaching step exceeds bound on ${record.boardId} pass ${pass} lesson ${index}: ${JSON.stringify(D)}`); // checked before any change
  88       const rates = ratesOf(h);
  89       let cap = null;
  90       if (kcScale !== null) {
  91         const kept = [...before.values(), ...passRates].map(other => capKept(rates, other, weights, kcScale)).filter(x => x !== null);
  92         let active = 0, atCap = 0;
  93         const capped = [];
  94         rates.forEach((r, k) => { if (r > 0) { active += weights[k]; if (r >= kcScale) { atCap += weights[k]; capped.push(k); } } });
  95         cap = { worstKept: kept.length ? Math.min(...kept) : null, comparisons: kept.length, activeShareAtCap: active ? atCap / active : 0,
  96           cappedCells: capped.length, cappedCellsActiveInRival: capped.filter(k => rivalRates[k] > 0).length, rival };
  97       }
  98       passRates.push(rates);
  99       let changed = 0;
 100       if (condition !== 'off') mask.forEach((e, i) => {
 101         const k = kcReading(h[maskPre[i]], kcScale);
 102         const next = Math.min(MAX_GAIN, Math.max(MIN_GAIN, gains[i] + ETA * D[maskType[i]] * (k + gains[i] - 1)));
 103         if (next !== gains[i]) { changed++; gains[i] = next; setMagnitude(e, base[i] * next); }
 104       });
 105       lessons.push({ pass, index, move, label, danMean, D, changed, atLimit: gains.filter(g => g === MIN_GAIN || g === MAX_GAIN).length, cap });
 106     });
 107     checkpoints.push(checkpoint(pass));
 108   }
 109   return { boardId: record.boardId, safeMoves, experiences: record.experiences.map(e => ({ move: e.move, pulse: e.pulse })), checkpoints, lessons };
 110 }
 111 
 112 // Decision rules, fixed before data. results[circuit][condition] is a result.json object or { failed: reason };

