   1 // Fixed cubic-exit development hypothesis; not measured fly physiology. Frozen quadratic parent stays unchanged.
   2 import { digest } from './mushroom-body.mjs';
   3 import { stepLocalGated } from './local-gated-memory.mjs';
   4 import { LocalReservoirMemory } from './local-reservoir-memory.mjs';
   5 import { EXIT_D0 } from './local-supralinear-reservoir-memory.mjs';
   6 
   7 export function stepCubicReservoir(input, states, config) {
   8   const local = stepLocalGated(input, config), drive = input.excess + input.deficit;
   9   if (drive === 0 || local.trace === 0) return { gain: input.gain, trace: local.trace, states };
  10   const base = local.trace * config.eta * drive * input.dt;
  11   const p = -Math.expm1(-base), px = -Math.expm1(-base * (drive / EXIT_D0) ** 2);
  12   const pd = p * input.excess / drive, pu = p * input.deficit / drive, xd = px * input.excess / drive, xu = px * input.deficit / drive;
  13   const [s0, s1, w0, w1] = states;
  14   const next = [(1 - p) * s0 + xd * s1, (1 - xd) * s1 + pu * (s0 + w0), (1 - p) * w0 + xu * w1, (1 - xu) * w1 + pd * (w0 + s0)];
  15   const total = next.reduce((a, b) => a + b, 0);
  16   if (!Number.isFinite(total) || Math.abs(total - 1) > 1e-12 || next.some(x => !Number.isFinite(x) || x < 0)) throw Error('Invalid cubic reservoir mass');
  17   for (let i = 0; i < 4; i++) next[i] /= total;
  18   return { gain: config.minGain + (config.maxGain - config.minGain) * (next[0] + next[1]), trace: local.trace, states: next };
  19 }
  20 
  21 export class LocalCubicReservoirMemory extends LocalReservoirMemory {
  22   constructor(model, mapping, config = {}) {
  23     super(model, mapping, config);
  24     this.identity = digest({ schema: 'local-cubic-reservoir-v1', parent: this.identity, exitD0: EXIT_D0, exponent: 3 });
  25   }
  26   observe(rest, dt = 1) {
  27     const h = this.model.h[this.model.steps], { activityScale: scale } = this.config;
  28     if (rest.length !== this.model.n || !Number.isFinite(dt) || dt <= 0) throw Error('Invalid observation interval');
  29     for (const g of this.mapping.groups) for (const i of [...g.kc, ...g.dan.map(d => d.index)]) if (!Number.isFinite(h[i]) || !Number.isFinite(rest[i])) throw Error('Nonfinite local activity');
  30     let offset = 0, changed = 0, pulsed = false;
  31     for (const g of this.mapping.groups) {
  32       let excess = 0, deficit = 0;
  33       for (const { index } of g.dan) { excess += Math.max(0, h[index] - rest[index]) / scale; deficit += Math.max(0, rest[index] - h[index]) / scale; }
  34       excess /= g.dan.length; deficit /= g.dan.length; pulsed ||= excess + deficit > 0;
  35       for (let i = 0; i < g.edges.length; i++, offset++) {
  36         const k = Math.min(1, Math.max(0, h[g.kc[i]] - rest[g.kc[i]]) / scale), before = this.gains[offset];
  37         const next = stepCubicReservoir({ gain: before, trace: this.traces[offset], k, excess, deficit, dt }, this.states.subarray(4 * offset, 4 * offset + 4), this.config);
  38         this.states.set(next.states, 4 * offset); this.traces[offset] = next.trace;
  39         if (next.gain !== before) { this.gains[offset] = next.gain; this.model.setMagnitude(this.edges[offset], this.base[offset] * next.gain); changed++; }
  40       }
  41     }
  42     this.time += dt; if (pulsed) this.pulses++;
  43     return { changedEdges: changed, time: this.time, pulses: this.pulses, scope: 'Cubic reservoir development hypothesis; no biological calibration' };
  44   }
  45 }
