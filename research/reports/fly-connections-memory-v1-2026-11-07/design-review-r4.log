--- python actions/solve_oracle_lp_v1.py
   1: """Multi-rival oracle bound for fly connections memory v1 (journal item 24). Oracle construction, not learning.
   2: 
   3: Linearized model from probe-oracle-lp-v1 dump: with x_e = 1 - g_e in [-0.8, 0.8] (gains in [0.2, 1.8]),
   4: score_m(x) ~= s_m + k_m * sum_e base_e * r_{e,m} * x_e, with k_m fitted from the all-gains-0.9 ranking.
   5: For each safe move i: V_i = max_x min_j (d_j + c_j . x) over failing moves j, d_j = s_i - s_j, c_j = k_i b r_i - k_j b r_j.
   6: Minimax duality on the symmetric box: V_i = min over lambda in the simplex of lambda.d + 0.8 * |sum_j lambda_j c_j|_1.
   7: Any lambda gives an upper bound (certified for the linear model); x = 0.8 * sign(sum lambda c) gives a lower bound.
   8: Usage: python solve_oracle_lp_v1.py DUMP.json OUT_GAINS.json
   9: """
  10: import json
  11: import sys
  12: 
  13: import numpy as np
  14: 
  15: 
  16: def solve(d, C, iters=20000):
  17:     J = len(d)
  18:     lam = np.full(J, 1.0 / J)
  19:     best_upper, best_x, best_lower = np.inf, None, -np.inf
  20:     for t in range(1, iters + 1):
  21:         v = lam @ C
  22:         upper = lam @ d + 0.8 * np.abs(v).sum()
  23:         x = 0.8 * np.sign(v)
  24:         margins = d + C @ x
  25:         lower = margins.min()
  26:         best_upper = min(best_upper, upper)
  27:         if lower > best_lower:
  28:             best_lower, best_x = lower, x
  29:         grad = d + C @ x  # supergradient of the dual objective in lambda (x is its maximizer)
  30:         step = 1.0 / np.sqrt(t) / (np.abs(grad).max() + 1e-30)
  31:         lam = lam * np.exp(-step * grad)
  32:         lam /= lam.sum()
  33:     return best_upper, best_lower, best_x
  34: 
  35: 
  36: def main(dump_path, out_path):
  37:     D = json.load(open(dump_path, encoding='utf-8'))
  38:     moves, s, s09 = D['moves'], np.array(D['scores']), np.array(D['scores09'])
  39:     base, R = np.array(D['base']), np.array(D['rates'])  # R: moves x edges
  40:     drive = R @ base
  41:     k = np.where(drive > 0, (s09 - s) / (0.1 * np.where(drive > 0, drive, 1)), 0.0)
  42:     A = k[:, None] * base[None, :] * R  # A[m, e] = d score_m / d x_e (linear model)
  43:     safe = [m for m, u in enumerate(moves) if D['outcomes'][u]]
  44:     fail = [m for m, u in enumerate(moves) if not D['outcomes'][u]]
  45:     results = []
  46:     for i in safe:
  47:         d = s[i] - s[fail]
  48:         C = A[i][None, :] - A[fail]
  49:         upper, lower, x = solve(d, C)
  50:         results.append({'safe': moves[i], 'upperBound': float(upper), 'lowerBound': float(lower), 'x': x})
  51:     best = max(results, key=lambda r: r['lowerBound'])
  52:     gains = np.clip(1 - best['x'], 0.2, 1.8).tolist()  # 1 - 0.8 rounds to 0.19999999999999996
  53:     json.dump({'schema': 'oracle-lp-gains-v1', 'note': 'oracle construction, not learning', 'board': D['boardId'],
  54:                'bias': D['bias'], 'safe': best['safe'], 'predictedMargin': best['lowerBound'], 'gains': gains,
  55:                'perSafe': [{k2: v for k2, v in r.items() if k2 != 'x'} for r in results],
  56:                'linearFit': {'k': k.tolist()}}, open(out_path, 'w', encoding='utf-8'), indent=1)
  57:     for r in results:
  58:         print(f"{D['boardId']} safe={r['safe']} linear upper bound={r['upperBound']:.3e} best found={r['lowerBound']:.3e}")
  59: 
  60: 
  61: if __name__ == '__main__':
  62:     main(*sys.argv[1:3])
--- python actions/kc_capacity_v1.py
   1: """KC representation capacity test (journal item 25). Oracle question, not learning.
   2: 
   3: Does ANY linear readout of all KC endpoint rates make a safe non-king capture score above every other legal move on a board?
   4: Margin_j(w) = w . (r_s - r_j) for the best safe move s against every failing move j. Two weight domains:
   5:   signed:   w in [-1, 1]^K
   6:   positive: w in [0, 1]^K (excitatory KC-to-MBON synapses), written as w = 0.5 + 0.5 y, y in [-1, 1].
   7: Solved with solve() from solve_oracle_lp_v1.py (box half-width 0.8 there, so inputs are rescaled by 1/0.8).
   8: A positive lower bound is an existence witness for the linear readout; a negative upper bound is a certificate that none exists.
   9: Usage: python kc_capacity_v1.py ALL_KC.json
  10: """
  11: import json
  12: import sys
  13: 
  14: import numpy as np
  15: 
  16: from solve_oracle_lp_v1 import solve
  17: 
  18: 
  19: def main(path):
  20:     D = json.load(open(path, encoding='utf-8'))
  21:     for d in D['dumps']:
  22:         R = np.array(d['allKc'])
  23:         R = R / (np.abs(R).max() or 1.0)  # scale-free: margins are relative to the largest KC rate on the board
  24:         safe = [m for m, u in enumerate(d['moves']) if d['outcomes'][u]]
  25:         fail = [m for m, u in enumerate(d['moves']) if not d['outcomes'][u]]
  26:         best = {}
  27:         for kind in ('signed', 'positive'):
  28:             top = (-np.inf, np.inf, None)
  29:             for i in safe:
  30:                 C = R[i][None, :] - R[fail]
  31:                 if kind == 'signed':
  32:                     upper, lower, _ = solve(np.zeros(len(fail)), C / 0.8, iters=4000)
  33:                 else:
  34:                     upper, lower, _ = solve(0.5 * C.sum(axis=1), 0.5 * C / 0.8, iters=4000)
  35:                 if lower > top[0]:
  36:                     top = (lower, upper, d['moves'][i])
  37:             best[kind] = {'bestLower': top[0], 'upper': top[1], 'safe': top[2]}
  38:         active = float((R > 1e-6).mean())
  39:         print(json.dumps({'theta': d['theta'], 'board': d['boardId'], 'moves': len(d['moves']), 'activeFrac': round(active, 4), **best}))
  40: 
  41: 
  42: if __name__ == '__main__':
  43:     main(sys.argv[1])
--- python actions/incentive_mask_screen_v1.py
   1: """Feasibility screen for a widened (incentive-circuit) plastic mask (journal item 26). Oracle question, not learning.
   2: 
   3: Mask: every positive-sign KC->MBON edge onto the six incentive-circuit MBON types (Gkanias et al. 2022, Table 1;
   4: types from the pinned FBbt ontology). Readout proxy: score(move) = sum over MBON cells of valence * mean-normalised
   5: KC drive, drive = sum_e base_e * g_e * r_kc(move). Attraction +1 (MBON11, MBON12, MBON02), avoidance -1 (MBON05, MBON01, MBON15).
   6: base_e = 0.9 * log1p(initial_e) / sum_row log1p(initial) (SparseTrainer row normalisation, recurrentScale 0.9).
   7: Non-KC inputs and network dynamics are ignored: this is a necessary-capacity screen, not an exact test.
   8: For each board: max over g in [0.2, 1.8] of min over failing moves of score(best safe) - score(fail).
   9: Usage: python incentive_mask_screen_v1.py ALL_KC.json
  10: """
  11: import csv
  12: import json
  13: import sys
  14: 
  15: import numpy as np
  16: 
  17: from solve_oracle_lp_v1 import solve
  18: 
  19: VALENCE = {'MBON11': 1, 'MBON12': 1, 'MBON02': 1, 'MBON05': -1, 'MBON01': -1, 'MBON15': -1}
  20: 
  21: 
  22: def main(path):
  23:     g = np.load('.cache/full.npz')
  24:     row, col, sign, initial, roots = g['csr_indptr'], g['csr_indices'], g['sign'], g['syn_count'], g['root_ids']  # row = postsynaptic (graph.mjs loadGraph)
  25:     index = {int(r): i for i, r in enumerate(roots)}
  26:     kc_order, types = [], {}
  27:     with open('.cache/flywire-annotations-v2.1.0.tsv', encoding='utf-8') as f:
  28:         for rec in csv.DictReader(f, delimiter='\t'):
  29:             i = index.get(int(rec['root_id']))
  30:             if i is None:
  31:                 continue
  32:             if rec['cell_class'] == 'Kenyon_Cell':
  33:                 kc_order.append(i)
  34:             if rec['hemibrain_type'] in VALENCE:
  35:                 types[i] = rec['hemibrain_type']
  36:     kc_pos = {k: p for p, k in enumerate(kc_order)}
  37:     lw = np.log1p(initial.astype(np.float64))
  38:     # per mask edge: (kc position, valence * base / cells of that type)
  39:     count = {t: sum(1 for v in types.values() if v == t) for t in VALENCE}
  40:     edges = []
  41:     for j, t in types.items():
  42:         denom = lw[row[j]:row[j + 1]].sum()
  43:         for e in range(row[j], row[j + 1]):
  44:             if sign[e] == 1 and col[e] in kc_pos:
  45:                 edges.append((kc_pos[col[e]], VALENCE[t] * 0.9 * lw[e] / denom / count[t]))
  46:     P = np.array([p for p, _ in edges]); W = np.array([w for _, w in edges])
  47:     print(json.dumps({'mbonCells': count, 'maskEdges': len(edges)}))
  48:     D = json.load(open(path, encoding='utf-8'))
  49:     for d in D['dumps']:
  50:         R = np.array(d['allKc'])[:, P] * W[None, :]  # per move, per mask edge: valence-weighted drive at gain 1
  51:         s0 = R.sum(axis=1)
  52:         safe = [m for m, u in enumerate(d['moves']) if d['outcomes'][u]]
  53:         fail = [m for m, u in enumerate(d['moves']) if not d['outcomes'][u]]
  54:         best = (-np.inf, None, None)
  55:         for i in safe:
  56:             dvec = s0[i] - s0[fail]
  57:             C = -(R[i][None, :] - R[fail])  # x = 1 - g; score change = -sum R x
  58:             upper, lower, _ = solve(dvec, C, iters=4000)
  59:             if lower > best[0]:
  60:                 best = (lower, upper, d['moves'][i])
  61:         scale = np.abs(s0).max() or 1.0
  62:         print(json.dumps({'theta': d['theta'], 'board': d['boardId'], 'bestMarginRel': best[0] / scale, 'upperRel': best[1] / scale, 'safe': best[2]}))
  63: 
  64: 
  65: if __name__ == '__main__':
  66:     main(sys.argv[1])
