  94: // Extraction only: reads the one actual endpoint h[steps] and copies the rates the mapping names.
  95: // Negative factor = fixed depressing modulatory convention, not negative dopamine concentration.
  96: // Does not modify model, mapping, graph or memory.
  97: export function actualTeachingInputs(model, mapping, { activityScale = 1.5 } = {}) {
  98:   if (!Number.isFinite(activityScale) || activityScale <= 0) throw Error('Invalid activity scale');
  99:   if (mapping?.schema !== mappingSchema || mapping.readyForCandidateExperiment !== true || !mapping.groups?.length) throw Error('Incomplete or unknown mapping');
 100:   if (!Array.isArray(model.h) || model.h.length !== model.steps + 1) throw Error('Invalid model state');
