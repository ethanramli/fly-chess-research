 210: export function compareByGame({ arms, games, primary, comparators, seed }) {
 211:   if (!Array.isArray(games) || games.length === 0 || !games.every(isName)) throw Error('Game IDs must be nonempty strings');
 212:   if (!Number.isInteger(seed) || seed < -(2 ** 31) || seed > 2 ** 31 - 1) throw Error('seed must be a 32-bit integer');
 213:   if (!arms || typeof arms !== 'object') throw Error('arms must be an object');
 214:   for (const [name, scores] of Object.entries(arms)) {
 215:     if (!Array.isArray(scores) || scores.length !== games.length) throw Error(`Arm ${name} needs one score per game`);
 216:     if (!scores.every(x => Number.isFinite(x) && x >= 0 && x <= 1)) throw Error(`Arm ${name} scores must be finite in [0, 1]`);
 217:   }
 218:   return numericPairGate({ arms, games, primary, comparators, minCorrect: 0, minMargin: 0, resamples: 10000, seed, lowerQuantile: 0.025 });
 219: }
