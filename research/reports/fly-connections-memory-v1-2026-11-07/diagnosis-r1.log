 148: export function recordEffectiveWrites(edgeIds, base, beforeGains, afterGains, beforeMagnitude, afterMagnitude) {
 149:   const n = edgeIds.length;
 150:   edgeIndex(edgeIds);
 151:   checkPositive(base, n, 'base');
 152:   checkPositive(beforeGains, n, 'beforeGains');
 153:   checkPositive(afterGains, n, 'afterGains');
 154:   checkMagnitudes(beforeMagnitude, n, 'beforeMagnitude');
 155:   checkMagnitudes(afterMagnitude, n, 'afterMagnitude');
 156:   const out = [];
 157:   for (let i = 0; i < n; i++) {
 158:     const gainChanged = beforeGains[i] !== afterGains[i];
 159:     const beforeBits = bitsOf(beforeMagnitude[i]);
 160:     const afterBits = bitsOf(afterMagnitude[i]);
 161:     const effectiveChanged = beforeBits !== afterBits;
 162:     if (!gainChanged && !effectiveChanged) continue;
 163:     const relativeEffectiveChange = Math.abs(afterMagnitude[i] - beforeMagnitude[i]) / base[i];
 164:     out.push({
 165:       edgeId: edgeIds[i],
 166:       beforeGain: beforeGains[i],
 167:       afterGain: afterGains[i],
 168:       beforeMagnitude: beforeMagnitude[i],
 169:       afterMagnitude: afterMagnitude[i],
 170:       beforeBits,
 171:       afterBits,
 172:       gainChanged,
 173:       effectiveChanged,
 174:       relativeEffectiveChange,
 175:       pressureWrite: effectiveChanged && relativeEffectiveChange >= PRESSURE,
 176:     });
 177:   }
 178:   return out;
 179: }
 180: 
 181: export function summarizePressure(aWrittenEdges, bPressureEdges, base, finalMagnitude, edgeIds) {
 182:   const n = edgeIds.length;
 183:   const index = edgeIndex(edgeIds);
 184:   checkPositive(base, n, 'base');
 185:   checkMagnitudes(finalMagnitude, n, 'finalMagnitude');
 186:   if (!aWrittenEdges || aWrittenEdges.length === 0) throw Error('No A-written edges: empty A capacity');
 187:   const members = (ids, name) => {
 188:     if (!ids || typeof ids[Symbol.iterator] !== 'function') throw Error(`${name} must be a list`);
 189:     const set = new Set();
 190:     for (const id of ids) {
 191:       if (!index.has(id) || set.has(id)) throw Error(`${name} needs unique edge IDs from the mask (bad ${id})`);
 192:       set.add(id);
 193:     }
 194:     return set;
 195:   };
 196:   const written = members(aWrittenEdges, 'aWrittenEdges');
 197:   const pressure = members(bPressureEdges, 'bPressureEdges');
 198:   const shared = [...written].filter(id => pressure.has(id)).length;
 199:   const meaningfulFinal = edgeIds.filter((_, i) => Math.abs(finalMagnitude[i] - base[i]) / base[i] >= PRESSURE).length;
 200:   // Exact integer form of numerator / denominator >= 0.25.
 201:   const sharedPass = shared * 4 >= written.size;
 202:   const maskPass = meaningfulFinal * 4 >= n;
 203:   return {
 204:     shared: { numerator: shared, denominator: written.size, pass: sharedPass },
 205:     mask: { numerator: meaningfulFinal, denominator: n, pass: maskPass },
 206:     pass: sharedPass && maskPass,
 207:   };
 208: }
