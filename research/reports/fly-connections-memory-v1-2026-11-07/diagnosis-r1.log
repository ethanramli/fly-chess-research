 114: // Expected line sequence of one job: T0 probe, then each event followed by the probes due at that cursor (tape order).
 115: export function expectedItems(tape, byGroup) {
 116:   const rank = (label, cursor) => {
 117:     const groups = PROBE_GROUPS[label];
 118:     if (!groups) throw Error(`unknown probe label ${label}`);
 119:     const out = [];
 120:     for (const g of GROUPS) {
 121:       if (!groups.includes(g)) continue;
 122:       const list = [...byGroup[g]].sort((a, b) => byText(a.boardId, b.boardId));
 123:       for (const r of list) out.push({ kind: 'ranking', label, cursor, group: g, boardId: r.boardId, last: false, text: `ranking ${label} ${r.boardId}` });
 124:     }
 125:     if (out.length) out[out.length - 1].last = true;
 126:     return out;
 127:   };
 128:   const items = rank(tape.initialProbe.phase, 0);
 129:   for (const p of tape.probeAfter) {
 130:     if (!Number.isSafeInteger(p.cursor) || p.cursor < 1 || p.cursor > tape.events.length) throw Error(`probe ${p.phase} at cursor ${p.cursor} is outside the tape`);
 131:   }
 132:   for (let i = 0; i < tape.events.length; i++) {
 133:     items.push({ kind: 'event', sequence: i, text: `event ${i}` });
 134:     for (const p of tape.probeAfter) if (p.cursor === i + 1) items.push(...rank(p.phase, p.cursor));
 135:   }
 136:   return items;
 137: }
