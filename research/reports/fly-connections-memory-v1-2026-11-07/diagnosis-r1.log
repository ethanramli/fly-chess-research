 107: async function main(argv) {
 108:   const { runDir, config, replay } = parseCliArgs(argv);
 109:   const registration = JSON.parse(readFileSync(config, 'utf8'));
 110:   const registrationSha256 = await sha256File(config);
 111:   const manifest = readJsonOrNull(join(runDir, 'manifest.json'));
 112:   const summary = readJsonOrNull(join(runDir, 'summary.json'));
 113:   const pins = await pinCheck({ registration, manifest, registrationSha256, root: ROOT, hashFile: sha256File });
 114:   const sourceTexts = Object.fromEntries(SCORING_SOURCES.map(p => [p, readFileSync(join(ROOT, p), 'utf8')]));
 115:   const staticRun = await auditStaticChecks({ runDir, packetDir: resolve(ROOT, registration.paths.packet), registration, sourceTexts, summary });
 116:   let replayRes;
 117:   if (!staticRun.packet) replayRes = { name: 'replay', pass: false, detail: 'packet unreadable; replay not run' };
 118:   else {
 119:     try { replayRes = await replayCheck({ registration, packet: staticRun.packet, runDir, replayN: replay }); }
 120:     catch (e) { replayRes = { name: 'replay', pass: false, detail: `replay failed: ${e.message}` }; }
 121:   }
 122:   const checks = [pins, ...staticRun.checks, replayRes];
 123:   const pass = checks.length === CHECK_NAMES.length && checks.every(c => c.pass);
 124:   const audit = { schema: AUDIT_SCHEMA, pass, pinned: pins.pass, checks, verdictMatches: staticRun.match };
 125:   writeAtomic(join(runDir, 'audit.json'), `${JSON.stringify(audit, null, 2)}\n`);
 126:   for (const c of checks) console.log(`${c.pass ? 'PASS' : 'FAIL'} ${c.name}: ${c.detail}`);
 127:   console.log(pass ? 'AUDIT PASS' : 'AUDIT FAIL');
 128: }
 129: 
 130: if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
 131:   main(process.argv.slice(2)).catch(e => {
 132:     console.error(e.stack ?? e.message);
 133:     process.exitCode = 1;
 134:   });
 135: }

