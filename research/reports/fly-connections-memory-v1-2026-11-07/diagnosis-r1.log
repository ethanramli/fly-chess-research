 223:   // Digest entry for one ranking: metrics on the phase's outcomes, plus the R2 (target 1) metrics for R boards.
 224:   rankingEntry(ranking, record, legal, phase) {
 225:     const outcomes = outcomeSetOf(record, phase);
 226:     const probs = rankingProblems(ranking, record, legal, outcomes);
 227:     for (const p of probs) this.P.add('rankings', `${record.boardId} ${phase}: ${p}`);
 228:     if (!Array.isArray(ranking?.ranked)) return null;
 229:     try {
 230:       const entry = { group: record.group, m0: metricsOf(ranking.ranked, outcomes) };
 231:       if (record.group === 'R') entry.m1 = metricsOf(ranking.ranked, outcomeSetOf(record, 'R2'));
