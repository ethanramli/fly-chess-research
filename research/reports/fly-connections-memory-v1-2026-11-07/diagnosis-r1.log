  71: // Own s, c, success, margin and tie tolerance from the scores. Tie rule: abs(top - score) <= 1e-9 + 1e-7 * max(abs(scores)).
  72: export function metricsOf(ranked, outcomes) {
  73:   const scores = ranked.map(e => e.score);
  74:   const top = Math.max(...scores);
  75:   const tolerance = TIE_ABS + TIE_REL * Math.max(...scores.map(x => Math.abs(x)));
  76:   const tops = ranked.filter(e => Math.abs(top - e.score) <= tolerance);
  77:   const ok = e => outcomes[e.move] === true;
  78:   const s = tops.filter(ok).length;
  79:   const c = tops.length;
  80:   const okScores = ranked.filter(ok).map(e => e.score);
  81:   const badScores = ranked.filter(e => !ok(e)).map(e => e.score);
  82:   const margin = okScores.length && badScores.length ? Math.max(...okScores) - Math.max(...badScores) : null;
  83:   return { s, c, success: s / c, margin, tolerance, topMoves: tops.map(e => e.move) };
