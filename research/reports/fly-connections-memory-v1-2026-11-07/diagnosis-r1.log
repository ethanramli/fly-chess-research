 127: function edgeIndex(edgeIds) {
 128:   if (!edgeIds || edgeIds.length === 0) throw Error('edgeIds must be a nonempty list');
 129:   const index = new Map();
 130:   for (let i = 0; i < edgeIds.length; i++) {
 131:     const id = edgeIds[i];
 132:     if (!Number.isSafeInteger(id) || index.has(id)) throw Error(`Invalid or duplicate edge ID ${id}`);
 133:     index.set(id, i);
 134:   }
 135:   return index;
 136: }
 137: 
 138: function checkPositive(xs, n, name) {
 139:   if (!xs || xs.length !== n) throw Error(`${name} must have one value per edge`);
 140:   for (let i = 0; i < n; i++) if (!(Number.isFinite(xs[i]) && xs[i] > 0)) throw Error(`${name}[${i}] must be finite and positive`);
 141: }
 142: 
 143: function checkMagnitudes(xs, n, name) {
 144:   if (!(xs instanceof Float32Array)) throw Error(`${name} must be a Float32Array`);
 145:   checkPositive(xs, n, name);
 146: }
