 151: // One pass over a job's records.jsonl. Recomputes every event, update, fingerprint and ranking; keeps only the digest the gates need.
 152: class JobWalk {
 153:   constructor({ arm, tape, byGroup, boardsById, result, readSnapshot, legalCache, shared }) {
 154:     if (!ARM_TABLE[arm]) throw Error(`unknown arm ${arm}`);
 155:     this.arm = arm; this.rule = ARM_TABLE[arm]; this.tape = tape; this.boardsById = boardsById; this.result = result;
 156:     this.readSnapshot = readSnapshot; this.legalCache = legalCache; this.shared = shared;
 157:     this.groups = result.describe?.groups ?? [];
 158:     this.danTotal = this.groups.reduce((s, g) => s + g.danCount, 0);
 159:     this.items = expectedItems(tape, byGroup);
 160:     this.lastBIndex = tape.events.reduce((last, e, i) => (e.phase === 'B' ? i : last), -1);
 161:     this.P = new Problems();
 162:     this.pos = 0; this.lastFp = null; this.t0Fp = null; this.gains = null; this.n = 0;
 163:     this.learned = 0; this.eventsSeen = 0; this.passes = 0;
 164:     this.labels = new Map(); this.dSum = { pulse: [0, 0], none: [0, 0] };
 165:     this.base = new Map(); this.edgeOf = new Map(); this.offsetOf = new Map();
 166:     this.pressure = { written: new Set(), pressureEdges: new Set(), finalMagnitude: new Map() };
 167:   }
 168: 
 169:   async run(lines) {
 170:     for await (const line of lines) {
 171:       let consumed = false;
 172:       while (!consumed) {
 173:         if (this.pos >= this.items.length) {
 174:           this.P.add(line?.type === 'event' ? 'events' : 'rankings', `extra line after the last expected line: ${lineText(line)}`);
 175:           break;
 176:         }
 177:         const item = this.items[this.pos];
 178:         if (this.matches(line, item)) { await this.accept(line, item); this.pos++; consumed = true; }
 179:         else {
 180:           this.P.add(item.kind === 'event' ? 'events' : 'rankings', `expected ${item.text}, found ${lineText(line)}`);
 181:           this.pos++;
 182:         }
 183:       }
 184:     }
 185:     while (this.pos < this.items.length) {
 186:       const item = this.items[this.pos++];
 187:       this.P.add(item.kind === 'event' ? 'events' : 'rankings', `missing ${item.text}`);
 188:     }
 189:     if (this.eventsSeen !== this.tape.events.length) this.P.add('events', `${this.eventsSeen} event lines, tape has ${this.tape.events.length}`);
 190:     // Pass accounting belongs to the event lines: a missing line removes its passes as well as its sequence number.
 191:     if (this.passes !== this.result.passes) this.P.add('events', `result passes ${this.result.passes}, recounted from the lines ${this.passes}`);
 192:     return this.digest();
 193:   }
 194: 
 195:   digest() {
 196:     return { labels: this.labels, dSum: this.dSum, pressure: this.pressure, base: this.base, n: this.n, passes: this.passes,
 197:       counts: this.P.counts, lists: this.P.lists, learned: this.learned, eventsSeen: this.eventsSeen };
 198:   }
 199: 
 200:   matches(line, item) {
 201:     if (item.kind === 'event') return line.type === 'event' && line.cursor === item.sequence && line.receipt?.sequence === item.sequence;
