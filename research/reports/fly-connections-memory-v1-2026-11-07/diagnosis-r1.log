 213:   legal(record) {
 214:     if (!this.legalCache.has(record.boardId)) this.legalCache.set(record.boardId, legalOf(record));
 215:     return this.legalCache.get(record.boardId);
 216:   }
 217: 
 218:   setEntry(item, entry) {
