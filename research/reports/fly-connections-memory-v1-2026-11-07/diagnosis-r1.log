 203:     if (line.type === 'ranking') return true;
 204:     // Off arm only: an intermediate probe may reuse the T0 ranking while the fingerprint equals T0 (file formats doc).
 205:     return false; // gates section 3 (code review r1): every arm ranks at every checkpoint, so a 'ranking-reused' line is never valid
 206:   }
