  89:   const out = [];
  90:   if (ranking.boardId !== record.boardId || ranking.gameId !== record.gameId) out.push('boardId or gameId differs');
  91:   const ranked = ranking.ranked;
  92:   if (!Array.isArray(ranked)) return [...out, 'ranked is not a list'];
  93:   if (ranked.length !== legal.length) out.push(`${ranked.length} scored moves for ${legal.length} legal moves`);
  94:   else {
  95:     const at = ranked.findIndex((e, i) => e?.move !== legal[i]);
  96:     if (at >= 0) out.push(`entry ${at} is ${ranked[at]?.move}, expected ${legal[at]} (sorted UCI, each legal move once)`);
  97:   }
  98:   if (ranked.some(e => !Number.isFinite(e?.score))) out.push('a score is not finite');
  99:   if (ranked.some(e => !Array.isArray(e?.mbon) || e.mbon.length !== 2 || !e.mbon.every(x => Number.isFinite(x)))) out.push('an mbon pair is not two finite rates');
 100:   if (ranking.passes !== legal.length) out.push(`passes ${ranking.passes}, expected ${legal.length}`);
 101:   if (out.length) return out;
 102:   const mine = metricsOf(ranked, outcomes);
 103:   for (const k of ['s', 'c', 'success', 'margin', 'tolerance']) {
 104:     if (!Object.is(ranking[k], mine[k])) out.push(`${k} stored ${ranking[k]}, recomputed ${mine[k]}`);
 105:   }
 106:   const tops = Array.isArray(ranking.topMoves) ? ranking.topMoves.map(t => t?.move) : null;
 107:   if (!sameValue(tops, mine.topMoves)) out.push('topMoves differ from the recomputed top set');
 108:   let best = ranked[0];
 109:   for (const e of ranked) if (e.score > best.score) best = e;
 110:   if (ranking.choice !== best.move) out.push(`choice ${ranking.choice}, recomputed ${best.move}`);
 111:   return out;
