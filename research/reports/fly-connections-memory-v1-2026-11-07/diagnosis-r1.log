  15: const SCOPE = 'Computational endpoint model: raw fixed MBON05 endpoint score; actual local DAN-rate gain rule on mapped gamma KC-to-MBON05 edges; quasi-steady, no biological clock, no receptor kinetics, no transmitter identity, not a calibrated value.';
  16: const PULSE_CURRENT = 0.75; // scheduled experimental current per mapped PAM07 cell
  17: const MEMORY = { eta: 0.5, minGain: 0.2, maxGain: 1.8, activityScale: 1.5 };
  18: const CHESS_GROUPS = new Set(['A', 'B', 'testA', 'testB']);
  19: const TAPE_GROUP = { A: 'A', B: 'B', R1: 'R', R2: 'R' };
  20: const TAPE_PHASE = { A: 'chess', B: 'chess', R1: 'R1', R2: 'R2' };
  21: // Pulse rule: experience = verified tape pulse, absent = never, delivered = scheduler's shuffled boolean.
  22: // learns = false only for the explicit off control, which holds all persistent memory fixed.
  23: const ARMS = {
  24:   'informative-local': { apl: 'local', pulse: 'experience', learns: true },
  25:   'absent-local': { apl: 'local', pulse: 'absent', learns: true },
  26:   'off-local': { apl: 'local', pulse: 'experience', learns: false },
  27:   'shuffled-local': { apl: 'local', pulse: 'delivered', learns: true },
  28:   'informative-matched': { apl: 'matched', pulse: 'experience', learns: true },
  29:   'informative-global': { apl: 'global', pulse: 'experience', learns: true },
  30: };
  31: 
  32: const hashJson = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
  33: const bytes = a => Buffer.from(a.buffer, a.byteOffset, a.byteLength);
  34: // Same hashing as eyes-v2 inputCollisions: SHA-256 of JSON over [index,current] pairs sorted by index.
  35: const stimulusHash = stimulation => hashJson(stimulation.map(({ index, current }) => [index, current]).sort((a, b) => a[0] - b[0]));
  36: function digestOf(header, arrays) {
  37:   const hash = createHash('sha256').update(header);
  38:   for (const a of arrays) hash.update(bytes(a));
  39:   return hash.digest('hex');
  40: }
