 107: // Resume: finished jobs are copied byte for byte; unfinished job directories are copied so their worker resumes from state.json.
 108: const resumedFrom = { run: null, finished: [], unfinished: [] };
 109: const queue = [];
 110: 
 111: try {
 112:   if (args['resume-from']) {
 113:     const old = args['resume-from'];
 114:     const oldManifest = JSON.parse(readFileSync(join(old, 'manifest.json'), 'utf8'));
 115:     assert.equal(oldManifest.registrationSha256, manifest.registrationSha256, 'Resume: the registration differs from the old run');
 116:     assert.notEqual(oldManifest.status, 'complete', 'Resume: the old run is complete');
 117:     assert(!(oldManifest.status === 'running' && alive(oldManifest.pid)), 'Resume: the old run still has a live process');
 118:     resumedFrom.run = old;
 119:   }
 120:   for (const job of jobs) {
 121:     const from = args['resume-from'] ? join(args['resume-from'], 'jobs', job.name) : null;
 122:     if (from && existsSync(join(from, 'result.json'))) {
 123:       resumedFrom.finished.push({ job: job.name, files: copyTree(from, join(jobsDir, job.name)) });
 124:       job.status = 'copied';
 125:     } else {
 126:       if (from && existsSync(from)) resumedFrom.unfinished.push({ job: job.name, files: copyTree(from, join(jobsDir, job.name)) });
 127:       queue.push(job);
 128:     }
 129:   }
 130:   writeManifest({ resumedFrom: args['resume-from'] ? resumedFrom : null, jobs: jobList() });
 131: 
 132:   await runWorkers(queue);
 133:   guard();
 134: 
 135:   // Baselines per seed (graph-free). baselines.perSeed[seed][storeKey][shuffled] = runStoreBaseline output; baselines.uniform[boardId] = uniformBaselines output.
 136:   const retina = loadRetina(config.paths.graph), eyes = createEyesV2(retina);
 137:   const boards = new Map();
 138:   for (const line of readFileSync(join(config.paths.packet, 'boards.jsonl'), 'utf8').split('\n')) {
 139:     if (!line.trim()) continue;
 140:     const record = JSON.parse(line);
 141:     boards.set(record.boardId, record);
 142:   }
 143:   const evaluate = [...boards.values()].filter(r => CHESS_GROUPS.includes(r.group)).map(r => r.boardId);
 144:   const packet = JSON.parse(readFileSync(join(config.paths.packet, 'packet.json'), 'utf8'));
 145:   const tapes = new Map();
 146:   for (const seed of config.seeds) {
 147:     const tape = JSON.parse(readFileSync(join(config.paths.packet, 'tapes', `${seed}.json`), 'utf8'));
 148:     assert.equal(tape.sha256, packet.tapes[seed]?.sha256, `Tape ${seed} differs from packet.json`);
 149:     tapes.set(seed, tape);
 150:   }
 151:   const perSeed = {};
 152:   for (const seed of config.seeds) {
 153:     perSeed[seed] = Object.fromEntries(STORE_KEYS.map(key => [key, Object.fromEntries([false, true].map(shuffled => [shuffled,
 154:       runStoreBaseline({ key, records: boards, tape: tapes.get(seed), eyes, retinaIdx: retina.retina_idx, evaluate, shuffled })]))]));
 155:   }
 156:   const uniform = Object.fromEntries(evaluate.map(id => [id, uniformBaselines(boards.get(id))]));
 157:   const baselines = { perSeed, uniform };
 158:   guard();
 159: 
 160:   const judged = await judgeRun({ runDir: out, registration: config, records: boards, tapes, baselines });
 161:   writeAtomic(join(out, 'summary.json'), JSON.stringify({ schema: 'fly-connections-memory-v1-summary', perSeed: judged.perSeed,
 162:     baselines, verdict: judged.verdict, pass: judged.pass }, null, 2) + '\n');
 163:   writeAtomic(join(out, 'records.jsonl'), jobs.map(job => JSON.stringify({ seed: job.seed, arm: job.arm,
 164:     resultSha256: sha(readFileSync(join(jobsDir, job.name, 'result.json'))) }) + '\n').join(''));
 165:   writeManifest({ status: 'complete', endedAt: new Date().toISOString(), verdict: judged.verdict, pass: judged.pass,
 166:     runnerPeakRssMiB: process.resourceUsage().maxRSS / 1024, jobs: jobList() });
 167: } catch (error) {
 168:   writeManifest({ status: 'failed', endedAt: new Date().toISOString(), error: error.message, jobs: jobList() });
 169:   throw error;
 170: }
 104:   renameSync(`${path}.partial`, path);
