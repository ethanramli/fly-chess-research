 281:     return { arm, tapeOk: tape === tapeSha256, peakRssMiB, minFreeMiB,
 282:       rssOk: Number.isFinite(peakRssMiB) && peakRssMiB <= RSS_MAX_MIB,
 283:       freeOk: Number.isFinite(minFreeMiB) && minFreeMiB >= FREE_MIN_MIB };
 284:   });
 285:   return { pass: rows.every(r => r.tapeOk && r.rssOk && r.freeOk), jobs: rows };
