 139: class Problems {
 140:   constructor() {
 141:     this.counts = Object.fromEntries(CATEGORIES.map(c => [c, 0]));
 142:     this.lists = Object.fromEntries(CATEGORIES.map(c => [c, []]));
 143:   }
 144:   add(category, text) {
 145:     this.counts[category]++;
 146:     if (this.lists[category].length < LIST_CAP) this.lists[category].push(text);
 147:   }
