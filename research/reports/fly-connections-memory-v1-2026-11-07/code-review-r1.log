  18: export function scoreAllLegal(board, ranked, outcomes) {
  19:   if (typeof board?.moves !== 'function') throw Error('board must be a chess.js Chess instance');
  20:   const legal = board.moves({ verbose: true }).map(uciOf);
  21:   if (legal.length === 0) throw Error('No legal moves');
  22:   const legalSet = new Set(legal);
  23:   if (legalSet.size !== legal.length) throw Error('Duplicate legal move generated');
  24:   legal.sort(byUci);
  25: 
  26:   if (!Array.isArray(ranked)) throw Error('ranked must be an array');
  27:   const seen = new Set();
  28:   for (const entry of ranked) {
  29:     if (!entry || typeof entry.move !== 'string') throw Error('ranked entries need a string move');
  30:     if (!legalSet.has(entry.move)) throw Error(`Nonlegal ranked move ${entry.move}`);
  31:     if (seen.has(entry.move)) throw Error(`Duplicate ranked move ${entry.move}`);
  32:     if (!Number.isFinite(entry.score)) throw Error(`Nonfinite score for ${entry.move}`);
  33:     seen.add(entry.move);
  34:   }
  35:   if (ranked.length !== legal.length) throw Error(`Ranking has ${ranked.length} moves; legal count is ${legal.length}; every legal move must appear once`);
  36:   ranked.forEach((entry, i) => { if (entry.move !== legal[i]) throw Error('ranked must be sorted by UCI'); });
