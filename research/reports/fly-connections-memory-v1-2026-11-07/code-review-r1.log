  64: class FlyCondition {
  65:   constructor({ model, mapping, eyes, aplPackage, arm, guard }) {
  66:     if (!(model instanceof SparseTrainer)) throw Error('model must be a SparseTrainer');
  67:     // One zero input value only: a random input projection would make the input path a score of its own.
  68:     if (model.inputDim !== 1) throw Error('Unsupported inputDim: the condition feeds one zero input value');
  69:     if (model.config.precision !== 'float32') throw Error('Invalid precision: effective-write receipts need float32 storage');
  70:     if (!Object.hasOwn(ARMS, arm)) throw Error('Invalid arm');
  71:     if (typeof guard !== 'function') throw Error('guard must be a function');
  72:     if (typeof eyes?.encode !== 'function' || typeof eyes.identity !== 'string') throw Error('Invalid eyes encoder');
  73:     if (mapping?.schema !== mappingSchema || mapping.readyForCandidateExperiment !== true) throw Error('Incomplete or unknown mapping');
