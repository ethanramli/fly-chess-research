 186:   }
 187: 
 188:   #verify(record, phase) {
 189:     return verifyPacketBoard(record, { phase: verifyPhaseFor(record.group, phase) });
 190:   }
 191: 
 192:   #deliveredPulse(pulse, explicit) {
 193:     if (this.rule.pulse === 'absent') {
 194:       if (explicit !== undefined && explicit !== false) throw Error('The absent arm receives no external pulse');
 195:       return false;
 196:     }
 197:     if (this.rule.pulse === 'delivered') {
 198:       if (typeof explicit !== 'boolean') throw Error('The shuffled arm needs the scheduled boolean deliveredPulse');
 199:       return explicit;
 200:     }
 201:     if (explicit !== undefined && explicit !== pulse) throw Error('deliveredPulse contradicts the experience pulse');
 202:     return pulse;
 203:   }
 204: 
 205:   #rank(record, verified, checkOrder) {
 206:     this.assertFixed(); // edits outside the mask are rejected before any forward
 207:     const { board, outcomes, legal } = verified;
 208:     const fen = board.fen(), plies = board.history().length;
 209:     // Every legal action's stimulus is bound to the sealed record before the first forward.
 210:     const stimuli = new Map(legal.map(move => [move, this.#bind(record, move)]));
 211:     let passes = 0;
 212:     // One fingerprint per board, not per forward: a full fingerprint costs about as much as a pass (2.7M edges).
 213:     const before = this.fingerprint();
 214:     const evaluate = move => {
 215:       const result = this.#evaluate(stimuli.get(move));
 216:       if (board.fen() !== fen || board.history().length !== plies) throw Error('Board changed during observation');
 217:       passes++;
 218:       return { move, ...result };
 219:     };
 220:     const ranked = legal.map(evaluate);
 221:     if (checkOrder) {
 222:       for (let i = legal.length - 1; i >= 0; i--) {
 223:         const again = evaluate(legal[i]);
 224:         if (again.score !== ranked[i].score || again.mbon.some((v, k) => v !== ranked[i].mbon[k])) {
 225:           throw Error(`Candidate-order dependence at ${legal[i]}`);
 226:         }
 227:       }
 228:     }
 229:     if (this.fingerprint() !== before) throw Error('Persistent state changed during observation');
 230:     const metrics = scoreAllLegal(board, ranked, outcomes);
 231:     const choice = ranked.reduce((best, e) => (e.score > best.score ? e : best)).move; // ties: earliest UCI
 232:     return { schema: 'fly-connections-ranking-v1', boardId: record.boardId, gameId: record.gameId, ranked, choice, ...metrics, passes };
 233:   }
 234: 
 235:   #evaluate(stimulation) {
 236:     this.#forward(stimulation);
 237:     const endpoint = this.model.h[this.model.steps], saturation = this.model.saturation;
 238:     const mbon = this.mapping.groups.map(g => {
 239:       const v = endpoint[g.mbon.index];
 240:       if (!(Number.isFinite(v) && v >= 0 && v <= saturation)) throw Error('Invalid MBON05 endpoint rate');
 241:       return v;
 242:     });
 243:     // Ranking keeps only the two MBON05 rates; full KC/DAN rates are recorded for the teaching replay only (bounded records).
 244:     const score = -(mbon.reduce((sum, v) => sum + v, 0) / mbon.length);
 245:     return { score, mbon };
 246:   }
 247: 
 248:   #bind(record, move) {
 249:     if (this.eyes.identity !== record.eyesIdentity) throw Error('Eyes identity differs from the sealed record');
 250:     const { stimulation } = this.eyes.encode(record.fen, move);
 251:     if (!Array.isArray(stimulation) || record.inputHashes?.[move] !== stimulusHash(stimulation)) {
 252:       throw Error(`Input hash differs from the sealed record for ${move}`);
 253:     }
 254:     return stimulation;
 255:   }
 256: 
 257:   // Every actual forward goes through here so the caller's guard sees each pass.
 258:   #forward(stimulation) {
 259:     this.guard({ kind: 'forward', when: 'before' });
 260:     this.model.forward(new Float32Array(this.model.inputDim), stimulation, null); // zero transient state
 261:     this.guard({ kind: 'forward', when: 'after' });
 262:   }
 263: 
 264:   #effectiveMagnitudes() {
 265:     return Float32Array.from(this.memory.edges, e => this.model.params.magnitude[e]);
 266:   }
 267: }
 268: 
 269: export function createFlyCondition({ model, mapping, eyes, aplPackage, arm, guard = () => {} }) {
 270:   return new FlyCondition({ model, mapping, eyes, aplPackage, arm, guard });
 271: }
