  26: 
  27: export function parseCliArgs(argv) {
  28:   const usage = 'usage: --run RUNDIR --config REG [--replay N]';
  29:   const args = {};
  30:   for (let i = 0; i < argv.length; i += 2) {
  31:     if (!['--run', '--config', '--replay'].includes(argv[i]) || argv[i + 1] === undefined) throw Error(usage);
  32:     args[argv[i].slice(2)] = argv[i + 1];
  33:   }
  34:   if (!args.run || !args.config) throw Error(usage);
  35:   const replay = args.replay === undefined ? 4 : Number(args.replay);
  36:   if (!Number.isSafeInteger(replay) || replay < 1) throw Error('--replay must be an integer of at least 1');
  37:   return { runDir: resolve(args.run), config: resolve(args.config), replay };
  38: }
  39: 
  40: // Check 10: rebuild the condition from the pinned graph as the worker does; re-teach the first N events and compare every receipt
  41: // bit for bit; restore the job's R2-end snapshot and re-rank the first two test boards (boardId order) bit for bit.
  42: async function replayCheck({ registration, packet, runDir, replayN }) {
  43:   const graphPath = resolve(ROOT, registration.paths.graph);
  44:   const graph = loadGraph(graphPath);
  45:   const rootIds = readNpz(graphPath, ['root_ids']).root_ids;
  46:   const readerCells = neuronReaderCells.cells.filter(c => c.type === 'MBON05');
  47:   const mapping = await mapFlyConnectionsMemory(graph, rootIds, resolve(ROOT, registration.paths.annotations), readerCells);
  48:   const eyes = createEyesV2(loadRetina(graphPath));
  49:   const aplPackage = await loadLocalAplPackage(resolve(ROOT, registration.paths.aplPackage));
  50:   const testIds = [...packet.byGroup.testA, ...packet.byGroup.testB].map(r => r.boardId).sort((a, b) => (a < b ? -1 : a > b ? 1 : 0)).slice(0, 2);
  51:   if (testIds.length < 2) throw Error('fewer than two test boards to re-rank');
  52:   const fresh = (arm) => createFlyCondition({ model: new SparseTrainer(graph, registration.model), mapping, eyes, aplPackage, arm, guard: () => {} });
  53:   let jobsReplayed = 0;
  54:   for (const seed of registration.seeds) {
  55:     for (const arm of registration.arms) {
  56:       const name = `${seed}-${arm}`, dir = join(runDir, 'jobs', name);
  57:       const tape = packet.tapes.get(seed).tape;
  58:       const result = JSON.parse(readFileSync(join(dir, 'result.json'), 'utf8'));
  59:       const first = [], stored = new Map();
  60:       for await (const line of jsonlLines(join(dir, 'records.jsonl'))) {
  61:         if (line.type === 'event' && line.cursor < replayN) first[line.cursor] = line.receipt;
  62:         if (line.type === 'ranking' && line.label === 'R2-end' && testIds.includes(line.boardId)) stored.set(line.boardId, line.ranking.ranked);
  63:       }
  64:       const condition = fresh(arm);
  65:       if (condition.fingerprint() !== result.fingerprints.T0) throw Error(`${name}: fresh fingerprint differs from the recorded T0`);
  66:       for (let i = 0; i < replayN; i++) {
  67:         const ev = tape.events[i];
  68:         const experience = { sequence: ev.sequence, eventId: ev.eventId, phase: ev.phase, group: ev.group, boardId: ev.boardId,
  69:           move: ev.move, pulse: ev.pulse, criterion: ev.criterion, proofSha: ev.proofSha };
  70:         const opts = arm === 'shuffled-local' ? { deliveredPulse: tape.shuffledPulses[i] } : {};
  71:         const receipt = JSON.parse(JSON.stringify(condition.teach(packet.boardsById.get(ev.boardId), experience, opts).receipt));
  72:         if (!sameValue(receipt, first[i])) throw Error(`${name}: replayed receipt ${i} differs from the recorded event`);
  73:       }
  74:       const snapshot = JSON.parse(readFileSync(join(dir, 'snapshots', 'R2-end.json'), 'utf8'));
  75:       const later = fresh(arm);
  76:       later.restore(snapshot);
  77:       for (const id of testIds) {
  78:         const ranked = JSON.parse(JSON.stringify(later.rankBoard(packet.boardsById.get(id), { phase: 'chess' }).ranked));
  79:         if (!sameValue(ranked, stored.get(id))) throw Error(`${name}: re-ranked ${id} at R2-end differs from the recorded scores`);
  80:       }
  81:       jobsReplayed++;
  82:     }
  83:   }
  84:   return { name: 'replay', pass: jobsReplayed === registration.seeds.length * registration.arms.length,
  85:     detail: `${jobsReplayed} jobs: first ${replayN} events re-taught with every receipt field equal bit for bit; test boards ${testIds.join(' ')} re-ranked at R2-end with equal scores` };
  86: }
  87: 
  88: function writeAtomic(path, text) {
  89:   writeFileSync(`${path}.partial`, text);
  90:   renameSync(`${path}.partial`, path);
  91: }
  92: 
  93: async function main(argv) {
  94:   const { runDir, config, replay } = parseCliArgs(argv);
  95:   const registration = JSON.parse(readFileSync(config, 'utf8'));
  96:   const registrationSha256 = await sha256File(config);
  97:   const manifest = readJsonOrNull(join(runDir, 'manifest.json'));
  98:   const summary = readJsonOrNull(join(runDir, 'summary.json'));
  99:   const pins = await pinCheck({ registration, manifest, registrationSha256, root: ROOT, hashFile: sha256File });
 100:   const sourceTexts = Object.fromEntries(SCORING_SOURCES.map(p => [p, readFileSync(join(ROOT, p), 'utf8')]));
 101:   const staticRun = await auditStaticChecks({ runDir, packetDir: resolve(ROOT, registration.paths.packet), registration, sourceTexts, summary });
 102:   let replayRes;
 103:   if (!staticRun.packet) replayRes = { name: 'replay', pass: false, detail: 'packet unreadable; replay not run' };
 104:   else {
 105:     try { replayRes = await replayCheck({ registration, packet: staticRun.packet, runDir, replayN: replay }); }
 106:     catch (e) { replayRes = { name: 'replay', pass: false, detail: `replay failed: ${e.message}` }; }
 107:   }
 108:   const checks = [pins, ...staticRun.checks, replayRes];
 109:   const pass = checks.length === CHECK_NAMES.length && checks.every(c => c.pass);
 110:   const audit = { schema: AUDIT_SCHEMA, pass, pinned: pins.pass, checks, verdictMatches: staticRun.match };
 111:   writeAtomic(join(runDir, 'audit.json'), `${JSON.stringify(audit, null, 2)}\n`);
 112:   for (const c of checks) console.log(`${c.pass ? 'PASS' : 'FAIL'} ${c.name}: ${c.detail}`);
 113:   console.log(pass ? 'AUDIT PASS' : 'AUDIT FAIL');
 114: }
 115: 
 116: if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
 117:   main(process.argv.slice(2)).catch(e => {
 118:     console.error(e.stack ?? e.message);
 119:     process.exitCode = 1;
 120:   });
 121: }

