  84:     this.memory = new ReversalMemory(model, mapping, MEMORY);
  85:     const apl = installLocalApl(model, aplPackage, { mode: this.rule.apl });
  86:     const mask = new Uint8Array(model.graph.col.length);
  87:     for (const e of this.memory.edges) mask[e] = 1;
  88:     const outside = [];
  89:     for (let e = 0; e < mask.length; e++) if (!mask[e]) outside.push(e);
  90:     this.outside = Int32Array.from(outside);
  91:     this.bound = { arm, eyes: eyes.identity, apl: apl.identity, mapping: this.memory.identity, fixed: '' };
  92:     this.bound.fixed = this.fixedDigest();
  93:   }
  94: 
  95:   // Initial fixed-state identity: topology, signs, non-mask magnitudes, non-magnitude parameters, base efficacies.
  96:   // Plastic gains and the mask's magnitudes are excluded; they are covered by fingerprint() instead.
  97:   fixedDigest() {
  98:     const { graph, params } = this.model;
  99:     const { magnitude, ...rest } = params;
 100:     const header = JSON.stringify({ schema: SCHEMA, arm: this.arm, apl: this.bound.apl, eyes: this.bound.eyes,
 101:       mapping: this.bound.mapping, config: this.model.config, n: this.model.n, pulse: this.rule.pulse });
 102:     return digestOf(header, [graph.row, graph.col, graph.sign, graph.initial, graph.input, graph.output,
 103:       ...Object.values(rest), this.memory.base, Int32Array.from(this.memory.edges),
 104:       Float32Array.from(this.outside, e => magnitude[e])]);
 105:   }
 106: 
 107:   // Complete persistent state: every parameter, signed magnitude, topology/signs, gains and event count.
 108:   fingerprint() {
 109:     const { graph, params, signedMagnitude } = this.model;
 110:     return digestOf(JSON.stringify(this.bound), [graph.row, graph.col, graph.sign, graph.initial, graph.input, graph.output,
 111:       ...Object.values(params), signedMagnitude, this.memory.gains, Float64Array.of(this.memory.events),
 112:       this.memory.base, Int32Array.from(this.memory.edges)]);
 113:   }
