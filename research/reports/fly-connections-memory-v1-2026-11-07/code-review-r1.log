  72:     if (!(Number.isFinite(r.success) && r.success >= 0 && r.success <= 1)) throw Error(`${name}[${i}] success must be in [0, 1]`);
  73:     if (!(Number.isFinite(r.tolerance) && r.tolerance >= 0)) throw Error(`${name}[${i}] tolerance must be finite and nonnegative`);
