 205: // Seeded experience tape. Seed permutes board and action order; arms share this tape.
 206: export function buildExperienceTape(boards, seed) {
 207:   if (!Number.isSafeInteger(seed)) throw Error('seed must be a safe integer');
 208:   const seenBoards = new Set(), seenGames = new Set();
 209:   for (const group of GROUPS) {
 210:     if (!Array.isArray(boards?.[group])) throw Error(`boards.${group} must be an array`);
 211:     for (const record of boards[group]) {
 212:       if (record?.group !== group) throw Error(`Board ${record?.boardId} is tagged ${record?.group}, not ${group}`);
 213:       if (seenBoards.has(record.boardId) || seenGames.has(record.gameId)) throw Error(`Duplicate board or game ${record.boardId}`);
 214:       seenBoards.add(record.boardId);
 215:       seenGames.add(record.gameId);
 216:       if (group === 'R') { verifyPacketBoard(record, { phase: 'R1' }); verifyPacketBoard(record, { phase: 'R2' }); }
 217:       else verifyPacketBoard(record);
 218:     }
 219:   }
 220:   for (const group of ['A', 'B', 'R']) if (!boards[group].length) throw Error(`Group ${group} needs at least one board`);
 221: 
 222:   const rng = mulberry32(seed);
 223:   const permute = (list, next) => {
 224:     const a = [...list];
 225:     for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(next() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
 226:     return a;
 227:   };
 228:   const shuffle = list => permute(list, rng);
 229:   const events = [], probeAfter = [], ranges = [];
 230:   let rankingPasses = 0;
 231:   const probe = phase => probeAfter.push({ cursor: events.length, phase });
 232:   const push = (phase, record, move, pulse, proofSha) => {
 233:     const sequence = events.length;
 234:     events.push({ sequence, eventId: digest({ seed, sequence, phase, boardId: record.boardId, move, criterion: record.criterion }),
 235:       phase, group: record.group, boardId: record.boardId, move, pulse, criterion: record.criterion, proofSha });
 236:     rankingPasses += record.legal.length;
 237:   };
 238:   const phaseRun = (phase, fill) => {
 239:     const start = events.length;
 240:     fill();
 241:     ranges.push({ phase, start, end: events.length });
 242:   };
 243:   // A and B: board order permuted, then the four prescribed actions of each board permuted. Probes at 8/16/32 and end.
 244:   const train = group => phaseRun(group, () => {
 245:     const n = boards[group].length;
 246:     shuffle(boards[group]).forEach((record, index) => {
 247:       for (const e of shuffle(record.experiences)) push(group, record, e.move, e.pulse, e.proofSha);
 248:       const k = index + 1;
 249:       if (k === n) probe(`${group}-end`);
 250:       else if (MARKS.includes(k)) probe(`${group}-${k}`);
 251:     });
 252:   });
 253:   // R: board order permuted; four cycles, each cycle presents both targets in permuted order.
 254:   const rounds = phase => phaseRun(phase, () => {
 255:     const targetIndex = phase === 'R1' ? 0 : 1;
 256:     shuffle(boards.R).forEach(record => {
 257:       for (let cycle = 0; cycle < 4; cycle++) {
 258:         for (const move of shuffle(record.rTargets)) push(phase, record, move, move === record.rTargets[targetIndex], record.proofs[move].certificateSha256);
 259:       }
 260:     });
 261:     probe(`${phase}-end`);
 262:   });
 263:   train('A');
 264:   rounds('R1');
 265:   train('B');
 266:   rounds('R2');
 267: 
 268:   // Pulse-count-preserving shuffle within each complete phase, from a separate stream so the primary order is unchanged.
 269:   const shuffledPulses = events.map(e => e.pulse);
 270:   const pulseRng = mulberry32(seed ^ 0x9e3779b9);
 271:   for (const { start, end } of ranges) {
 272:     permute(events.slice(start, end).map(e => e.pulse), pulseRng).forEach((p, i) => { shuffledPulses[start + i] = p; });
 273:   }
 274:   const sum = (list, f) => list.reduce((total, x) => total + f(x), 0);
 275:   const abLegal = sum([...boards.A, ...boards.B], r => r.legal.length);
 276:   const rLegal = sum(boards.R, r => r.legal.length);
 277:   const byPhase = Object.fromEntries(ranges.map(({ phase, start, end }) => [phase, {
 278:     events: end - start,
 279:     pulses: events.slice(start, end).filter(e => e.pulse).length,
 280:     shuffledPulses: shuffledPulses.slice(start, end).filter(Boolean).length,
 281:   }]));
 282:   const counts = {
 283:     boards: Object.fromEntries(GROUPS.map(g => [g, boards[g].length])),
 284:     events: events.length,
 285:     positivePulses: events.filter(e => e.pulse).length,
 286:     byPhase,
 287:     rankingPasses,
 288:     teachingReplayPasses: events.length,
 289:     probes: {
 290:       initial: 1,
 291:       checkpoints: probeAfter.length,
 292:       rankingPasses: abLegal * (1 + probeAfter.length) + rLegal * probeAfter.filter(p => p.phase.startsWith('R')).length,
 293:     },
 294:   };
 295:   return { seed, events, shuffledPulses, sha256: digest({ seed, events, shuffledPulses }), counts,
 296:     initialProbe: { cursor: 0, phase: 'T0' }, probeAfter };
 297: }
