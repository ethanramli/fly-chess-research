  36:     if (targets.has(cell.receivingSide) || targetRoots.has(root)) throw Error('Duplicate MBON05 reader');
  37:     targets.set(cell.receivingSide, { index: cell.index, rootId: root.toString() });
  38:     targetRoots.add(root);
