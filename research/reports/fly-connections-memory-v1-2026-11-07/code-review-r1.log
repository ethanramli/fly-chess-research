   1: #!/usr/bin/env node
   2: // Independent auditor for fly connections memory v1 (contract: research/reports/fly-connections-memory-v1-2026-11-07/build-auditor-prompt.txt).
   3: // Usage (repo root): node --max-old-space-size=256 .codebase/scripts/neural-learning/audit-fly-connections-memory-v1.mjs --run RUNDIR --config REG [--replay N]
   4: // Writes RUNDIR/audit.json atomically. Exit 0 after writing (pass or fail); exit 1 only on a crash.
   5: // Only check 10 (replay) loads the pinned graph; it re-executes the first N tape events and re-ranks two test boards, one job at a time.
