  75:       .sort((a, b) => a.index - b.index)
  76:       .map(c => ({ index: c.index, rootId: c.rootId, type: c.type, side: c.side }));
  77:     const edges = [], kc = [], kcRootIds = [];
  78:     for (let e = graph.row[target.index]; e < graph.row[target.index + 1]; e++) {
  79:       const pre = annotated.get(graph.col[e]);
  80:       if (pre?.cls !== 'Kenyon_Cell') { excluded.nonKenyonOrUnannotated++; continue; }
  81:       if (pre.side !== side || !/^KCg-/.test(pre.type)) { excluded.kenyonNotGammaOrOtherSide++; continue; }
