   1: // Fly connections memory v1, revision 2 sections 4-6: pure metrics on supplied numbers.
   2: // Producer module. The independent auditor implements its own arithmetic and must not use this file as an oracle.
   3: import { numericPairGate } from './transfer-evaluation-v2.mjs';
