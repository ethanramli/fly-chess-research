  42: export function validateConfig(config) {
  43:   const fail = message => { throw Error(`config: ${message}`); };
  44:   if (!['development', 'confirmation'].includes(config.purpose)) fail('purpose must be development or confirmation');
  45:   if (config.sealed !== (config.purpose === 'confirmation')) fail('sealed must be true for confirmation and false for development');
  46:   if (config.purpose === 'confirmation' && !(config.exclusions?.sources?.length > 0)) fail('confirmation needs new-source exclusion inputs in exclusions.sources');
  47:   for (const key of ['run', 'positions', 'pgn', 'graph']) if (typeof config.paths?.[key] !== 'string') fail(`paths.${key} is required`);
  48:   for (const key of ['positions', 'pgn', 'graph']) if (!SHA.test(config.pins?.[key] ?? '')) fail(`pins.${key} must be a sha256`);
  49:   if (existsSync(resolve(config.paths.run))) fail('paths.run must be a fresh directory');
  50:   const ids = [];
  51:   for (const group of GROUPS) {
  52:     const list = config.groupGameIds?.[group];
  53:     if (!Array.isArray(list)) fail(`groupGameIds.${group} must be an array`);
  54:     ids.push(...list);
  55:     const want = config.desiredCounts?.[group];
  56:     if (!Number.isSafeInteger(want) || want < 0 || list.length < want) fail(`desiredCounts.${group} must be an integer no larger than its game list`);
  57:     if (['A', 'B', 'R'].includes(group) && want < 1) fail(`desiredCounts.${group} must be at least 1`);
  58:   }
  59:   if (new Set(ids).size !== ids.length) fail('groupGameIds must be disjoint and unique');
  60:   if (!Array.isArray(config.seeds) || !config.seeds.length || !config.seeds.every(Number.isSafeInteger)) fail('seeds must be integers');
  61:   return config;
  62: }
  63: 
  64: async function checkPins(inputs, pins, when) {
  65:   for (const key of Object.keys(inputs)) {
  66:     const actual = await fileSha256(inputs[key]);
  67:     if (actual !== pins[key]) throw Error(`${key} hash ${when} run is ${actual}, pinned ${pins[key]}`);
  68:   }
  69: }
  70: 
  71: // Streams the source PGN and keeps only the text of wanted games.
  72: export async function readGames(path, wanted) {
  73:   const games = new Map();
  74:   let text = null;
  75:   const flush = () => {
  76:     if (text === null) return;
  77:     const id = /^\[GameId "([^"]+)"\]/m.exec(text)?.[1];
  78:     if (id && wanted.has(id)) {
  79:       if (games.has(id)) throw Error(`source PGN repeats game ${id}`);
  80:       games.set(id, `${text.trim()}\n`); // drop the blank separator line that follows each game
  81:     }
  82:   };
  83:   for await (const line of lines(path)) {
  84:     if (line.startsWith('[Event ')) { flush(); text = ''; }
  85:     if (text !== null) text += `${line}\n`;
  86:   }
  87:   flush();
  88:   return games;
  89: }
  90: 
  91: async function run(config, paths, eyes, note) {
  92:   const inputs = { positions: paths.positions, pgn: paths.pgn, graph: paths.graph };
  93:   await checkPins(inputs, config.pins, 'before');
  94:   const excludedGames = new Set(config.exclusions?.gameIds ?? []);
  95:   const excludedBoards = new Set(config.exclusions?.boardIds ?? []);
  96:   for (const source of config.exclusions?.sources ?? []) {
  97:     const path = resolve(source.path);
  98:     if (await fileSha256(path) !== source.sha256) throw Error(`exclusion source hash mismatch: ${source.path}`);
  99:     for await (const line of lines(path)) if (line.trim()) excludedGames.add(JSON.parse(line).gameId);
 100:   }
 101:   const groupOf = new Map(GROUPS.flatMap(g => config.groupGameIds[g].map(id => [id, g])));
 102:   const games = await readGames(paths.pgn, new Set(groupOf.keys()));
 103:   for (const id of groupOf.keys()) if (!excludedGames.has(id) && !games.has(id)) throw Error(`source PGN has no game ${id}`);
 104: 
 105:   const want = config.desiredCounts;
 106:   const selected = Object.fromEntries(GROUPS.map(g => [g, []]));
 107:   const usedGames = new Set(), boardKeys = new Map(), inputOwner = new Map(), tally = {};
 108:   const exclude = (group, row, reason, detail) => {
 109:     tally[reason] = (tally[reason] ?? 0) + 1;
 110:     note({ type: 'excluded', group, gameId: row.gameId, boardId: `${row.gameId}:${row.ply}`, reason, ...(detail ? { detail } : {}) });
 111:   };
 112:   for await (const line of lines(paths.positions)) {
 113:     if (!line.trim()) continue;
 114:     const row = JSON.parse(line);
 115:     const group = groupOf.get(row.gameId);
 116:     if (!group || selected[group].length >= want[group] || usedGames.has(row.gameId)) continue;
 117:     if (excludedGames.has(row.gameId) || excludedBoards.has(`${row.gameId}:${row.ply}`)) { exclude(group, row, 'prior-exclusion'); continue; }
 118:     const result = buildBoardRecord(row, { group, pgn: games.get(row.gameId), eyes });
 119:     if (result.schema !== BOARD_SCHEMA) { exclude(group, row, result.reason, result.unknownMoves ? { unknownMoves: result.unknownMoves } : undefined); continue; }
 120:     const key = result.fen.split(' ').slice(0, 4).join(' ');
 121:     if (boardKeys.has(key)) { exclude(group, row, 'board-key-collision', { other: boardKeys.get(key) }); continue; }
 122:     const clashes = Object.entries(result.inputHashes).flatMap(([move, hash]) => {
 123:       const owner = inputOwner.get(hash);
 124:       return owner && owner.boardId !== result.boardId
 125:         ? [{ move, other: owner.boardId, group: owner.group, answersAgree: owner.answer === answerOf(result, move) }] : [];
 126:     });
 127:     if (clashes.length) {
 128:       exclude(group, row, clashes.some(c => !c.answersAgree) ? 'contradictory-rendered-input' : 'rendered-input-collision', { clashes });
 129:       continue;
 130:     }
 131:     selected[group].push(result);
 132:     usedGames.add(row.gameId);
 133:     boardKeys.set(key, result.boardId);
 134:     for (const [move, hash] of Object.entries(result.inputHashes)) {
 135:       if (!inputOwner.has(hash)) inputOwner.set(hash, { boardId: result.boardId, group, answer: answerOf(result, move) });
 136:     }
 137:     note({ type: 'selected', group, gameId: row.gameId, boardId: result.boardId, legal: result.legal.length });
 138:   }
 139: 
 140:   const counts = Object.fromEntries(GROUPS.map(g => [g, selected[g].length]));
 141:   const shortfall = GROUPS.filter(g => counts[g] < want[g]);
 142:   const summary = { schema: 'fly-connections-packet-prep-summary-v1', purpose: config.purpose,
 143:     status: shortfall.length ? 'incomplete' : 'complete', counts, desired: want, shortfall, exclusions: tally };
 144:   if (shortfall.length) return summary;
 145: 
 146:   const boardsText = GROUPS.flatMap(g => selected[g].map(r => JSON.stringify(r))).join('\n') + '\n';
 147:   writeAtomic(join(paths.run, 'boards.jsonl'), boardsText);
 148:   mkdirSync(join(paths.run, 'tapes'));
 149:   const tapes = {};
 150:   for (const seed of config.seeds) {
 151:     const tape = buildExperienceTape(selected, seed);
 152:     const text = JSON.stringify(tape);
 153:     writeAtomic(join(paths.run, 'tapes', `${seed}.json`), text);
 154:     tapes[seed] = { path: `tapes/${seed}.json`, fileSha256: sha256Text(text), sha256: tape.sha256, counts: tape.counts };
 155:   }
 156:   await checkPins(inputs, config.pins, 'after');
 157:   const packet = {
 158:     schema: PACKET_SCHEMA, purpose: config.purpose,
 159:     sealedScope: { sealed: config.sealed, scope: config.purpose === 'confirmation'
 160:       ? 'sealed confirmation packet; registration and independent review required before any neural use'
 161:       : 'development packet; not confirmation evidence' },
 162:     eyesIdentity: eyes.identity,
 163:     groups: Object.fromEntries(GROUPS.map(g => [g, { count: counts[g], gameIds: selected[g].map(r => r.gameId), boardIds: selected[g].map(r => r.boardId) }])),
 164:     groupAssignmentSha256: sha256Text(JSON.stringify(config.groupGameIds)),
 165:     boards: { path: 'boards.jsonl', sha256: sha256Text(boardsText) },
 166:     tapes,
 167:     sourcePins: { positions: { path: paths.positions, sha256: config.pins.positions }, pgn: { path: paths.pgn, sha256: config.pins.pgn },
 168:       graph: { path: paths.graph, sha256: config.pins.graph } },
 169:     criterion: { capture: CAPTURE_CRITERION, R: R_CRITERION, task: TASK },
 170:     tie: TIE_RULE,
 171:     rSwitch: selected.R.map(r => ({ boardId: r.boardId, rTargets: r.rTargets, inputHashes: r.rTargets.map(m => r.inputHashes[m]) })),
 172:     exclusions: { tally, sources: config.exclusions?.sources ?? [] },
 173:   };
 174:   writeAtomic(join(paths.run, 'packet.json'), JSON.stringify(packet, null, 2));
 175:   return { ...summary, packetSha256: sha256Text(JSON.stringify(packet)) };
 176: }
 177: 
 178: // Opens the graph only through loadRetina. eyesFrom is injectable so tests can supply synthetic Eyes.
 179: export async function prepare(configPath, { eyesFrom = graphPath => createEyesV2(loadRetina(graphPath)) } = {}) {
 180:   const configText = readFileSync(configPath, 'utf8');
 181:   const config = validateConfig(JSON.parse(configText));
 182:   const paths = Object.fromEntries(Object.entries(config.paths).map(([k, v]) => [k, resolve(v)]));
 183:   mkdirSync(paths.run, { recursive: true });
 184:   const manifestPath = join(paths.run, 'manifest.json');
 185:   const manifest = { status: 'running', pid: process.pid, argv: process.argv, startedAt: new Date().toISOString(),
 186:     volume: 2, chapter: 3, purpose: config.purpose, configSha256: sha256Text(configText), pins: config.pins, paths, cpuDuty: 1 };
 187:   writeAtomic(manifestPath, JSON.stringify(manifest, null, 2));
 188:   const records = join(paths.run, 'records.jsonl');
 189:   writeFileSync(records, '');
 190:   const note = entry => appendFileSync(records, `${JSON.stringify(entry)}\n`);
 191:   try {
 192:     const summary = await run(config, paths, eyesFrom(paths.graph), note);
 193:     writeAtomic(join(paths.run, 'summary.json'), JSON.stringify(summary, null, 2));
 194:     writeAtomic(manifestPath, JSON.stringify({ ...manifest, status: summary.status === 'complete' ? 'complete' : 'failed',
 195:       endedAt: new Date().toISOString(), reason: summary.status === 'complete' ? null : `shortfall: ${summary.shortfall.join(',')}` }, null, 2));
 196:     return summary;
 197:   } catch (error) {
 198:     writeAtomic(manifestPath, JSON.stringify({ ...manifest, status: 'failed', endedAt: new Date().toISOString(), error: error.message }, null, 2));
 199:     throw error;
 200:   }
 201: }
 202: 
 203: if (process.argv[1] && pathToFileURL(resolve(process.argv[1])).href === import.meta.url) {
 204:   prepare(parseArgs(process.argv.slice(2)).config).then(summary => {
 205:     console.log(JSON.stringify({ status: summary.status, counts: summary.counts, exclusions: summary.exclusions }));
 206:     if (summary.status !== 'complete') process.exitCode = 1;
 207:   }, error => {
 208:     console.error(error.message);
 209:     process.exitCode = 1;
 210:   });
 211: }
--- .codebase/scripts/data/generate-bucket-positions-v1.mjs
   1: // CLI: capture-choice positions from one restart bucket's PGN, with the same unchanged positionsFromGame settings as
   2: // generate-capture-choice-positions.mjs (which stays train-only because v8 pins it). Brain-free; fresh output folder only.
   3: // Usage: node generate-bucket-positions-v1.mjs --games PGN --bucket train|development --out DIR
   4: import assert from 'node:assert/strict';
   5: import { createHash } from 'node:crypto';
   6: import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
   7: import { join } from 'node:path';
   8: import { parseArgs } from 'node:util';
   9: import { restartSplit } from '../../src/puzzle-learning/twin-pair-generator-v1.mjs';
  10: import { splitPgn, gameIdOf, positionsFromGame } from '../../src/puzzle-learning/capture-choice-positions-v1.mjs';
  11: 
  12: const { values: args } = parseArgs({ options: { games: { type: 'string' }, bucket: { type: 'string' }, out: { type: 'string' } } });
  13: assert(args.games && args.out && ['train', 'development'].includes(args.bucket), 'Need --games, --out and --bucket train|development');
  14: assert(!existsSync(args.out), 'Fresh output folder required');
  15: const sha256 = bytes => createHash('sha256').update(bytes).digest('hex');
  16: const bytes = readFileSync(args.games), settings = { minPly: 10, maxPerGame: 2, minGap: 10 };
  17: const lines = [], counts = { gamesRead: 0, gamesOtherBucket: 0, gamesWithPositions: 0, positions: 0 };
  18: for (const pgn of splitPgn(bytes.toString('utf8'))) {
  19:   counts.gamesRead++;
  20:   if (restartSplit(gameIdOf(pgn)) !== args.bucket) { counts.gamesOtherBucket++; continue; }
  21:   const found = positionsFromGame(pgn, settings);
  22:   if (found.length) counts.gamesWithPositions++;
  23:   for (const p of found) { counts.positions++; lines.push(JSON.stringify(p)); }
  24: }
  25: assert.equal(counts.gamesOtherBucket, 0, 'Input holds games from another bucket');
  26: mkdirSync(args.out, { recursive: true });
  27: writeFileSync(join(args.out, 'positions.jsonl'), lines.map(l => `${l}\n`).join(''));
  28: writeFileSync(join(args.out, 'manifest.json'), `${JSON.stringify({ schema: 'capture-choice-positions-v1', bucket: args.bucket, ...counts,
  29:   settings, inputSha256: sha256(bytes), positionsSha256: sha256(readFileSync(join(args.out, 'positions.jsonl'))),
  30:   generatorSha256: sha256(readFileSync(new URL('../../src/puzzle-learning/capture-choice-positions-v1.mjs', import.meta.url))) }, null, 2)}\n`);
  31: console.log(JSON.stringify(counts));
--- runs/fly-connections-memory-2026-11-08/inputs/make_packet_configs.py
   1: # Builds the combined position/PGN inputs and the two packet configs for fly connections memory v1.
   2: # Group assignment is outcome-blind: games sorted by sha256("fly-connections-v1-group:"+id); practice pool -> R (first 12), then A/B alternating;
   3: # test pool -> testA/testB alternating. Run from the repo root.
   4: import hashlib, json
   5: from pathlib import Path
   6: def sha(p): return hashlib.sha256(Path(p).read_bytes()).hexdigest()
   7: def key(g): return hashlib.sha256(f'fly-connections-v1-group:{g}'.encode()).hexdigest()
   8: def games(pos): 
   9:     seen = []
  10:     for line in Path(pos).read_text(encoding='utf-8').splitlines():
  11:         if line.strip():
  12:             g = json.loads(line)['gameId']
  13:             if g not in seen: seen.append(g)
  14:     return seen
  15: def assign(practice, test):
  16:     p, t = sorted(practice, key=key), sorted(test, key=key)
  17:     return {'R': p[:12], 'A': p[12::2], 'B': p[13::2], 'testA': t[0::2], 'testB': t[1::2]}
  18: def combine(name, parts):
  19:     out = Path('runs/fly-connections-memory-2026-11-08/inputs')
  20:     pos = out / f'{name}-positions.jsonl'; pgn = out / f'{name}-games.pgn'
  21:     pos.write_bytes(b''.join(Path(a).read_bytes() for a, _ in parts))
  22:     pgn.write_bytes(b'\n'.join(Path(b).read_bytes().rstrip(b'\n') + b'\n' for _, b in parts))
  23:     return pos.as_posix(), pgn.as_posix()
  24: graph = '.cache/full.npz'
  25: P = {
  26:  '1-300': ('runs/restart-data-2026-11-03/capture-choice-positions-v1/positions.jsonl', 'runs/restart-data-2026-11-03/games-train/games.pgn'),
  27:  '301-600': ('runs/restart-data-2026-11-05/capture-choice-positions-301-600-v1/positions.jsonl', 'runs/restart-data-2026-11-05/games-train-301-600/games.pgn'),
  28:  '601-900': ('runs/restart-data-2026-11-05/capture-choice-positions-601-900-v1/positions.jsonl', 'runs/restart-data-2026-11-05/games-train-601-900/games.pgn'),
  29:  '901-1200': ('runs/restart-data-2026-11-06/capture-choice-positions-901-1200-v1/positions.jsonl', 'runs/restart-data-2026-11-06/games-train-901-1200/games.pgn'),
  30:  'dev': ('runs/restart-data-2026-11-08/capture-choice-positions-development-1-300-v1/positions.jsonl', 'runs/restart-data-2026-11-08/games-development-1-300/games.pgn'),
  31: }
  32: for name, purpose, practice, test, counts, seeds, excl in [
  33:   ('dryrun', 'development', '601-900', '301-600', {'A': 8, 'B': 8, 'R': 2, 'testA': 10, 'testB': 10}, [7300], []),
  34:   ('full', 'confirmation', '901-1200', 'dev', {'A': 32, 'B': 32, 'R': 4, 'testA': 60, 'testB': 60}, [7301, 7302, 7303], ['1-300', '301-600', '601-900']),
  35: ]:
  36:     pos, pgn = combine(name, [P[practice], P[test]])
  37:     cfg = {'purpose': purpose, 'sealed': purpose == 'confirmation',
  38:            'paths': {'run': f'runs/fly-connections-memory-2026-11-08/packet-{name}', 'positions': pos, 'pgn': pgn, 'graph': graph},
  39:            'pins': {'positions': sha(pos), 'pgn': sha(pgn), 'graph': sha(graph)},
  40:            'groupGameIds': assign(games(P[practice][0]), games(P[test][0])), 'desiredCounts': counts,
  41:            'exclusions': {'gameIds': [], 'boardIds': [], 'sources': [{'path': P[e][0], 'sha256': sha(P[e][0])} for e in excl]},
  42:            'seeds': seeds}
  43:     Path(f'runs/fly-connections-memory-2026-11-08/inputs/packet-{name}-config.json').write_text(json.dumps(cfg, indent=1), encoding='utf-8')
  44:     print(name, {g: len(v) for g, v in cfg['groupGameIds'].items()})

