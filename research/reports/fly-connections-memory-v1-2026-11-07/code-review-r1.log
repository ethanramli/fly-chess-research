   8: export async function mapReversalMemory(graph, rootIds, annotationPath, onSegment = async () => {}) {
   9:   if (!(rootIds instanceof BigInt64Array) || rootIds.length !== graph.row.length - 1) throw Error('Invalid root identities');
  10:   const indices = new Map(Array.from(rootIds, (id, i) => [id.toString(), i]));
  11:   if (indices.size !== rootIds.length) throw Error('Duplicate roots');
  12:   const cells = new Map(); let header, lines = 0;
  13:   for await (const line of createInterface({ input: createReadStream(annotationPath), crlfDelay: Infinity })) {
  14:     const fields = line.split('\t');
  15:     if (!header) {
  16:       header = fields;
  17:       for (const key of ['root_id', 'hemibrain_type', 'cell_class', 'side']) if (!header.includes(key)) throw Error(`Missing ${key}`);
  18:       continue;
  19:     }
  20:     const get = key => fields[header.indexOf(key)] ?? '';
  21:     const index = indices.get(get('root_id')), type = get('hemibrain_type'), side = get('side');
  22:     if (index !== undefined && ['left', 'right'].includes(side) &&
  23:       (get('cell_class') === 'Kenyon_Cell' || ['MBON12', 'MBON01', 'PPL103', 'PAM02'].includes(type))) {
  24:       if (cells.has(index)) throw Error('Duplicate annotation root');
  25:       cells.set(index, { index, rootId: get('root_id'), type, side, cellClass: get('cell_class') });
  26:     }
  27:     if (++lines % 10000 === 0) await onSegment();
  28:   }
  29:   const groups = [], excluded = { negativeSign: 0, unsupportedKCType: 0, unannotatedInputs: 0 };
  30:   for (const side of ['left', 'right']) for (const mbonType of ['MBON12', 'MBON01']) {
  31:     const danType = mbonType === 'MBON12' ? 'PPL103' : 'PAM02';
  32:     const dan = [...cells.values()].filter(c => c.type === danType && c.side === side);
  33:     const edges = [], kc = [], observedKCTypes = {};
  34:     for (const post of [...cells.values()].filter(c => c.type === mbonType)) {
  35:       for (let e = graph.row[post.index]; e < graph.row[post.index + 1]; e++) {
  36:         const pre = cells.get(graph.col[e]);
  37:         if (!pre) { excluded.unannotatedInputs++; continue; }
  38:         if (pre.cellClass !== 'Kenyon_Cell' || pre.side !== side) continue;
  39:         observedKCTypes[pre.type] = (observedKCTypes[pre.type] ?? 0) + 1;
  40:         // PAM02 occupies beta'2a, so gamma-KC inputs to MBON01 are excluded.
  41:         const eligible = /^KCa'b'-/.test(pre.type) || (mbonType === 'MBON12' && /^KCg-/.test(pre.type));
  42:         if (!eligible) { excluded.unsupportedKCType++; continue; }
  43:         if (graph.sign[e] !== 1) { excluded.negativeSign++; continue; }
  44:         edges.push(e); kc.push(pre.index);
  45:       }
  46:     }
  47:     groups.push({ side, mbonType, danType, dan, edges, kc, observedKCTypes });
  48:   }
  49:   const allEdges = groups.flatMap(g => g.edges);
  50:   if (new Set(allEdges).size !== allEdges.length) throw Error('Overlapping plastic groups');
  51:   return { schema: 'reversal-coarse-mapping-v1', groups, excluded,
  52:     readyForCandidateExperiment: groups.every(g => g.dan.length > 0 && g.edges.length > 0),
  53:     approximation: 'Existing positive KC-to-MBON edges filtered by KC subtype/hemisphere; no synapse-coordinate compartment or receptor identity. Same-side DAN population modulates qualifying KC axon inputs; MBON soma side is not used as a compartment mask.' };
  54: }
  55: 
  56: export class ReversalMemory {
  57:   constructor(model, mapping, { eta = 0.5, minGain = 0.2, maxGain = 1.8, activityScale = 1.5 } = {}) {
  58:     if (![eta, minGain, maxGain, activityScale].every(Number.isFinite) || eta <= 0 || minGain <= 0 || minGain >= 1 || maxGain <= 1 || activityScale <= 0) throw Error('Invalid candidate configuration');
  59:     this.model = model; this.mapping = mapping;
  60:     if (mapping.readyForCandidateExperiment === false) throw Error('Incomplete mapped candidate; no learning enabled');
  61:     this.config = { eta, minGain, maxGain, activityScale };
  62:     this.edges = mapping.groups.flatMap(g => g.edges);
  63:     if (!this.edges.length || new Set(this.edges).size !== this.edges.length) throw Error('Invalid candidate edge mask');
  64:     for (const g of mapping.groups) {
  65:       if (!g.dan.length || g.edges.length !== g.kc.length) throw Error('Invalid local group');
  66:       for (let i = 0; i < g.edges.length; i++) {
  67:         const e = g.edges[i];
  68:         if (!Number.isSafeInteger(e) || e < 0 || e >= model.graph.col.length || model.graph.sign[e] !== 1 || model.graph.col[e] !== g.kc[i]) throw Error('Invalid existing plastic edge');
  69:       }
  70:       if (g.dan.some(c => !Number.isSafeInteger(c.index) || c.index < 0 || c.index >= model.n)) throw Error('Invalid DAN mapping');
  71:     }
  72:     this.base = Float32Array.from(this.edges, e => model.params.magnitude[e]);
  73:     if (!this.base.every(v => Number.isFinite(v) && v > 0)) throw Error('Invalid base efficacy');
  74:     this.gains = new Float64Array(this.edges.length).fill(1);
  75:     this.events = 0;
  76:     this.identity = digest({ mapping, config: this.config, model: model.config, base: [...this.base] });
  77:   }
  78:   observe(rest, dt = 1) {
  79:     const h = this.model.h[this.model.steps], { eta, minGain, maxGain, activityScale } = this.config;
  80:     if (rest.length !== this.model.n || !Number.isFinite(dt) || dt <= 0 || dt > 1) throw Error('Invalid observation interval');
  81:     // Validate the complete local observation before any state mutation.
  82:     for (const g of this.mapping.groups) for (const i of [...g.kc, ...g.dan.map(c => c.index)]) if (!Number.isFinite(h[i]) || !Number.isFinite(rest[i])) throw Error('Nonfinite local activity');
  83:     const factors = this.mapping.groups.map(g => -g.dan.reduce((sum, c) => sum + Math.max(0, h[c.index] - rest[c.index]) / activityScale, 0) / g.dan.length);
  84:     if (factors.some(D => eta * dt * -D > 1)) throw Error('Unstable candidate Euler step; no state changed');
  85:     let offset = 0, changed = 0;
  86:     for (let group = 0; group < this.mapping.groups.length; group++) {
  87:       const g = this.mapping.groups[group], D = factors[group];
  88:       for (let i = 0; i < g.edges.length; i++, offset++) {
  89:         const k = Math.max(0, h[g.kc[i]] - rest[g.kc[i]]) / activityScale;
  90:         const before = this.gains[offset];
  91:         const after = Math.max(minGain, Math.min(maxGain, before + eta * dt * D * (k + before - 1)));
  92:         if (!Number.isFinite(after)) throw Error('Nonfinite efficacy');
  93:         this.gains[offset] = after; if (after !== before) changed++;
  94:       }
  95:     }
  96:     this.events++; this.apply();
  97:     return { factors, changedEdges: changed, events: this.events,
  98:       scope: 'Source-derived computational comparison; measured excess DAN rates with fixed negative modulatory polarity, not negative reward or reconstructed dopamine release' };
  99:   }
 100:   apply() { for (let i = 0; i < this.edges.length; i++) this.model.setMagnitude(this.edges[i], this.base[i] * this.gains[i]); }
 101:   snapshot() { return { version: 1, identity: this.identity, events: this.events, gains: [...this.gains] }; }
 102:   restore(s) {
 103:     if (s.version !== 1 || s.identity !== this.identity || !Number.isSafeInteger(s.events) || s.events < 0 || !Array.isArray(s.gains) || s.gains.length !== this.gains.length || !s.gains.every(v => Number.isFinite(v) && v >= this.config.minGain && v <= this.config.maxGain)) throw Error('Incompatible candidate state');
 104:     this.gains.set(s.gains); this.events = s.events; this.apply();
 105:   }
 106: }
