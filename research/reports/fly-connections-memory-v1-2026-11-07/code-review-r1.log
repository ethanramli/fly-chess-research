  38:   if (!outcomes || typeof outcomes !== 'object' || Array.isArray(outcomes)) throw Error('outcomes must be an object');
  39:   for (const key of Object.keys(outcomes)) if (!legalSet.has(key)) throw Error(`Unknown outcome key ${key}`);
  40:   for (const move of legal) {
  41:     if (!Object.hasOwn(outcomes, move)) throw Error(`Missing outcome for ${move}`);
  42:     if (typeof outcomes[move] !== 'boolean') throw Error(`Outcome for ${move} must be boolean`);
  43:   }
  44: 
  45:   const top = Math.max(...ranked.map(e => e.score));
  46:   const tolerance = TIE_ABS + TIE_REL * Math.max(...ranked.map(e => Math.abs(e.score)));
  47:   const topMoves = ranked.filter(e => Math.abs(top - e.score) <= tolerance).map(e => ({ move: e.move, score: e.score }));
  48:   const s = topMoves.filter(e => outcomes[e.move]).length;
  49:   const c = topMoves.length;
  50:   const successScores = ranked.filter(e => outcomes[e.move]).map(e => e.score);
  51:   const failureScores = ranked.filter(e => !outcomes[e.move]).map(e => e.score);
  52:   const margin = successScores.length > 0 && failureScores.length > 0
  53:     ? Math.max(...successScores) - Math.max(...failureScores)
  54:     : null;
  55:   return {
  56:     topMoves,
  57:     s,
  58:     c,
  59:     success: s / c,
  60:     margin,
  61:     tolerance,
  62:     counts: { legal: legal.length, successes: successScores.length, failures: failureScores.length },
  63:   };
  64: }
  65: 
  66: function checkRecords(name, records, ref) {
  67:   if (!Array.isArray(records) || records.length === 0) throw Error(`${name} must be a nonempty array`);
  68:   if (ref && records.length !== ref.length) throw Error(`${name} has ${records.length} records; reference has ${ref.length}`);
