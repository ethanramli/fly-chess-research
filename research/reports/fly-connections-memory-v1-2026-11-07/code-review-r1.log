  35: export const PROBE_GROUPS = Object.freeze({
  36:   T0: ['A', 'B', 'R', 'testA', 'testB'], 'A-8': ['A'], 'A-16': ['A'], 'A-end': ['A', 'R'], 'R1-end': ['A', 'B', 'R'],
  37:   'B-8': ['A', 'B'], 'B-16': ['A', 'B'], 'B-end': ['A', 'B', 'R', 'testA', 'testB'], 'R2-end': ['A', 'B', 'R', 'testA', 'testB'],
  38: });
  39: 
  40: const byText = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
  41: export const uciOf = m => m.from + m.to + (m.promotion ?? '');
  42: export const sha256Text = text => createHash('sha256').update(text).digest('hex');
  43: export async function sha256File(path) {
  44:   const hash = createHash('sha256');
  45:   for await (const chunk of createReadStream(path)) hash.update(chunk);
  46:   return hash.digest('hex');
  47: }
  48: // Deep equality on JSON-like values, leaves by Object.is (so -0 and 0 differ, NaN equals NaN).
  49: export function sameValue(a, b) {
  50:   if (Object.is(a, b)) return true;
  51:   if (a === null || b === null || typeof a !== 'object' || typeof b !== 'object') return false;
  52:   if (Array.isArray(a) !== Array.isArray(b)) return false;
  53:   const ka = Object.keys(a), kb = Object.keys(b);
  54:   if (ka.length !== kb.length) return false;
  55:   return ka.every(k => Object.prototype.hasOwnProperty.call(b, k) && sameValue(a[k], b[k]));
  56: }
  57: const boardKey = fen => fen.split(' ').slice(0, 4).join(' ');
  58: 
  59: // Legal moves of a board, from its replayed history (own generator call, sorted UCI, every legal move once).
  60: export function legalOf(record) {
  61:   return replayPacketBoard(record).moves({ verbose: true }).map(uciOf).sort(byText);
  62: }
  63: // Outcome map used for a phase: chess records have one map; R records have R1 (target 0) and R2 (target 1) maps.
  64: export function outcomeSetOf(record, phase) {
  65:   if (record.group !== 'R') return record.outcomes;
  66:   if (phase !== 'R1' && phase !== 'R2') throw Error(`R outcomes need phase R1 or R2, got ${phase}`);
  67:   const set = record.outcomes?.[phase];
  68:   if (!set) throw Error(`${record.boardId} has no ${phase} outcomes`);
  69:   return set;
  70: }
  71: 
  72: // Own s, c, success, margin and tie tolerance from the scores. Tie rule: abs(top - score) <= 1e-9 + 1e-7 * max(abs(scores)).
  73: export function metricsOf(ranked, outcomes) {
  74:   const scores = ranked.map(e => e.score);
  75:   const top = Math.max(...scores);
  76:   const tolerance = TIE_ABS + TIE_REL * Math.max(...scores.map(x => Math.abs(x)));
  77:   const tops = ranked.filter(e => Math.abs(top - e.score) <= tolerance);
  78:   const ok = e => outcomes[e.move] === true;
  79:   const s = tops.filter(ok).length;
  80:   const c = tops.length;
  81:   const okScores = ranked.filter(ok).map(e => e.score);
  82:   const badScores = ranked.filter(e => !ok(e)).map(e => e.score);
  83:   const margin = okScores.length && badScores.length ? Math.max(...okScores) - Math.max(...badScores) : null;
  84:   return { s, c, success: s / c, margin, tolerance, topMoves: tops.map(e => e.move) };
  85: }
  86: 
  87: // Shape and stored-value problems of one ranking (empty array = clean).
  88: export function rankingProblems(ranking, record, legal, outcomes) {
  89:   if (!ranking || typeof ranking !== 'object') return ['ranking missing'];
  90:   const out = [];
  91:   if (ranking.boardId !== record.boardId || ranking.gameId !== record.gameId) out.push('boardId or gameId differs');
  92:   const ranked = ranking.ranked;
  93:   if (!Array.isArray(ranked)) return [...out, 'ranked is not a list'];
  94:   if (ranked.length !== legal.length) out.push(`${ranked.length} scored moves for ${legal.length} legal moves`);
  95:   else {
  96:     const at = ranked.findIndex((e, i) => e?.move !== legal[i]);
  97:     if (at >= 0) out.push(`entry ${at} is ${ranked[at]?.move}, expected ${legal[at]} (sorted UCI, each legal move once)`);
  98:   }
  99:   if (ranked.some(e => !Number.isFinite(e?.score))) out.push('a score is not finite');
 100:   if (ranked.some(e => !Array.isArray(e?.mbon) || e.mbon.length !== 2 || !e.mbon.every(x => Number.isFinite(x)))) out.push('an mbon pair is not two finite rates');
 101:   if (ranking.passes !== legal.length) out.push(`passes ${ranking.passes}, expected ${legal.length}`);
 102:   if (out.length) return out;
 103:   const mine = metricsOf(ranked, outcomes);
 104:   for (const k of ['s', 'c', 'success', 'margin', 'tolerance']) {
 105:     if (!Object.is(ranking[k], mine[k])) out.push(`${k} stored ${ranking[k]}, recomputed ${mine[k]}`);
 106:   }
 107:   const tops = Array.isArray(ranking.topMoves) ? ranking.topMoves.map(t => t?.move) : null;
 108:   if (!sameValue(tops, mine.topMoves)) out.push('topMoves differ from the recomputed top set');
 109:   let best = ranked[0];
 110:   for (const e of ranked) if (e.score > best.score) best = e;
 111:   if (ranking.choice !== best.move) out.push(`choice ${ranking.choice}, recomputed ${best.move}`);
 112:   return out;
 113: }
 114: 
 115: // Expected line sequence of one job: T0 probe, then each event followed by the probes due at that cursor (tape order).
 116: export function expectedItems(tape, byGroup) {
 117:   const rank = (label, cursor) => {
 118:     const groups = PROBE_GROUPS[label];
 119:     if (!groups) throw Error(`unknown probe label ${label}`);
 120:     const out = [];
 121:     for (const g of GROUPS) {
 122:       if (!groups.includes(g)) continue;
 123:       const list = [...byGroup[g]].sort((a, b) => byText(a.boardId, b.boardId));
 124:       for (const r of list) out.push({ kind: 'ranking', label, cursor, group: g, boardId: r.boardId, last: false, text: `ranking ${label} ${r.boardId}` });
 125:     }
 126:     if (out.length) out[out.length - 1].last = true;
 127:     return out;
 128:   };
 129:   const items = rank(tape.initialProbe.phase, 0);
 130:   for (const p of tape.probeAfter) {
 131:     if (!Number.isSafeInteger(p.cursor) || p.cursor < 1 || p.cursor > tape.events.length) throw Error(`probe ${p.phase} at cursor ${p.cursor} is outside the tape`);
 132:   }
 133:   for (let i = 0; i < tape.events.length; i++) {
 134:     items.push({ kind: 'event', sequence: i, text: `event ${i}` });
 135:     for (const p of tape.probeAfter) if (p.cursor === i + 1) items.push(...rank(p.phase, p.cursor));
 136:   }
 137:   return items;
 138: }
 139: 
 140: class Problems {
 141:   constructor() {
 142:     this.counts = Object.fromEntries(CATEGORIES.map(c => [c, 0]));
 143:     this.lists = Object.fromEntries(CATEGORIES.map(c => [c, []]));
 144:   }
 145:   add(category, text) {
 146:     this.counts[category]++;
 147:     if (this.lists[category].length < LIST_CAP) this.lists[category].push(text);
 148:   }
 149: }
 150: const lineText = line => (line?.type === 'event' ? `event line ${line.cursor}` : `${line?.type} ${line?.label} ${line?.boardId} (cursor ${line?.cursor})`);
 151: 
 152: // One pass over a job's records.jsonl. Recomputes every event, update, fingerprint and ranking; keeps only the digest the gates need.
 153: class JobWalk {
 154:   constructor({ arm, tape, byGroup, boardsById, result, readSnapshot, legalCache, shared }) {
 155:     if (!ARM_TABLE[arm]) throw Error(`unknown arm ${arm}`);
 156:     this.arm = arm; this.rule = ARM_TABLE[arm]; this.tape = tape; this.boardsById = boardsById; this.result = result;
 157:     this.readSnapshot = readSnapshot; this.legalCache = legalCache; this.shared = shared;
 158:     this.groups = result.describe?.groups ?? [];
 159:     this.danTotal = this.groups.reduce((s, g) => s + g.danCount, 0);
 160:     this.items = expectedItems(tape, byGroup);
 161:     this.lastBIndex = tape.events.reduce((last, e, i) => (e.phase === 'B' ? i : last), -1);
 162:     this.P = new Problems();
 163:     this.pos = 0; this.lastFp = null; this.t0Fp = null; this.gains = null; this.n = 0;
 164:     this.learned = 0; this.eventsSeen = 0; this.passes = 0;
 165:     this.labels = new Map(); this.dSum = { pulse: [0, 0], none: [0, 0] };
 166:     this.base = new Map(); this.edgeOf = new Map(); this.offsetOf = new Map();
 167:     this.pressure = { written: new Set(), pressureEdges: new Set(), finalMagnitude: new Map() };
 168:   }
 169: 
 170:   async run(lines) {
 171:     for await (const line of lines) {
 172:       let consumed = false;
 173:       while (!consumed) {
 174:         if (this.pos >= this.items.length) {
 175:           this.P.add(line?.type === 'event' ? 'events' : 'rankings', `extra line after the last expected line: ${lineText(line)}`);
 176:           break;
 177:         }
 178:         const item = this.items[this.pos];
 179:         if (this.matches(line, item)) { await this.accept(line, item); this.pos++; consumed = true; }
 180:         else {
 181:           this.P.add(item.kind === 'event' ? 'events' : 'rankings', `expected ${item.text}, found ${lineText(line)}`);
 182:           this.pos++;
 183:         }
 184:       }
 185:     }
 186:     while (this.pos < this.items.length) {
 187:       const item = this.items[this.pos++];
 188:       this.P.add(item.kind === 'event' ? 'events' : 'rankings', `missing ${item.text}`);
 189:     }
 190:     if (this.eventsSeen !== this.tape.events.length) this.P.add('events', `${this.eventsSeen} event lines, tape has ${this.tape.events.length}`);
 191:     // Pass accounting belongs to the event lines: a missing line removes its passes as well as its sequence number.
 192:     if (this.passes !== this.result.passes) this.P.add('events', `result passes ${this.result.passes}, recounted from the lines ${this.passes}`);
 193:     return this.digest();
 194:   }
 195: 
 196:   digest() {
 197:     return { labels: this.labels, dSum: this.dSum, pressure: this.pressure, base: this.base, n: this.n, passes: this.passes,
 198:       counts: this.P.counts, lists: this.P.lists, learned: this.learned, eventsSeen: this.eventsSeen };
 199:   }
 200: 
 201:   matches(line, item) {
 202:     if (item.kind === 'event') return line.type === 'event' && line.cursor === item.sequence && line.receipt?.sequence === item.sequence;
 203:     if (line.label !== item.label || line.cursor !== item.cursor || line.boardId !== item.boardId || line.group !== item.group) return false;
 204:     if (line.type === 'ranking') return true;
 205:     // Off arm only: an intermediate probe may reuse the T0 ranking while the fingerprint equals T0 (file formats doc).
 206:     return line.type === 'ranking-reused' && this.arm === 'off-local' && item.label !== 'T0' && item.label !== 'R2-end';
 207:   }
 208: 
 209:   async accept(line, item) {
 210:     if (item.kind === 'event') return this.acceptEvent(line, item);
 211:     return this.acceptRanking(line, item);
 212:   }
 213: 
 214:   legal(record) {
 215:     if (!this.legalCache.has(record.boardId)) this.legalCache.set(record.boardId, legalOf(record));
 216:     return this.legalCache.get(record.boardId);
 217:   }
 218: 
 219:   setEntry(item, entry) {
 220:     if (!this.labels.has(item.label)) this.labels.set(item.label, new Map());
 221:     this.labels.get(item.label).set(item.boardId, entry);
 222:   }
 223: 
 224:   // Digest entry for one ranking: metrics on the phase's outcomes, plus the R2 (target 1) metrics for R boards.
 225:   rankingEntry(ranking, record, legal, phase) {
 226:     const outcomes = outcomeSetOf(record, phase);
 227:     const probs = rankingProblems(ranking, record, legal, outcomes);
 228:     for (const p of probs) this.P.add('rankings', `${record.boardId} ${phase}: ${p}`);
 229:     if (!Array.isArray(ranking?.ranked)) return null;
 230:     try {
 231:       const entry = { group: record.group, m0: metricsOf(ranking.ranked, outcomes) };
 232:       if (record.group === 'R') entry.m1 = metricsOf(ranking.ranked, outcomeSetOf(record, 'R2'));
 233:       return entry;
 234:     } catch (e) {
 235:       this.P.add('rankings', `${record.boardId} ${phase}: metrics unavailable (${e.message})`);
 236:       return null;
 237:     }
 238:   }
 239: 
 240:   async acceptRanking(line, item) {
 241:     const record = this.boardsById.get(item.boardId);
 242:     if (!record) throw Error(`no board ${item.boardId}`);
 243:     if (line.type === 'ranking-reused') {
 244:       if (line.from !== 'T0') this.P.add('rankings', `${item.text}: reused from ${line.from}, expected T0`);
 245:       if (line.fingerprint !== this.t0Fp || line.fingerprint !== this.lastFp) this.P.add('fingerprints', `${item.text}: reused ranking fingerprint is not the T0 state`);
 246:       const entry = this.labels.get('T0')?.get(item.boardId);
 247:       if (!entry) this.P.add('rankings', `${item.text}: no T0 ranking to reuse`);
 248:       else this.setEntry(item, entry);
 249:     } else {
 250:       if (this.t0Fp === null) { this.t0Fp = line.fingerprint; this.lastFp = line.fingerprint; }
 251:       if (line.fingerprint !== this.lastFp) this.P.add('fingerprints', `${item.text}: fingerprint differs from the state`);
 252:       const phase = record.group === 'R' ? 'R1' : 'chess';
 253:       if (line.phase !== phase) this.P.add('rankings', `${item.text}: phase ${line.phase}, expected ${phase}`);
 254:       const entry = this.rankingEntry(line.ranking, record, this.legal(record), phase);
 255:       if (entry) this.setEntry(item, entry);
 256:       if (Number.isFinite(line.ranking?.passes)) this.passes += line.ranking.passes;
 257:     }
 258:     if (item.last) await this.finishLabel(item.label);
 259:   }
 260: 
 261:   // Label end: the stored fingerprint and the snapshot must equal the recomputed state. T0 fixes the mask size.
 262:   async finishLabel(label) {
 263:     if (this.result.fingerprints?.[label] !== this.lastFp) this.P.add('fingerprints', `${label}: result fingerprint differs from the state`);
 264:     let snap;
 265:     try { snap = await this.readSnapshot(label); }
 266:     catch (e) { this.P.add('updates', `${label}: snapshot unreadable (${e.message})`); return; }
 267:     const gains = snap?.memory?.gains;
 268:     if (!Array.isArray(gains)) { this.P.add('updates', `${label}: snapshot has no gains`); return; }
 269:     if (label === 'T0') { this.n = gains.length; this.gains = new Float64Array(gains.length).fill(1); }
 270:     if (this.gains === null) { this.P.add('updates', `${label}: no T0 mask`); return; }
 271:     if (gains.length !== this.gains.length || gains.some((x, i) => !Object.is(x, this.gains[i]))) {
 272:       this.P.add('updates', `${label}: snapshot gains differ from the recomputed gains`);
 273:     }
 274:     if (snap.memory?.events !== this.learned) this.P.add('updates', `${label}: snapshot counts ${snap.memory?.events} updates, recomputed ${this.learned}`);
 275:   }
 276: 
 277:   async acceptEvent(line, item) {
 278:     const P = this.P, r = line.receipt, seq = item.sequence, ev = this.tape.events[seq];
 279:     const record = this.boardsById.get(ev.boardId);
 280:     if (!r || typeof r !== 'object' || !record) { P.add('events', `event ${seq}: receipt or record missing`); return; }
 281:     const delivered = this.rule.pulse === 'experience' ? ev.pulse : this.rule.pulse === 'absent' ? false : this.tape.shuffledPulses[seq];
 282:     const outcomes = outcomeSetOf(record, ev.phase);
 283:     const tests = [
 284:       ['schema', r.schema === RECEIPT_SCHEMA], ['arm', r.arm === this.arm], ['sequence', r.sequence === ev.sequence],
 285:       ['eventId', r.eventId === ev.eventId], ['phase', r.phase === ev.phase], ['boardId', r.boardId === ev.boardId],
 286:       ['gameId', r.gameId === record.gameId], ['move', r.move === ev.move], ['proofSha', r.proofSha === ev.proofSha],
 287:       ['criterion', r.criterion === record.criterion], ['pulse', r.pulse === ev.pulse],
 288:       ['outcome', r.outcome === outcomes[ev.move] && r.outcome === ev.pulse], ['deliveredPulse', r.deliveredPulse === delivered],
 289:       ['pulseCurrent', r.pulseCurrent === (delivered ? RULE.pulseCurrent : 0)],
 290:     ];
 291:     for (const [name, ok] of tests) if (ok !== true) P.add('events', `event ${seq}: ${name} differs from the tape or the sealed record`);
 292:     const cells = r.pulseCells;
 293:     if (!Array.isArray(cells) || cells.length !== this.danTotal) P.add('events', `event ${seq}: pulseCells has ${cells?.length} cells, describe has ${this.danTotal} DANs`);
 294:     else if (this.shared.pulseCells === null) this.shared.pulseCells = cells.slice();
 295:     else if (!sameValue(cells, this.shared.pulseCells)) P.add('events', `event ${seq}: pulseCells differ from the first event of the first job`);
 296:     const teach = r.teaching;
 297:     if (!Array.isArray(teach) || teach.length !== this.groups.length) P.add('events', `event ${seq}: teaching has ${teach?.length} groups`);
 298:     else {
 299:       teach.forEach((g, gi) => {
 300:         const want = this.groups[gi];
 301:         if (g?.side !== want.side || !Array.isArray(g.dan) || g.dan.length !== want.danCount || !Array.isArray(g.kc) || g.kc.length !== want.kcCount) {
 302:           P.add('events', `event ${seq}: teaching group ${gi} differs from describe`);
 303:         }
 304:       });
 305:     }
 306:     for (const p of rankingProblems(r.unaided, record, this.legal(record), outcomes)) P.add('rankings', `event ${seq} unaided: ${p}`);
 307:     if (!r.unaided || r.passes !== r.unaided.passes + 1) P.add('events', `event ${seq}: passes is not unaided passes + 1`);
 308:     if (Number.isFinite(r.passes)) this.passes += r.passes;
 309:     if (!Object.is(r.fingerprintBefore, this.lastFp)) P.add('fingerprints', `event ${seq}: fingerprintBefore differs from the previous state`);
 310:     if (this.rule.learns) this.learn(r, ev, seq);
 311:     else this.holdOff(r, seq);
 312:     this.lastFp = r.fingerprintAfter;
 313:     this.eventsSeen++;
 314:   }
 315: 
 316:   // Off arm: no update may happen and the fingerprint must stay at T0.
 317:   holdOff(r, seq) {
 318:     if (!r.update || r.update.observed !== false || r.update.events !== 0 || !Array.isArray(r.writes) || r.writes.length !== 0) {
 319:       this.P.add('updates', `off arm event ${seq} changed memory`);
 320:     }
 321:     if (!Object.is(r.fingerprintAfter, this.t0Fp)) this.P.add('fingerprints', `off arm event ${seq}: fingerprint differs from T0`);
 322:   }
 323: 
 324:   // Recomputes the Gkanias-style gain update from the receipt's actual rates, then checks every field and write against it.
 325:   learn(r, ev, seq) {
 326:     const groups = r.teaching;
 327:     if (this.gains === null) { this.P.add('updates', `event ${seq}: no T0 mask`); return; }
 328:     if (!Array.isArray(groups) || groups.length !== 2 || groups[0]?.side !== 'left' || groups[1]?.side !== 'right') {
 329:       this.P.add('updates', `event ${seq}: teaching groups are not left then right`);
 330:       return;
 331:     }
 332:     const changed = [], factors = [];
 333:     let offset = 0;
 334:     for (const g of groups) {
 335:       const { dan, kc, k } = g;
 336:       if (!Array.isArray(dan) || !Array.isArray(kc) || !Array.isArray(k) || dan.length === 0) { this.P.add('updates', `event ${seq} ${g.side}: rates missing`); return; }
 337:       const D = -dan.reduce((sum, v) => sum + Math.max(0, v) / RULE.activityScale, 0) / dan.length;
 338:       factors.push(D);
 339:       if (!Object.is(g.factor, D)) this.P.add('updates', `event ${seq} ${g.side}: factor ${g.factor}, recomputed ${D}`);
 340:       if (RULE.eta * RULE.dt * -D > 1) this.P.add('updates', `event ${seq} ${g.side}: Euler bound exceeded`);
 341:       kc.forEach((rate, i) => {
 342:         const kk = Math.max(0, rate) / RULE.activityScale;
 343:         if (!Object.is(k[i], kk)) this.P.add('updates', `event ${seq} ${g.side} edge ${i}: k ${k[i]}, recomputed ${kk}`);
 344:         const o = offset++;
 345:         if (o >= this.gains.length) return; // the size check below reports it
 346:         const before = this.gains[o];
 347:         const after = Math.max(RULE.minGain, Math.min(RULE.maxGain, before + RULE.eta * RULE.dt * D * (kk + before - 1)));
 348:         if (after !== before) changed.push({ offset: o, before, after });
 349:         this.gains[o] = after;
 350:       });
 351:     }
 352:     if (offset !== this.gains.length) this.P.add('updates', `event ${seq}: ${offset} teaching edges, mask has ${this.gains.length}`);
 353:     this.learned++;
 354:     const u = r.update;
 355:     if (!u || u.observed !== true || u.changedEdges !== changed.length || u.events !== this.learned || !sameValue(u.factors, factors)) {
 356:       this.P.add('updates', `event ${seq}: update fields differ from the recomputed update`);
 357:     }
 358:     const writes = Array.isArray(r.writes) ? r.writes : [];
 359:     if (writes.length !== changed.length) this.P.add('updates', `event ${seq}: ${writes.length} writes, ${changed.length} edges changed by the recomputed update`);
 360:     for (let j = 0; j < Math.min(writes.length, changed.length); j++) this.checkWrite(writes[j], changed[j], ev.phase, seq);
 361:     if (ev.phase === 'A' || ev.phase === 'B') {
 362:       const bucket = r.deliveredPulse === true ? this.dSum.pulse : this.dSum.none;
 363:       bucket[0] += (factors[0] + factors[1]) / 2;
 364:       bucket[1] += 1;
 365:     }
 366:   }
 367: 
 368:   // One receipt write against the recomputed change. Magnitudes must be base x gain in Float32 (the model stores magnitudes as Float32).
 369:   checkWrite(w, c, phase, seq) {
 370:     if (!w || typeof w !== 'object') { this.P.add('updates', `event ${seq}: write missing`); return; }
 371:     const at = `event ${seq} write of edge ${w.edgeId}`;
 372:     if (w.gainChanged !== true) this.P.add('updates', `${at}: gainChanged is not true`);
 373:     if (!Object.is(w.beforeGain, c.before) || !Object.is(w.afterGain, c.after)) {
 374:       this.P.add('updates', `${at}: gain ${w.beforeGain} -> ${w.afterGain}, recomputed ${c.before} -> ${c.after}`);
 375:     }
 376:     if (!Number.isSafeInteger(w.edgeId)) this.P.add('updates', `${at}: edgeId is not an integer`);
 377:     else {
 378:       const known = this.edgeOf.get(c.offset);
 379:       if (known === undefined) {
 380:         if (this.offsetOf.has(w.edgeId)) this.P.add('updates', `${at}: edge already written at another mask offset`);
 381:         else { this.edgeOf.set(c.offset, w.edgeId); this.offsetOf.set(w.edgeId, c.offset); }
 382:       } else if (known !== w.edgeId) this.P.add('updates', `${at}: mask offset ${c.offset} held edge ${known} earlier`);
 383:     }
 384:     let b = this.base.get(w.edgeId);
 385:     if (b === undefined) {
 386:       if (c.before !== 1) this.P.add('mask', `${at}: first write does not start from gain 1`);
 387:       b = w.beforeMagnitude;
 388:       this.base.set(w.edgeId, b);
 389:     }
 390:     if (!Object.is(w.beforeMagnitude, Math.fround(b * c.before))) this.P.add('mask', `${at}: beforeMagnitude is not base x gain`);
 391:     if (!Object.is(w.afterMagnitude, Math.fround(b * c.after))) this.P.add('mask', `${at}: afterMagnitude is not base x gain`);
 392:     const effective = w.beforeMagnitude !== w.afterMagnitude;
 393:     if (w.effectiveChanged !== effective) this.P.add('mask', `${at}: effectiveChanged differs`);
 394:     const rel = Math.abs(w.afterMagnitude - w.beforeMagnitude) / b;
 395:     if (!Object.is(w.relativeEffectiveChange, rel)) this.P.add('mask', `${at}: relativeEffectiveChange differs`);
 396:     const pressureWrite = effective && rel >= GATE.pressure;
 397:     if (w.pressureWrite !== pressureWrite) this.P.add('mask', `${at}: pressureWrite differs`);
 398:     if (effective && phase === 'A') this.pressure.written.add(w.edgeId);
 399:     if (pressureWrite && phase === 'B') this.pressure.pressureEdges.add(w.edgeId);
 400:     if (seq <= this.lastBIndex) this.pressure.finalMagnitude.set(w.edgeId, w.afterMagnitude);
 401:   }
 402: }
 403: 
 404: // ---- Gate arithmetic (auditor's own) -------------------------------------------------------------------------
 405: 
 406: // Gate P2.1 (judgeRetention rule): acquisition, retention ratio against the learned margin, group ratio, and B acquisition.
 407: export function retentionGate({ a0, aAfterA, aAfterB, aFinal, bBefore, bAfter, bFinal, minAcquired,
 408:   retention = GATE.retention, epsilon = GATE.epsilon, success = GATE.success }) {
 409:   const need = (x, what) => { if (!Number.isFinite(x)) throw Error(`${what} is not a finite margin`); return x; };
 410:   const acquired = (t, base) => {
 411:     need(t.margin, 'post margin'); need(base.margin, 'base margin');
 412:     return t.success >= success && t.margin > t.tolerance && t.margin - base.margin > epsilon;
 413:   };
 414:   const a = a0.map((naive, i) => {
 415:     const t = aAfterA[i], m = aAfterB[i], f = aFinal[i];
 416:     const learned = need(t.margin, 'A-end margin') - need(naive.margin, 'T0 margin');
 417:     const acq = acquired(t, naive);
 418:     const dB = need(m.margin, 'B-end margin') - naive.margin;
 419:     const dF = need(f.margin, 'R2-end margin') - naive.margin;
 420:     const rB = learned > epsilon ? dB / learned : null;
 421:     const rF = learned > epsilon ? dF / learned : null;
 422:     const retained = acq && m.success >= success && f.success >= success && rB !== null && rF !== null && rB >= retention && rF >= retention;
 423:     return { id: naive.boardId, acq, retained, learned, dB, dF };
 424:   });
 425:   const learnedSum = a.reduce((s, x) => s + x.learned, 0);
 426:   const groupB = learnedSum > 0 ? a.reduce((s, x) => s + x.dB, 0) / learnedSum : null;
 427:   const groupF = learnedSum > 0 ? a.reduce((s, x) => s + x.dF, 0) / learnedSum : null;
 428:   const groupPass = learnedSum > 0 && groupB >= retention && groupF >= retention;
 429:   const aAcq = a.filter(x => x.acq).length;
 430:   const aLost = a.filter(x => x.acq && !x.retained).map(x => x.id);
 431:   const aPass = aAcq >= minAcquired && aLost.length === 0 && groupPass;
 432: 
 433:   const b = bBefore.map((before, i) => {
 434:     const t = bAfter[i], f = bFinal[i];
 435:     const acq = acquired(t, before);
 436:     return { id: before.boardId, acq, retained: acq && f.success >= success };
 437:   });
 438:   const bAcq = b.filter(x => x.acq).length;
 439:   const bLost = b.filter(x => x.acq && !x.retained).map(x => x.id);
 440:   const bPass = bAcq >= minAcquired && bLost.length === 0;
 441:   const fmt = x => (x === null ? 'n/a' : x.toFixed(3));
 442:   return { pass: aPass && bPass,
 443:     detail: `A acquired ${aAcq} (min ${minAcquired}), lost [${aLost.join(' ')}], group ratio ${fmt(groupB)} / ${fmt(groupF)}; `
 444:       + `B acquired ${bAcq} (min ${minAcquired}), lost [${bLost.join(' ')}]` };
 445: }
 446: 
 447: // Gate P2.3 (summarizePressure rule): B pressure on A-written edges, and the mask moved by at least 1% by T_AB. Integer form of the 25% shares.
 448: export function pressureGate({ written, pressureEdges, base, finalMagnitude, maskSize }) {
 449:   if (written.size === 0) return { pass: false, detail: 'no A-written edges: P2 untested' };
 450:   const shared = [...written].filter(e => pressureEdges.has(e)).length;
 451:   let meaningful = 0;
 452:   for (const [e, b] of base) {
 453:     const f = finalMagnitude.get(e) ?? b;
 454:     if (Math.abs(f - b) / b >= GATE.pressure) meaningful++;
 455:   }
 456:   const sharePass = shared * 4 >= written.size;
 457:   const maskPass = meaningful * 4 >= maskSize;
 458:   return { pass: sharePass && maskPass,
 459:     detail: `B pressure on ${shared}/${written.size} A-written edges (need 25%); ${meaningful}/${maskSize} mask edges moved by at least 1% (need 25%)` };
 460: }
 461: 
 462: // Paired bootstrap through the shared numericPairGate; passes when every comparator's lower bound is above 0.
 463: function pairGate(arms, games, primary, comparators, seed) {
 464:   const r = numericPairGate({ arms, games, primary, comparators, minCorrect: 0, minMargin: 0,
 465:     resamples: GATE.resamples, seed, lowerQuantile: GATE.lowerQuantile });
 466:   const lows = comparators.map(c => [c, r.comparators[c].lower]);
 467:   return { pass: lows.every(([, lo]) => lo > 0), detail: `${primary} vs ${lows.map(([c, lo]) => `${c} lower ${lo.toFixed(4)}`).join(', ')}` };
 468: }
 469: 
 470: // Gate P1.4 (static part only): no import in the scoring path may name an engineered store, episodic memory, ledger or nearest-neighbour module.
 471: export function staticImportCheck(sourceTexts) {
 472:   const forbidden = /kc-episodic|engineered|memory-v\d|memory-assay|episodic|ledger|nearest/i;
 473:   const found = [];
 474:   for (const [name, text] of Object.entries(sourceTexts)) {
 475:     for (const m of text.matchAll(/^\s*import\s[^'"]*['"]([^'"]+)['"]/gm)) if (forbidden.test(m[1])) found.push(`${name} imports ${m[1]}`);
 476:   }
 477:   const count = Object.keys(sourceTexts).length;
 478:   const pass = count > 0 && found.length === 0;
 479:   return { pass, detail: pass ? `${count} scoring-path sources: no engineered, episodic or ledger import (static import check only; code review still required)`
 480:     : (found.join('; ') || 'no sources supplied') };
 481: }
 482: 
 483: // Registration gate constants must equal the gates file; minAcquired is run-specific (24 full, 6 dry).
 484: export function gatesMatch(gates) {
 485:   const want = { success: GATE.success, retention: GATE.retention, epsilon: GATE.epsilon, pressure: GATE.pressure,
 486:     pressureShare: GATE.pressureShare, bootstrapSeed: GATE.bootstrapSeed };
 487:   const bad = Object.entries(want).filter(([k, v]) => gates?.[k] !== v).map(([k]) => k);
 488:   if (!Number.isSafeInteger(gates?.minAcquired) || gates.minAcquired < 1) bad.push('minAcquired');
 489:   return { pass: bad.length === 0, detail: bad.length ? `registration gates differ from the gates file: ${bad.join(', ')}` : 'registration gate constants equal the gates file' };
 490: }
 491: 
 492: // ---- Per-seed gate verdicts -------------------------------------------------------------------------------
 493: 
 494: // Section 4 gates for every seed, recomputed from the walked jobs. Judge-shaped output: { perSeed, pass, verdict }.
 495: export function gateVerdicts({ seeds, jobs, boardsById, byGroup, fairBySeed, registration, sourceP14 }) {
 496:   const minAcquired = registration.gates?.minAcquired;
 497:   const sorted = ids => [...ids].sort(byText);
 498:   const idsOf = groups => sorted(groups.flatMap(g => byGroup[g].map(r => r.boardId)));
 499:   const A = idsOf(['A']), B = idsOf(['B']), R = idsOf(['R']), TEST = idsOf(['testA', 'testB']), AB = sorted([...A, ...B]);
 500:   const game = id => boardsById.get(id).gameId;
 501:   const perSeed = seeds.map(seed => {
 502:     const digestOf = arm => {
 503:       const j = jobs.get(`${seed}-${arm}`);
 504:       if (!j?.digest) throw Error(`no walked job ${seed}-${arm}`);
 505:       return j.digest;
 506:     };
 507:     const I = digestOf('informative-local'), Ab = digestOf('absent-local'), O = digestOf('off-local'), S = digestOf('shuffled-local');
 508:     const at = (d, label, id) => {
 509:       const e = d.labels.get(label)?.get(id);
 510:       if (!e) throw Error(`no ${label} ranking for ${id}`);
 511:       return e;
 512:     };
 513:     const rows = (d, label, ids) => ids.map(id => ({ boardId: id, gameId: game(id), ...at(d, label, id).m0 }));
 514:     const gate = (name, fn) => {
 515:       try { return { name, ...fn() }; } catch (e) { return { name, pass: false, detail: `error: ${e.message}` }; }
 516:     };
 517:     const P1 = [
 518:       gate('P1.1', () => ({ pass: I.counts.fingerprints === 0 && I.counts.mask === 0,
 519:         detail: `fingerprint chain ${I.counts.fingerprints} problems; mask ${I.counts.mask} problems (replay adds the fixed-state check)` })),
 520:       gate('P1.2', () => ({ pass: I.counts.updates === 0, detail: `${I.counts.updates} update problems in ${I.learned} learning events` })),
 521:       gate('P1.3', () => {
 522:         const [ps, pn] = I.dSum.pulse, [ns, nn] = I.dSum.none;
 523:         if (!pn || !nn) return { pass: false, detail: 'pulse or no-pulse events missing' };
 524:         const diff = ps / pn - ns / nn;
 525:         return { pass: diff < -1e-6, detail: `mean D on pulse minus no-pulse events = ${diff.toExponential(3)} (need below -1e-6)` };
 526:       }),
 527:       gate('P1.4', () => sourceP14),
 528:     ];
 529:     const P2 = [
 530:       gate('P2.1', () => {
 531:         const r = retentionGate({
 532:           a0: rows(I, 'T0', A), aAfterA: rows(I, 'A-end', A), aAfterB: rows(I, 'B-end', A), aFinal: rows(I, 'R2-end', A),
 533:           bBefore: rows(I, 'R1-end', B), bAfter: rows(I, 'B-end', B), bFinal: rows(I, 'R2-end', B), minAcquired,
 534:         });
 535:         return { pass: r.pass, detail: r.detail };
 536:       }),
 537:       gate('P2.2', () => pairGate({ informative: AB.map(id => at(I, 'B-end', id).m0.success), absent: AB.map(id => at(Ab, 'B-end', id).m0.success),
 538:         off: AB.map(id => at(O, 'B-end', id).m0.success), shuffled: AB.map(id => at(S, 'B-end', id).m0.success) },
 539:       AB.map(game), 'informative', ['absent', 'off', 'shuffled'], GATE.bootstrapSeed)),
 540:       gate('P2.3', () => pressureGate({ written: I.pressure.written, pressureEdges: I.pressure.pressureEdges, base: I.base,
 541:         finalMagnitude: I.pressure.finalMagnitude, maskSize: I.n })),
 542:       gate('P2.4', () => {
 543:         if (R.length === 0) return { pass: false, detail: 'no R boards' };
 544:         const bad = [];
 545:         for (const id of R) {
 546:           const t0 = boardsById.get(id).rTargets[0];
 547:           const a = at(I, 'A-end', id).m0, r1 = at(I, 'R1-end', id).m0, b = at(I, 'B-end', id).m0, r2 = at(I, 'R2-end', id).m1;
 548:           const p1 = Number.isFinite(a.margin) && Number.isFinite(r1.margin) && r1.success >= GATE.success && r1.margin > r1.tolerance && r1.margin - a.margin > GATE.epsilon;
 549:           const p2 = Number.isFinite(b.margin) && b.success >= GATE.success && b.margin > b.tolerance;
 550:           const p3 = Number.isFinite(r2.margin) && r2.success >= GATE.success && r2.margin > 0 && !(r2.topMoves.length === 1 && r2.topMoves[0] === t0);
 551:           if (!(p1 && p2 && p3)) bad.push(`${id} (${p1 ? '' : 'R1 '}${p2 ? '' : 'B-end '}${p3 ? '' : 'R2-end'})`.trim());
 552:         }
 553:         return { pass: bad.length === 0, detail: bad.length ? `${bad.length} of ${R.length} R boards fail: ${bad.slice(0, 3).join('; ')}`
 554:           : `${R.length} R boards keep the phase-1 target and no longer hold the phase-2 target as sole top choice` };
 555:       }),
 556:     ];
 557:     const P3 = [
 558:       gate('P3.1', () => pairGate({ informative: TEST.map(id => at(I, 'R2-end', id).m0.success), off: TEST.map(id => at(O, 'R2-end', id).m0.success),
 559:         shuffled: TEST.map(id => at(S, 'R2-end', id).m0.success) }, TEST.map(game), 'informative', ['off', 'shuffled'], GATE.bootstrapSeed)),
 560:       gate('P3.2', () => pairGate({ final: TEST.map(id => at(I, 'R2-end', id).m0.success), naive: TEST.map(id => at(I, 'T0', id).m0.success) },
 561:         TEST.map(game), 'final', ['naive'], GATE.bootstrapSeed)),
 562:     ];
 563:     const fair = fairBySeed.get(seed) === true;
 564:     const pass = [...P1, ...P2, ...P3].every(g => g.pass) && fair;
 565:     return { seed, pass, P1: { pass: P1.every(g => g.pass), checks: P1 }, P2: { pass: P2.every(g => g.pass), checks: P2 },
 566:       P3: { pass: P3.every(g => g.pass), checks: P3 }, fair: { pass: fair, checks: [] } };
 567:   });
 568:   const pass = perSeed.every(s => s.pass);
 569:   return { perSeed, pass, verdict: pass ? 'passes' : 'does not pass' };
 570: }
 571: 
 572: // Summary shape the judge writes: compared with the auditor's own verdicts in compareSummary.
 573: export function summaryOf(gates) {
 574:   return { schema: SUMMARY_SCHEMA, perSeed: gates.perSeed, baselines: {}, verdict: gates.verdict, pass: gates.pass };
 575: }
 576: 
 577: // Per-gate and overall comparison. P1.2 and P1.4 are deferred to the audit by the judge, so their values may be absent there.
 578: const DEFERRED = new Set(['P1.2', 'P1.4']);
 579: export function compareSummary(mine, summary) {
 580:   if (!summary || typeof summary !== 'object') return { match: false, mismatches: ['summary.json missing or unreadable'] };
 581:   const mism = [];
 582:   if (summary.verdict !== mine.verdict) mism.push(`verdict ${summary.verdict} recorded, ${mine.verdict} recomputed`);
 583:   if (summary.pass !== mine.pass) mism.push(`pass ${summary.pass} recorded, ${mine.pass} recomputed`);
 584:   mine.perSeed.forEach((m, i) => {
 585:     const s = summary.perSeed?.[i];
 586:     if (!s || s.seed !== m.seed) { mism.push(`perSeed[${i}] is not seed ${m.seed}`); return; }
 587:     if (s.pass !== m.pass) mism.push(`seed ${m.seed} pass ${s.pass} recorded, ${m.pass} recomputed`);
 588:     for (const P of ['P1', 'P2', 'P3']) {
 589:       for (const c of m[P].checks) {
 590:         const judged = s[P]?.checks?.find(x => x.name.split(' ')[0] === c.name)?.pass; // judge names are 'P2.3 description'
 591:         if (typeof judged !== 'boolean') {
 592:           if (!DEFERRED.has(c.name)) mism.push(`seed ${m.seed} ${c.name} has no recorded pass`);
 593:         } else if (judged !== c.pass) mism.push(`seed ${m.seed} ${c.name} ${judged} recorded, ${c.pass} recomputed`);
 594:       }
 595:     }
 596:     const fairJudged = typeof s.fair === 'boolean' ? s.fair : s.fair?.pass;
 597:     if (typeof fairJudged !== 'boolean') mism.push(`seed ${m.seed} fair has no recorded pass`);
 598:     else if (fairJudged !== m.fair.pass) mism.push(`seed ${m.seed} fair ${fairJudged} recorded, ${m.fair.pass} recomputed`);
 599:   });
 600:   return { match: mism.length === 0, mismatches: mism };
 601: }
 602: 
 603: // ---- Readers --------------------------------------------------------------------------------------------------
 604: 
 605: export async function* jsonlLines(path) {
 606:   const rl = createInterface({ input: createReadStream(path), crlfDelay: Infinity });
 607:   for await (const line of rl) if (line.trim() !== '') yield JSON.parse(line);
 608: }
 609: export function readJsonOrNull(path) {
 610:   try { return JSON.parse(readFileSync(path, 'utf8')); } catch { return null; }
 611: }
 612: 
 613: // Packet directory: packet.json, boards.jsonl (file order), tapes/<seed>.json (text hashed as read).
 614: export function loadPacket(dir, seeds) {
 615:   const packet = JSON.parse(readFileSync(join(dir, 'packet.json'), 'utf8'));
 616:   const boardsText = readFileSync(join(dir, 'boards.jsonl'), 'utf8');
 617:   const boards = boardsText.split('\n').filter(line => line.trim() !== '').map(line => JSON.parse(line));
 618:   const tapes = new Map();
 619:   for (const seed of seeds) {
 620:     const text = readFileSync(join(dir, 'tapes', `${seed}.json`), 'utf8');
 621:     tapes.set(seed, { tape: JSON.parse(text), fileSha256: sha256Text(text) });
 622:   }
 623:   const byGroup = Object.fromEntries(GROUPS.map(g => [g, boards.filter(r => r.group === g)]));
 624:   const boardsById = new Map(boards.map(r => [r.boardId, r]));
 625:   return { packet, boardsSha256: sha256Text(boardsText), boards, byGroup, boardsById, tapes };
 626: }
 627: 
 628: // Packet check (check 2): every board verified, groups disjoint and counted, test boards disjoint from training, tapes rebuilt.
 629: export function checkPacket({ packet, boardsSha256, boards, byGroup, tapes, seeds }) {
 630:   const problems = [];
 631:   if (packet?.schema !== PACKET_SCHEMA) problems.push('packet schema differs');
 632:   if (packet?.boards?.sha256 !== boardsSha256) problems.push('boards.jsonl SHA-256 differs from packet.json');
 633:   const ids = new Set(), games = new Set();
 634:   for (const r of boards) {
 635:     if (r?.schema !== BOARD_SCHEMA || !GROUPS.includes(r.group)) { problems.push(`${r?.boardId} is not an eligible board record in a known group`); continue; }
 636:     if (ids.has(r.boardId)) problems.push(`duplicate board ${r.boardId}`);
 637:     ids.add(r.boardId);
 638:     if (games.has(r.gameId)) problems.push(`game ${r.gameId} is in more than one board`);
 639:     games.add(r.gameId);
 640:     try {
 641:       if (r.group === 'R') { verifyPacketBoard(r, { phase: 'R1' }); verifyPacketBoard(r, { phase: 'R2' }); }
 642:       else verifyPacketBoard(r);
 643:     } catch (e) { problems.push(`${r.boardId}: ${e.message}`); }
 644:   }
 645:   for (const g of GROUPS) {
 646:     const list = byGroup[g];
 647:     const entry = packet?.groups?.[g];
 648:     if (entry?.count !== list.length) problems.push(`group ${g} count ${entry?.count}, boards.jsonl has ${list.length}`);
 649:     if (!sameValue(entry?.boardIds, list.map(r => r.boardId))) problems.push(`group ${g} boardIds differ from boards.jsonl`);
 650:     if (!sameValue(entry?.gameIds, list.map(r => r.gameId))) problems.push(`group ${g} gameIds differ from boards.jsonl`);
 651:   }
 652:   const train = [...byGroup.A, ...byGroup.B, ...byGroup.R];
 653:   const keys = new Set(train.map(r => boardKey(r.fen)));
 654:   const hashes = new Set(train.flatMap(r => Object.values(r.inputHashes)));
 655:   for (const r of [...byGroup.testA, ...byGroup.testB]) {
 656:     if (keys.has(boardKey(r.fen))) problems.push(`test board ${r.boardId} shares a board key with training`);
 657:     if (Object.values(r.inputHashes).some(h => hashes.has(h))) problems.push(`test board ${r.boardId} shares a rendered input with training`);
 658:   }
 659:   for (const seed of seeds) {
 660:     const entry = tapes.get(seed);
 661:     if (!entry) { problems.push(`tape ${seed} missing`); continue; }
 662:     let rebuilt;
 663:     try { rebuilt = buildExperienceTape(byGroup, seed); }
 664:     catch (e) { problems.push(`tape ${seed} cannot be rebuilt: ${e.message}`); continue; }
 665:     if (rebuilt.sha256 !== entry.tape.sha256) problems.push(`tape ${seed} sha256 differs from the rebuilt tape`);
 666:     if (packet?.tapes?.[seed]?.sha256 !== rebuilt.sha256) problems.push(`packet.json tape ${seed} sha256 differs from the rebuilt tape`);
 667:     if (packet?.tapes?.[seed]?.fileSha256 !== entry.fileSha256) problems.push(`packet.json tape ${seed} file SHA-256 differs`);
 668:     if (!sameValue(JSON.parse(JSON.stringify(rebuilt)), entry.tape)) problems.push(`tape ${seed} content differs from the rebuilt tape`);
 669:   }
 670:   return { name: 'packet', pass: problems.length === 0,
 671:     detail: problems.length ? `${problems.length} problems; first: ${problems.slice(0, 3).join('; ')}`
 672:       : `${boards.length} boards verified (R both phases); groups counted and disjoint; test boards share no board key or rendered input with training; ${seeds.length} tapes rebuilt identically` };
 673: }
 674: 
 675: function jobResultProblems(result, { seed, arm, tape }) {
 676:   const out = [];
 677:   if (result.schema !== RESULT_SCHEMA) out.push('schema differs');
 678:   if (result.seed !== seed || result.arm !== arm) out.push('seed or arm differs from its directory');
 679:   if (result.status !== 'complete') out.push(`status is ${result.status}`);
 680:   if (result.tapeSha256 !== tape.sha256) out.push('tapeSha256 differs from the tape');
 681:   if (result.events !== tape.events.length) out.push(`${result.events} events, tape has ${tape.events.length}`);
 682:   if (!Number.isSafeInteger(result.passes) || result.passes < 0) out.push('passes is not a count');
 683:   const d = result.describe ?? {}, rule = ARM_TABLE[arm];
 684:   if (d.arm !== arm || d.aplMode !== rule?.apl || d.pulseRule !== rule?.pulse || d.learns !== rule?.learns) out.push('describe does not match the arm table');
 685:   const groups = d.groups ?? [];
 686:   if (groups.length !== 2 || groups[0]?.side !== 'left' || groups[1]?.side !== 'right') out.push('describe groups are not left then right');
 687:   if (!Number.isSafeInteger(d.maskEdges) || d.maskEdges < 1) out.push('maskEdges is not a count');
 688:   return out;
 689: }
 690: 
 691: // Runs checks 2 to 9 (everything except pins and replay). Returns the checks in order, the gate verdicts, the match flag and the packet.
 692: export async function auditStaticChecks({ runDir, packetDir, registration, sourceTexts = {}, summary = null }) {
 693:   const seeds = registration.seeds ?? [], arms = registration.arms ?? [];
 694:   const names = ['packet', 'jobs', 'events', 'updates', 'fingerprints', 'rankings', 'gates', 'resources'];
 695:   let packet;
 696:   try { packet = loadPacket(packetDir, seeds); }
 697:   catch (e) {
 698:     return { checks: names.map(name => ({ name, pass: false, detail: `packet unreadable: ${e.message}` })), gates: null, match: false, packet: null };
 699:   }
 700:   const checks = [checkPacket({ ...packet, seeds })];
 701: 
 702:   const jobDirs = existsSync(join(runDir, 'jobs'))
 703:     ? readdirSync(join(runDir, 'jobs'), { withFileTypes: true }).filter(d => d.isDirectory()).map(d => d.name) : [];
 704:   const expected = seeds.flatMap(seed => arms.map(arm => `${seed}-${arm}`));
 705:   const jobProblems = [];
 706:   for (const n of expected) if (!jobDirs.includes(n)) jobProblems.push(`missing job ${n}`);
 707:   for (const n of jobDirs) if (!expected.includes(n)) jobProblems.push(`extra job ${n}`);
 708: 
 709:   const legalCache = new Map(), shared = { pulseCells: null };
 710:   const jobs = new Map(), fairBySeed = new Map(), resourceProblems = [], walkErrors = [];
 711:   for (const seed of seeds) {
 712:     const tape = packet.tapes.get(seed).tape;
 713:     let fair = true;
 714:     for (const arm of arms) {
 715:       const name = `${seed}-${arm}`, dir = join(runDir, 'jobs', name);
 716:       if (!jobDirs.includes(name)) { fair = false; continue; }
 717:       let result;
