 268: function fairCheck(jobs, tapeSha256) {
 269:   const rows = ARMS.map(arm => {
 270:     const { tapeSha256: tape, peakRssMiB, minFreeMiB } = jobs[arm].result;
 271:     return { arm, tapeOk: tape === tapeSha256, peakRssMiB, minFreeMiB,
 272:       rssOk: Number.isFinite(peakRssMiB) && peakRssMiB <= RSS_MAX_MIB,
 273:       freeOk: Number.isFinite(minFreeMiB) && minFreeMiB >= FREE_MIN_MIB };
 274:   });
 275:   return { pass: rows.every(r => r.tapeOk && r.rssOk && r.freeOk), jobs: rows };
 276: }
 277: 
 278: // jobs: { arm: readJob output } for all six arms. tapeSha256: the seed's tape hash (fairness check).
 279: export function judgeSeed({ seed, jobs, records, gates, tapeSha256 }) {
 280:   checkGates(gates);
 281:   if (!Number.isSafeInteger(seed)) throw Error('seed must be a safe integer');
 282:   if (!(records instanceof Map)) throw Error('records must be a Map of boardId to board record');
 283:   if (!/^[0-9a-f]{64}$/.test(tapeSha256 ?? '')) throw Error('tapeSha256 must be a SHA-256 hex digest');
 284:   const missing = ARMS.filter(arm => !jobs?.[arm]);
 285:   if (missing.length) throw Error(`Missing arms: ${missing.join(', ')}`);
 286:   const extra = Object.keys(jobs).filter(arm => !ARMS.includes(arm));
 287:   if (extra.length) throw Error(`Unknown arms: ${extra.join(', ')}`);
 288:   for (const arm of ARMS) {
 289:     const { result } = jobs[arm];
 290:     if (result.seed !== seed || result.arm !== arm) throw Error(`Job ${arm} is seed ${result.seed} ${result.arm}, expected ${seed} ${arm}`);
 291:   }
 292:   for (const [id, record] of records) if (record?.boardId !== id) throw Error(`Record key ${id} differs from its boardId`);
 293:   for (const arm of ARMS) {
 294:     for (const [label, boards] of jobs[arm].rankings) {
 295:       for (const id of boards.keys()) if (!records.has(id)) throw Error(`${arm} ${label}: ranking for unknown board ${id}`);
 296:     }
 297:   }
 298:   const groupOf = group => [...records.values()].filter(r => r.group === group).sort(byId);
 299:   const A = groupOf('A'), B = groupOf('B'), R = groupOf('R'), testA = groupOf('testA'), testB = groupOf('testB');
 300:   for (const [name, list] of Object.entries({ A, B, R, testA, testB })) if (list.length === 0) throw Error(`No ${name} boards`);
 301:   for (const record of R) if (record.rTargets?.length !== 2) throw Error(`R board ${record.boardId} needs two rTargets`);
 302: 
 303:   const replayed = new Map();
 304:   const boardOf = record => {
 305:     if (!replayed.has(record.boardId)) replayed.set(record.boardId, replayPacketBoard(record));
 306:     return replayed.get(record.boardId);
 307:   };
 308:   // Chess boards carry verified outcomes. R boards score one contingency target: 0 = phase 1, 1 = phase 2.
 309:   const outcomesFor = (record, target) => (record.group !== 'R'
 310:     ? record.outcomes
 311:     : Object.fromEntries(boardOf(record).moves({ verbose: true }).map(m => [uci(m), uci(m) === record.rTargets[target]])));
 312:   const metricsOf = (arm, label, record, target) => {
 313:     const ranking = jobs[arm].rankings.get(label)?.get(record.boardId);
 314:     if (!ranking) throw Error(`${arm}: no ranking at ${label} for ${record.boardId}`);
 315:     const m = scoreAllLegal(boardOf(record), ranking.ranked, outcomesFor(record, target));
 316:     if (m.margin === null) throw Error(`${record.boardId} at ${label}: margin is null (no success or no failure)`);
 317:     return { boardId: record.boardId, gameId: record.gameId, success: m.success, margin: m.margin, tolerance: m.tolerance, topMoves: m.topMoves };
 318:   };
 319:   const rows = (arm, label, list, target) => list.map(r => metricsOf(arm, label, r, target));
 320:   const successes = (arm, label, list, target) => list.map(r => metricsOf(arm, label, r, target).success);
 321:   const ctx = { jobs, gates, A, B, R, testA, testB, metricsOf, rows, successes };
 322: 
 323:   const P1 = p1(ctx);
 324:   const { report: p25, ...P2 } = p2(ctx);
 325:   const { report: p3Report, ...P3 } = p3(ctx);
 326:   const fair = fairCheck(jobs, tapeSha256);
 327:   const pass = P1.pass && P2.pass && P3.pass && fair.pass;
 328:   return { seed, P1, P2, P3, fair: fair.pass, pass, report: { P2_5: p25, P3: p3Report, fair: fair.jobs } };
 329: }
 330: 
 331: // registration: the registration JSON. tapes: Map(seed -> { sha256 }). records: Map(boardId -> board record).
 332: export async function judgeRun({ runDir, registration, records, tapes, baselines }) {
 333:   if (registration?.limits?.rssMiB !== RSS_MAX_MIB || registration.limits.freeMiB !== FREE_MIN_MIB) {
 334:     throw Error('registration limits differ from the judge constants (2048 MiB RSS, 256 MiB free)');
 335:   }
 336:   if (JSON.stringify([...registration.arms].sort()) !== JSON.stringify([...ARMS].sort())) throw Error('registration arms differ from the six judged arms');
 337:   if (!Array.isArray(registration.seeds) || registration.seeds.length === 0) throw Error('registration needs seeds');
 338:   if (!(tapes instanceof Map)) throw Error('tapes must be a Map of seed to tape');
 339:   const perSeed = [];
 340:   for (const seed of registration.seeds) {
 341:     const tape = tapes.get(seed);
 342:     if (!tape) throw Error(`No tape for seed ${seed}`);
 343:     const jobs = {};
 344:     for (const arm of ARMS) jobs[arm] = await readJob(join(runDir, 'jobs', `${seed}-${arm}`));
 345:     perSeed.push(judgeSeed({ seed, jobs, records, gates: registration.gates, tapeSha256: tape.sha256 }));
 346:   }
 347:   const pass = perSeed.every(s => s.pass);
 348:   return { perSeed, baselines, pass, verdict: pass ? 'passes' : 'does not pass' };
 349: }
