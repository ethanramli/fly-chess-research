  17: 
  18: const ROOT = fileURLToPath(new URL('../../..', import.meta.url));
  19: // Scoring-path sources read for the static import check (P1.4).
  20: const SCORING_SOURCES = [
  21:   '.codebase/src/neural-learning/fly-connections-condition-v1.mjs',
  22:   '.codebase/src/neural-learning/fly-connections-apl-v1.mjs',
  23:   '.codebase/src/neural-learning/fly-connections-teaching-v1.mjs',
