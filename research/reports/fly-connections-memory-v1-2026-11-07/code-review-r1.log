 149:     if (experience.criterion !== record.criterion) throw Error('Experience criterion differs from the sealed record');
 150:     // The tape event must match a sealed record entry: R targets are UCI strings, chess experiences carry pulse.
 151:     const bound = record.proofs?.[move]?.certificateSha256 === experience.proofSha
 152:       && (record.group === 'R' ? record.rTargets.includes(move) : record.experiences.some(e => e.move === move && e.pulse === experience.pulse));
