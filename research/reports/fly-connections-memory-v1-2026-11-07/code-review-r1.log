 138: function checkPositive(xs, n, name) {
 139:   if (!xs || xs.length !== n) throw Error(`${name} must have one value per edge`);
 140:   for (let i = 0; i < n; i++) if (!(Number.isFinite(xs[i]) && xs[i] > 0)) throw Error(`${name}[${i}] must be finite and positive`);
 141: }
