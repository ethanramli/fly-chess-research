  40: }
  41: 
  42: // Chess groups verify as 'chess'; R records need an explicit contingency phase.
  43: function verifyPhaseFor(group, phase) {
  44:   if (CHESS_GROUPS.has(group)) {
  45:     if (phase !== 'chess') throw Error(`Group ${group} verifies with phase chess`);
  46:     return phase;
  47:   }
  48:   if (group === 'R') {
  49:     if (phase !== 'R1' && phase !== 'R2') throw Error('R records need phase R1 or R2');
  50:     return phase;
  51:   }
  52:   throw Error(`Unknown record group ${group}`);
  53: }
  54: 
  55: function checkExperience(x) {
  56:   if (!Number.isSafeInteger(x?.sequence) || x.sequence < 0) throw Error('Invalid experience sequence');
  57:   if (typeof x.eventId !== 'string' || !x.eventId) throw Error('Invalid experience eventId');
  58:   if (!Object.hasOwn(TAPE_GROUP, x.phase)) throw Error('Invalid experience phase');
