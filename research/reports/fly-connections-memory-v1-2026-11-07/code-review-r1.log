  94: // Extraction only: reads the one actual endpoint h[steps] and copies the rates the mapping names.
  95: // Negative factor = fixed depressing modulatory convention, not negative dopamine concentration.
  96: // Does not modify model, mapping, graph or memory.
  97: export function actualTeachingInputs(model, mapping, { activityScale = 1.5 } = {}) {
