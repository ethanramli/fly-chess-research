  48:       const fields = line.split('\t');
  49:       if (!header) {
  50:         header = fields;
  51:         for (const key of requiredColumns) {
  52:           if (!header.includes(key)) throw Error(`Missing annotation column ${key}`);
  53:           col[key] = header.indexOf(key);
  54:         }
  55:         continue;
  56:       }
  57:       const cls = fields[col.cell_class] ?? '';
  58:       if (!['Kenyon_Cell', 'DAN', 'MBON'].includes(cls)) continue;
  59:       const root = parseRoot(fields[col.root_id]);
  60:       const index = indices.get(root);
  61:       if (index === undefined) { outsideGraph++; continue; }
