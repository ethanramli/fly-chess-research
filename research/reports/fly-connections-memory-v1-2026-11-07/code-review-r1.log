 404: // ---- Gate arithmetic (auditor's own) -------------------------------------------------------------------------
 405: 
 406: // Gate P2.1 (judgeRetention rule): acquisition, retention ratio against the learned margin, group ratio, and B acquisition.
 407: export function retentionGate({ a0, aAfterA, aAfterB, aFinal, bBefore, bAfter, bFinal, minAcquired,
 408:   retention = GATE.retention, epsilon = GATE.epsilon, success = GATE.success }) {
 409:   const need = (x, what) => { if (!Number.isFinite(x)) throw Error(`${what} is not a finite margin`); return x; };
 410:   const acquired = (t, base) => {
 411:     need(t.margin, 'post margin'); need(base.margin, 'base margin');
 412:     return t.success >= success && t.margin > t.tolerance && t.margin - base.margin > epsilon;
 413:   };
 414:   const a = a0.map((naive, i) => {
 415:     const t = aAfterA[i], m = aAfterB[i], f = aFinal[i];
 416:     const learned = need(t.margin, 'A-end margin') - need(naive.margin, 'T0 margin');
 417:     const acq = acquired(t, naive);
 418:     const dB = need(m.margin, 'B-end margin') - naive.margin;
 419:     const dF = need(f.margin, 'R2-end margin') - naive.margin;
 420:     const rB = learned > epsilon ? dB / learned : null;
 421:     const rF = learned > epsilon ? dF / learned : null;
 422:     const retained = acq && m.success >= success && f.success >= success && rB !== null && rF !== null && rB >= retention && rF >= retention;
 423:     return { id: naive.boardId, acq, retained, learned, dB, dF };
 424:   });
 425:   const learnedSum = a.reduce((s, x) => s + x.learned, 0);
 426:   const groupB = learnedSum > 0 ? a.reduce((s, x) => s + x.dB, 0) / learnedSum : null;
 427:   const groupF = learnedSum > 0 ? a.reduce((s, x) => s + x.dF, 0) / learnedSum : null;
 428:   const groupPass = learnedSum > 0 && groupB >= retention && groupF >= retention;
 429:   const aAcq = a.filter(x => x.acq).length;
 430:   const aLost = a.filter(x => x.acq && !x.retained).map(x => x.id);
 431:   const aPass = aAcq >= minAcquired && aLost.length === 0 && groupPass;
 432: 
 433:   const b = bBefore.map((before, i) => {
 434:     const t = bAfter[i], f = bFinal[i];
 435:     const acq = acquired(t, before);
 436:     return { id: before.boardId, acq, retained: acq && f.success >= success };
 437:   });
 438:   const bAcq = b.filter(x => x.acq).length;
 439:   const bLost = b.filter(x => x.acq && !x.retained).map(x => x.id);
 440:   const bPass = bAcq >= minAcquired && bLost.length === 0;
 441:   const fmt = x => (x === null ? 'n/a' : x.toFixed(3));
 442:   return { pass: aPass && bPass,
 443:     detail: `A acquired ${aAcq} (min ${minAcquired}), lost [${aLost.join(' ')}], group ratio ${fmt(groupB)} / ${fmt(groupF)}; `
 444:       + `B acquired ${bAcq} (min ${minAcquired}), lost [${bLost.join(' ')}]` };
 445: }
