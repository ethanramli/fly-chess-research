 462: // Paired bootstrap through the shared numericPairGate; passes when every comparator's lower bound is above 0.
 463: function pairGate(arms, games, primary, comparators, seed) {
 464:   const r = numericPairGate({ arms, games, primary, comparators, minCorrect: 0, minMargin: 0,
 465:     resamples: GATE.resamples, seed, lowerQuantile: GATE.lowerQuantile });
 466:   const lows = comparators.map(c => [c, r.comparators[c].lower]);
 467:   return { pass: lows.every(([, lo]) => lo > 0), detail: `${primary} vs ${lows.map(([c, lo]) => `${c} lower ${lo.toFixed(4)}`).join(', ')}` };
 468: }
