   5: const SUCCESS = 0.75;
   6: const PRESSURE = 0.01;
   7: const TIE_ABS = 1e-9;
   8: const TIE_REL = 1e-7;
   9: const f32 = new Float32Array(1);
  10: const f32Bits = new Uint32Array(f32.buffer);
