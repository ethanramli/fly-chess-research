  58:       if (rec.label === 'T0') t0.set(rec.boardId, { ranking, fingerprint: rec.fingerprint });
  59:     } else {
  60:       if (result.arm !== 'off-local' || rec.from !== 'T0' || rec.label === 'T0') {
  61:         throw Error(`${dir}: ranking-reused is allowed only in the off arm, from T0, at a later label`);
  62:       }
  63:       const base = t0.get(rec.boardId);
  64:       if (!base) throw Error(`${dir}: reused ${rec.boardId} has no T0 ranking`);
  65:       if (rec.fingerprint !== base.fingerprint) throw Error(`${dir}: reused ranking ${rec.label} ${rec.boardId} has a fingerprint that differs from T0`);
  66:       ranking = base.ranking;
  67:     }
  68:     if (!rankings.has(rec.label)) rankings.set(rec.label, new Map());
