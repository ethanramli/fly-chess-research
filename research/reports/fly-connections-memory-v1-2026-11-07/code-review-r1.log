 104: function p1({ jobs }) {
 105:   const job = jobs[PRIMARY];
 106:   const chain = chainCheck(job);
 107:   const learns = job.result.describe?.learns === true;
 108:   const pulsed = [], unpulsed = [];
 109:   for (const e of job.events) {
 110:     if (e.phase !== 'A' && e.phase !== 'B') continue;
 111:     if (!Array.isArray(e.teaching) || e.teaching.length !== 2 || typeof e.deliveredPulse !== 'boolean') {
 112:       throw Error(`event ${e.sequence}: needs two teaching sides and a boolean deliveredPulse`);
 113:     }
 114:     (e.deliveredPulse ? pulsed : unpulsed).push(mean(e.teaching.map(t => t.factor)));
 115:   }
 116:   const difference = pulsed.length && unpulsed.length ? mean(pulsed) - mean(unpulsed) : null;
 117:   const checks = [
 118:     { name: 'P1.1 only mask state changes (fingerprint chain; learns)', pass: chain.ok && learns,
 119:       detail: { ...chain.detail, learns, identities: job.result.describe?.identities } },
 120:     { name: 'P1.2 every update recomputed by the auditor', pass: null, detail: 'deferred to audit' },
 121:     { name: 'P1.3 pulse events more depressing than no-pulse events (mean D difference < -1e-6)',
 122:       pass: difference !== null && difference < -1e-6,
 123:       detail: { pulseEvents: pulsed.length, noPulseEvents: unpulsed.length,
 124:         meanPulseD: pulsed.length ? mean(pulsed) : null, meanNoPulseD: unpulsed.length ? mean(unpulsed) : null, difference } },
 125:     { name: 'P1.4 no engineered store, label or selected action in primary scores', pass: null, detail: 'code review + audit' },
 126:   ];
 127:   return { pass: checks[0].pass === true && checks[2].pass === true, checks };
 128: }
 129: 
 130: // Pressure: which mask edges A writes, which edges B pressure, and the magnitudes at B-end.
 131: // Snapshots hold gains only, so unwritten mask edges enter summarizePressure as placeholders.
 132: // ponytail: placeholder edge IDs (-1, -2, ...) with base = final = 1; the auditor recomputes with the real mask IDs.
 133: function pressureCheck(ctx, acquiredA) {
 134:   const { jobs, gates, A, B, metricsOf } = ctx;
 135:   const { events, result, snapshots } = jobs[PRIMARY];
 136:   const n = result.describe?.maskEdges;
 137:   if (!Number.isSafeInteger(n) || n < 1) throw Error('describe.maskEdges must be a positive integer');
 138:   for (const [label, snap] of snapshots) {
 139:     if (snap.memory?.gains?.length !== n) throw Error(`Snapshot ${label} has ${snap.memory?.gains?.length} gains; the mask has ${n}`);
 140:   }
 141:   const lastB = events.reduce((last, e) => (e.phase === 'B' ? e.sequence : last), -1);
 142:   const base = new Map(), finalAfter = new Map(), written = new Set(), pressured = new Set(), overwrites = [];
 143:   for (const e of events) {
 144:     if (!Array.isArray(e.writes)) throw Error(`event ${e.sequence}: writes must be a list`);
 145:     for (const w of e.writes) {
 146:       if (!base.has(w.edgeId)) base.set(w.edgeId, w.beforeMagnitude);
 147:       if (e.phase === 'A' && w.effectiveChanged) written.add(w.edgeId);
 148:       if (e.phase === 'B' && w.pressureWrite) pressured.add(w.edgeId);
 149:       if (e.sequence <= lastB) finalAfter.set(w.edgeId, w.afterMagnitude);
 150:       if (w.effectiveChanged) {
 151:         overwrites.push({ edgeId: w.edgeId, phase: e.phase, sequence: e.sequence, before: w.beforeMagnitude, after: w.afterMagnitude });
 152:       }
 153:     }
 154:   }
 155:   const edges = [...base.keys()];
 156:   const mask = { maskEdges: n, writtenEdges: edges.length, aWrittenEdges: written.size, bPressureEdges: pressured.size };
