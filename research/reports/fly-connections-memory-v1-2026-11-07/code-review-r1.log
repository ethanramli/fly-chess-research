 158:   if (written.size === 0) {
 159:     check = { name: 'P2.3 pressure was real', pass: false, detail: 'no A-written edges (empty A capacity)' };
 160:   } else {
 161:     if (edges.length > n) throw Error('More written edges than mask edges');
 162:     const edgeIds = [...edges];
 163:     const naive = edges.map(id => base.get(id));
 164:     const final = edges.map(id => finalAfter.get(id) ?? base.get(id));
 165:     for (let k = 1; edgeIds.length < n; k++) { edgeIds.push(-k); naive.push(1); final.push(1); }
 166:     summary = summarizePressure([...written], [...pressured], naive, Float32Array.from(final), edgeIds);
 167:     check = { name: 'P2.3 pressure was real (summarizePressure)', pass: summary.pass, detail: summary };
 168:   }
 169: 
 170:   // Report only: after the k-th trained board of a group, cumulative pressure writes and A boards acquired at T_A but unsuccessful.
 171:   const loadsOf = (group, list) => {
 172:     const ids = new Set(list.map(r => r.boardId));
 173:     const last = new Map();
 174:     for (const e of events) if (e.phase === group) last.set(e.boardId, e.sequence);
 175:     if (last.size !== ids.size || [...last.keys()].some(id => !ids.has(id))) throw Error(`Group ${group}: trained boards differ from its records`);
 176:     const cutoffs = [...last.values()].sort((x, y) => x - y);
 177:     const nb = list.length;
 178:     return [8, 16, 32].filter(k => k < nb).concat(nb).map(k => {
 179:       const label = k === nb ? `${group}-end` : `${group}-${k}`;
 180:       if (!jobs[PRIMARY].rankings.has(label)) throw Error(`Missing probe ${label}`);
 181:       const cutoff = cutoffs[k - 1];
 182:       const pressureWrites = events
 183:         .filter(e => e.phase === group && e.sequence <= cutoff)
 184:         .reduce((count, e) => count + e.writes.filter(w => w.pressureWrite).length, 0);
 185:       const lostIds = A.filter(r => acquiredA.has(r.boardId) && metricsOf(PRIMARY, label, r).success < gates.success).map(r => r.boardId);
 186:       return { k, label, cutoffSequence: cutoff, pressureWrites, aBoardsLost: lostIds.length, lostIds };
 187:     });
 188:   };
 189:   return { check, report: { mask, summary, loads: { A: loadsOf('A', A), B: loadsOf('B', B) }, overwrites } };
 190: }
