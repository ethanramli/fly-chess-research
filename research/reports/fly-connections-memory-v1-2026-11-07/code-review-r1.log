 176:       update = { observed: true, factors: observed.factors, changedEdges: observed.changedEdges, events: observed.events, scope: observed.scope };
 177:     }
 178:     const writes = recordEffectiveWrites(this.memory.edges, this.memory.base, gainsBefore, Float64Array.from(this.memory.gains),
 179:       magnitudesBefore, this.#effectiveMagnitudes());
 180:     const receipt = { ...base, status: 'taught', outcome, pulse: experience.pulse, deliveredPulse: delivered,
 181:       cueSha: stimulusHash(cue), pulseCurrent: delivered ? PULSE_CURRENT : 0, pulseCells: [...this.dan],
 182:       unaided, teaching: teaching.map(g => ({ side: g.side, kc: Array.from(g.kcRates), dan: Array.from(g.danRates),
