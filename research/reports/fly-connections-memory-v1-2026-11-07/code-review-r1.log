 192: // Phase-2 correction on every R board. R rankings are phase R1 throughout; target 1 is scored from the same scores.
 193: function correctionCheck({ R, gates, metricsOf }) {
 194:   const boards = R.map(record => {
 195:     const aEnd = metricsOf(PRIMARY, 'A-end', record, 0);
 196:     const r1 = metricsOf(PRIMARY, 'R1-end', record, 0);
 197:     const b = metricsOf(PRIMARY, 'B-end', record, 0);
 198:     const r2 = metricsOf(PRIMARY, 'R2-end', record, 1);
 199:     const parts = {
 200:       afterR1: r1.success >= gates.success && r1.margin > r1.tolerance && r1.margin - aEnd.margin > gates.epsilon,
 201:       atBEnd: b.success >= gates.success && b.margin > b.tolerance,
 202:       afterR2: r2.success >= gates.success && r2.margin > 0 && !(r2.topMoves.length === 1 && r2.topMoves[0].move === record.rTargets[0]),
 203:     };
 204:     return { boardId: record.boardId, pass: Object.values(parts).every(Boolean), parts, values: { aEnd, r1, b, r2 } };
 205:   });
 206:   return { name: 'P2.4 phase-1 target acquired, held, and phase-2 target sole correct on every R board', pass: boards.every(b => b.pass), detail: boards };
 207: }
 208: 
 209: function p2(ctx) {
 210:   const { gates, A, B, rows, successes } = ctx;
 211:   const retention = judgeRetention({
 212:     a0: rows(PRIMARY, 'T0', A), aAfterA: rows(PRIMARY, 'A-end', A), aAfterB: rows(PRIMARY, 'B-end', A), aFinal: rows(PRIMARY, 'R2-end', A),
 213:     bBefore: rows(PRIMARY, 'R1-end', B), bAfter: rows(PRIMARY, 'B-end', B), bFinal: rows(PRIMARY, 'R2-end', B),
 214:     minAcquired: gates.minAcquired, retention: gates.retention, epsilon: gates.epsilon,
 215:   });
 216:   const AB = [...A, ...B].sort(byId);
 217:   const g22 = compareByGame({
 218:     arms: { informative: successes(PRIMARY, 'B-end', AB), absent: successes(ARM.absent, 'B-end', AB),
 219:       off: successes(ARM.off, 'B-end', AB), shuffled: successes(ARM.shuffled, 'B-end', AB) },
 220:     games: AB.map(r => r.gameId), primary: 'informative', comparators: ['absent', 'off', 'shuffled'], seed: gates.bootstrapSeed,
 221:   });
 222:   const acquiredA = new Set(retention.a.items.filter(x => x.acquired).map(x => x.boardId));
 223:   const pressure = pressureCheck(ctx, acquiredA);
 224:   const checks = [
 225:     { name: 'P2.1 retention, acquisition and minAcquired', pass: retention.pass, detail: { a: summarize(retention.a), b: summarize(retention.b) } },
 226:     { name: 'P2.2 learning beats absent, off and shuffled (game-clustered lower > 0)',
 227:       pass: Object.values(g22.comparators).every(c => c.lower > 0), detail: g22 },
 228:     pressure.check,
 229:     correctionCheck(ctx),
 230:   ];
 231:   return { pass: checks.every(c => c.pass === true), checks, report: pressure.report };
 232: }
 233: 
 234: function p3(ctx) {
 235:   const { gates, successes, testA, testB } = ctx;
 236:   const compare = list => {
 237:     const games = list.map(r => r.gameId);
 238:     const p31 = compareByGame({
 239:       arms: { informative: successes(PRIMARY, 'R2-end', list), off: successes(ARM.off, 'R2-end', list), shuffled: successes(ARM.shuffled, 'R2-end', list) },
 240:       games, primary: 'informative', comparators: ['off', 'shuffled'], seed: gates.bootstrapSeed,
 241:     });
 242:     const p32 = compareByGame({
 243:       arms: { final: successes(PRIMARY, 'R2-end', list), naive: successes(PRIMARY, 'T0', list) },
 244:       games, primary: 'final', comparators: ['naive'], seed: gates.bootstrapSeed,
 245:     });
 246:     return { p31, p32, pass31: Object.values(p31.comparators).every(c => c.lower > 0), pass32: p32.comparators.naive.lower > 0 };
 247:   };
 248:   const testAll = [...testA, ...testB].sort(byId);
 249:   const all = compare(testAll);
 250:   const other = compareByGame({
 251:     arms: { informative: successes(PRIMARY, 'R2-end', testAll), absent: successes(ARM.absent, 'R2-end', testAll),
 252:       matched: successes(ARM.matched, 'R2-end', testAll), global: successes(ARM.global, 'R2-end', testAll) },
 253:     games: testAll.map(r => r.gameId), primary: 'informative', comparators: ['absent', 'matched', 'global'], seed: gates.bootstrapSeed,
 254:   });
 255:   return {
 256:     pass: all.pass31 && all.pass32,
 257:     checks: [
 258:       { name: 'P3.1 new positions beat off and shuffled (game-clustered lower > 0)', pass: all.pass31, detail: all.p31 },
 259:       { name: 'P3.2 improves on own T0, paired by game (lower > 0)', pass: all.pass32, detail: all.p32 },
 260:     ],
 261:     report: {
 262:       testA: compare(testA), testB: compare(testB), otherArms: other,
 263:       meanSuccessAtR2End: Object.fromEntries(Object.entries(ARM).map(([short, arm]) => [short, mean(successes(arm, 'R2-end', testAll))])),
 264:     },
 265:   };
 266: }
