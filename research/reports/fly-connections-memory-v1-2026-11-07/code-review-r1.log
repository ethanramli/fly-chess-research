 127: function edgeIndex(edgeIds) {
 128:   if (!edgeIds || edgeIds.length === 0) throw Error('edgeIds must be a nonempty list');
 129:   const index = new Map();
 130:   for (let i = 0; i < edgeIds.length; i++) {
 131:     const id = edgeIds[i];
 132:     if (!Number.isSafeInteger(id) || index.has(id)) throw Error(`Invalid or duplicate edge ID ${id}`);
 133:     index.set(id, i);
 134:   }
 135:   return index;
 136: }
