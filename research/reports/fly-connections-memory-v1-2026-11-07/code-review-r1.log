  83:     for (const [prefix, count] of [['input', apl.inputs], ['output', apl.outputs]]) {
  84:       const site = get(`${prefix}Site`), kc = get(`${prefix}KC`), edge = get(`${prefix}Edge`);
  85:       for (const array of [site, kc, edge]) {
  86:         if (!(array instanceof Int32Array) || array.length !== count) fail(`APL slot ${slot} ${prefix} arrays differ in count`);
  87:       }
  88:       for (let i = 0; i < count; i++) {
  89:         if (site[i] < 0 || site[i] >= N) fail(`APL slot ${slot} ${prefix} site ${i} is outside the tree`);
  90:         if (!kcSet.has(kc[i])) fail(`APL slot ${slot} ${prefix} KC ${kc[i]} is not an annotated retained KC`);
  91:         if (edge[i] < 0) fail(`APL slot ${slot} ${prefix} edge ${i} is negative`);
  92:       }
  93:     }
  94:     return { rootId: apl.rootId, index: apl.index, slot, parent, lengthNm, inputSite: get('inputSite'), inputKC: get('inputKC'),
  95:       inputEdge: get('inputEdge'), outputSite: get('outputSite'), outputKC: get('outputKC'), outputEdge: get('outputEdge') };
  96:   });
  97: 
  98:   const identity = createHash('sha256').update(packageBytes).update(pkg.sitesSha256).digest('hex');
  99:   return { schema: 'fly-apl-sites-v1', identity, kcIndices, apls: result };
 100: }
--- .codebase/src/neural-learning/fly-connections-job-v1.mjs
   1: // Fly connections memory v1: one (seed, arm) job loop. Pure of graph loading: the caller supplies a ready condition.
   2: // Probes and events follow the tape (file formats doc: probe sets, resume and exactly-once). Every append is
   3: // acknowledged by state.json; a restart truncates records.jsonl to the acknowledged bytes and restores the snapshot.
   4: import { appendFileSync, createReadStream, existsSync, mkdirSync, readFileSync, renameSync, statSync, truncateSync, writeFileSync } from 'node:fs';
   5: import { createInterface } from 'node:readline';
   6: import { join } from 'node:path';
   7: 
   8: const STATE = 'fly-connections-job-state-v1';
   9: const RESULT = 'fly-connections-job-result-v1';
  10: // Probe label -> groups ranked, in this order.
  11: const PROBES = {
  12:   T0: ['A', 'B', 'R', 'testA', 'testB'],
  13:   'A-8': ['A'], 'A-16': ['A'], 'A-end': ['A', 'R'],
  14:   'R1-end': ['A', 'B', 'R'],
  15:   'B-8': ['A', 'B'], 'B-16': ['A', 'B'], 'B-end': ['A', 'B', 'R', 'testA', 'testB'],
  16:   'R2-end': ['A', 'B', 'R', 'testA', 'testB'],
  17: };
  18: const byBoardId = (a, b) => (a.boardId < b.boardId ? -1 : a.boardId > b.boardId ? 1 : 0);
  19: const lineOf = value => `${JSON.stringify(value)}\n`;
  20: const writeAtomic = (path, text) => { writeFileSync(`${path}.partial`, text); renameSync(`${path}.partial`, path); };
  21: 
  22: // Passes and the first fingerprint per label, read from the acknowledged prefix of records.jsonl only.
  23: async function acknowledged(path, bytes) {
  24:   const found = { passes: 0, fingerprints: {} };
  25:   if (bytes === 0) return found;
  26:   const lines = createInterface({ input: createReadStream(path, { end: bytes - 1 }), crlfDelay: Infinity });
  27:   for await (const line of lines) {
  28:     const entry = JSON.parse(line);
  29:     if (entry.type === 'event') { found.passes += entry.receipt.passes; continue; }
  30:     if (entry.type === 'ranking') found.passes += entry.ranking.passes;
  31:     found.fingerprints[entry.label] ??= entry.fingerprint;
  32:   }
  33:   return found;
  34: }
  35: 
  36: // now() returns milliseconds. extra() returns { peakRssMiB, minFreeMiB } for this invocation.
  37: export async function runJob({ condition, records, tape, arm, dir, now = () => performance.now(), extra = () => ({}) }) {
  38:   const resultPath = join(dir, 'result.json');
  39:   if (existsSync(resultPath)) return JSON.parse(readFileSync(resultPath, 'utf8'));
  40:   if (!(records instanceof Map)) throw Error('records must be a Map of boardId to board record');
  41:   if (condition.describe().arm !== arm) throw Error(`Condition arm ${condition.describe().arm} differs from job arm ${arm}`);
  42:   tape.events.forEach((event, i) => { if (event.sequence !== i) throw Error(`Tape event ${i} has sequence ${event.sequence}`); });
  43: 
  44:   const started = now(), cpuStarted = process.cpuUsage();
  45:   const statePath = join(dir, 'state.json'), recordsPath = join(dir, 'records.jsonl');
  46:   mkdirSync(join(dir, 'snapshots'), { recursive: true });
  47:   const boardsOf = {};
  48:   for (const record of records.values()) (boardsOf[record.group] ??= []).push(record);
  49:   for (const list of Object.values(boardsOf)) list.sort(byBoardId);
  50: 
  51:   let cursor = 0, probesDone = [], fingerprint = null, snapshot = null, passes = 0, fingerprints = {};
  52:   const saveState = () => writeAtomic(statePath, JSON.stringify({ schema: STATE, seed: tape.seed, arm, tapeSha256: tape.sha256,
  53:     cursor, probesDone, recordsBytes: statSync(recordsPath).size, fingerprint, snapshot }) + '\n');
  54: 
  55:   if (existsSync(statePath)) {
  56:     const state = JSON.parse(readFileSync(statePath, 'utf8'));
  57:     if (state.schema !== STATE || state.seed !== tape.seed || state.arm !== arm || state.tapeSha256 !== tape.sha256) {
  58:       throw Error('state.json does not belong to this job');
  59:     }
  60:     if (statSync(recordsPath).size < state.recordsBytes) throw Error('records.jsonl is shorter than its acknowledged state');
  61:     truncateSync(recordsPath, state.recordsBytes);
  62:     condition.restore(state.snapshot);
  63:     if (condition.fingerprint() !== state.fingerprint) throw Error('Restored fingerprint differs from state.json');
  64:     ({ cursor, probesDone, fingerprint, snapshot } = state);
  65:     ({ passes, fingerprints } = await acknowledged(recordsPath, state.recordsBytes));
  66:   } else {
  67:     writeFileSync(recordsPath, '');
  68:     fingerprint = condition.fingerprint();
  69:     snapshot = condition.snapshot();
  70:     saveState();
  71:   }
  72: 
  73:   const probe = ({ phase: label, cursor: at }) => {
  74:     if (probesDone.includes(label)) return;
  75:     if (!PROBES[label]) throw Error(`Unknown probe label ${label}`);
  76:     const fp = condition.fingerprint();
  77:     const offArm = arm === 'off-local';
  78:     if (offArm && label !== 'T0' && fp !== fingerprints.T0) {
  79:       throw Error(`off-local persistent state changed before ${label}; the off arm must never change`);
  80:     }
  81:     const reuse = offArm && label !== 'T0' && label !== 'R2-end';
  82:     let text = '', added = 0;
  83:     for (const group of PROBES[label]) for (const record of boardsOf[group] ?? []) {
  84:       if (reuse) {
  85:         text += lineOf({ type: 'ranking-reused', label, cursor: at, boardId: record.boardId, group, from: 'T0', fingerprint: fp });
  86:       } else {
  87:         const phase = group === 'R' ? 'R1' : 'chess';
  88:         const ranking = condition.rankBoard(record, { phase });
  89:         added += ranking.passes;
  90:         text += lineOf({ type: 'ranking', label, cursor: at, boardId: record.boardId, group, phase, fingerprint: fp, ranking });
  91:       }
  92:     }
  93:     if (text) appendFileSync(recordsPath, text);
  94:     passes += added;
  95:     const snap = condition.snapshot();
  96:     writeAtomic(join(dir, 'snapshots', `${label}.json`), JSON.stringify(snap) + '\n');
  97:     fingerprints[label] = fp;
  98:     probesDone = [...probesDone, label];
  99:     fingerprint = fp;
 100:     snapshot = snap;
 101:     saveState();
 102:   };
 103: 
 104:   const teachEvent = i => {
 105:     const event = tape.events[i];
 106:     const record = records.get(event.boardId);
 107:     if (!record) throw Error(`No board record for ${event.boardId}`);
 108:     const options = arm === 'shuffled-local' ? { deliveredPulse: tape.shuffledPulses[i] } : {};
 109:     const { receipt, snapshot: after } = condition.teach(record, event, options);
 110:     appendFileSync(recordsPath, lineOf({ type: 'event', cursor: receipt.sequence, receipt }));
 111:     passes += receipt.passes;
 112:     cursor = i + 1;
 113:     fingerprint = receipt.fingerprintAfter;
 114:     snapshot = after;
 115:     saveState();
 116:   };
 117: 
 118:   probe(tape.initialProbe);
 119:   for (let i = 0; i < tape.events.length; i++) {
 120:     if (i >= cursor) teachEvent(i);
 121:     for (const p of tape.probeAfter) if (p.cursor === i + 1) probe(p);
 122:   }
 123:   for (const p of [tape.initialProbe, ...tape.probeAfter]) if (!probesDone.includes(p.phase)) throw Error(`Probe ${p.phase} never ran`);
 124: 
 125:   const wall = (now() - started) / 1000, cpu = process.cpuUsage(cpuStarted);
 126:   const { peakRssMiB = null, minFreeMiB = null } = extra();
 127:   const result = { schema: RESULT, seed: tape.seed, arm, tapeSha256: tape.sha256, status: 'complete', passes,
 128:     events: tape.events.length, wallSeconds: wall, cpuSeconds: (cpu.user + cpu.system) / 1e6,
 129:     secondsPerPass: passes > 0 ? wall / passes : null, peakRssMiB, minFreeMiB, fingerprints, describe: condition.describe() };
 130:   const text = JSON.stringify(result, null, 2) + '\n';
 131:   writeAtomic(resultPath, text);
 132:   return JSON.parse(text);
 133: }
--- .codebase/scripts/neural-learning/fly-connections-memory-v1-worker.mjs
   1: #!/usr/bin/env node
   2: // Fly connections memory v1 worker: one (seed, arm) job in its own directory. Checks every pin, builds the graph-backed
   3: // condition (mapping, model, Eyes, APL package), then runs the job loop. Exit 0 on success. On any error the message goes
   4: // to stderr and the exit code is 1; state.json stays in the job directory for resume.
   5: // Usage (repo root): node --max-old-space-size=256 .codebase/scripts/neural-learning/fly-connections-memory-v1-worker.mjs --config REG --seed S --arm A --dir JOBDIR
   6: import { createHash } from 'node:crypto';
   7: import { createReadStream, readFileSync } from 'node:fs';
   8: import { join } from 'node:path';
   9: import os from 'node:os';
  10: import { parseArgs } from 'node:util';
  11: import { loadGraph, readNpz } from '../../src/runtime/graph.mjs';
  12: import { SparseTrainer } from '../../src/supervised-baselines/trainer.mjs';
  13: import { createEyesV2, loadRetina } from '../../src/chess-input/eyes-v2.mjs';
  14: import { neuronReaderCells } from '../../src/neural-learning/neuron-reader.mjs';
  15: import { mapFlyConnectionsMemory } from '../../src/neural-learning/fly-connections-teaching-v1.mjs';
  16: import { loadLocalAplPackage } from '../../src/neural-learning/fly-connections-apl-data-v1.mjs';
  17: import { createFlyCondition } from '../../src/neural-learning/fly-connections-condition-v1.mjs';
  18: import { runJob } from '../../src/neural-learning/fly-connections-job-v1.mjs';
  19: 
  20: const { values: args } = parseArgs({ options: { config: { type: 'string' }, seed: { type: 'string' }, arm: { type: 'string' }, dir: { type: 'string' } } });
  21: 
  22: async function fileSha256(path) {
  23:   const hash = createHash('sha256');
  24:   for await (const chunk of createReadStream(path)) hash.update(chunk);
  25:   return hash.digest('hex');
  26: }
  27: 
  28: async function work() {
  29:   if (!args.config || !args.seed || !args.arm || !args.dir) throw Error('Usage: --config REG --seed S --arm A --dir JOBDIR');
  30:   const config = JSON.parse(readFileSync(args.config, 'utf8').replace(/^���/, ''));
  31:   const seed = Number(args.seed), arm = args.arm, { limits } = config;
  32:   if (!Number.isSafeInteger(seed) || !config.seeds.includes(seed) || !config.arms.includes(arm)) throw Error(`Seed ${args.seed} or arm ${arm} is not registered`);
  33:   for (const [path, expected] of Object.entries(config.pins)) {
  34:     if (await fileSha256(path) !== expected) throw Error(`Changed input ${path}`);
  35:   }
  36: 
  37:   // Resource guard: called before and after every forward by the condition. Peak RSS and minimum free memory are reported.
  38:   const started = performance.now();
  39:   let forwards = 0, peakRssMiB = 0, minFreeMiB = Infinity;
  40:   const guard = ({ when }) => {
  41:     const rssMiB = process.memoryUsage().rss / 2 ** 20, freeMiB = os.freemem() / 2 ** 20;
  42:     const wallSeconds = (performance.now() - started) / 1000;
  43:     peakRssMiB = Math.max(peakRssMiB, rssMiB);
  44:     minFreeMiB = Math.min(minFreeMiB, freeMiB);
  45:     if (when === 'before') forwards++;
  46:     if (rssMiB > limits.rssMiB) throw Error(`RSS ${rssMiB.toFixed(1)} MiB exceeds ${limits.rssMiB} MiB`);
  47:     if (freeMiB < limits.freeMiB) throw Error(`Free memory ${freeMiB.toFixed(1)} MiB is below ${limits.freeMiB} MiB`);
  48:     if (when === 'before' && limits.passesPerJob > 0 && forwards > limits.passesPerJob) throw Error(`Pass budget ${limits.passesPerJob} exceeded`);
  49:     if (limits.wallSecondsPerJob > 0 && wallSeconds > limits.wallSecondsPerJob) throw Error(`Wall budget ${limits.wallSecondsPerJob} s exceeded`);
  50:   };
  51: 
  52:   const packetDir = config.paths.packet;
  53:   const packet = JSON.parse(readFileSync(join(packetDir, 'packet.json'), 'utf8'));
  54:   const records = new Map();
  55:   for (const line of readFileSync(join(packetDir, 'boards.jsonl'), 'utf8').split('\n')) {
  56:     if (!line.trim()) continue;
  57:     const record = JSON.parse(line);
  58:     records.set(record.boardId, record);
  59:   }
  60:   const tape = JSON.parse(readFileSync(join(packetDir, 'tapes', `${seed}.json`), 'utf8'));
  61:   if (tape.seed !== seed || tape.sha256 !== packet.tapes[seed]?.sha256) throw Error('Tape does not match packet.json');
  62: 
  63:   const graph = loadGraph(config.paths.graph);
  64:   const rootIds = readNpz(config.paths.graph, ['root_ids']).root_ids;
  65:   const readerCells = neuronReaderCells.cells.filter(cell => cell.type === 'MBON05');
  66:   const mapping = await mapFlyConnectionsMemory(graph, rootIds, config.paths.annotations, readerCells);
  67:   const model = new SparseTrainer(graph, config.model);
  68:   const eyes = createEyesV2(loadRetina(config.paths.graph));
  69:   const aplPackage = await loadLocalAplPackage(config.paths.aplPackage);
  70:   const condition = createFlyCondition({ model, mapping, eyes, aplPackage, arm, guard });
  71: 
  72:   await runJob({ condition, records, tape, arm, dir: args.dir,
  73:     extra: () => ({ peakRssMiB: Math.max(peakRssMiB, process.resourceUsage().maxRSS / 1024), minFreeMiB }) });
  74: }
  75: 
  76: try {
  77:   await work();
  78: } catch (error) {
  79:   console.error(error.stack ?? error.message);
  80:   process.exitCode = 1;
  81: }
--- .codebase/scripts/neural-learning/run-fly-connections-memory-v1.mjs
   1: #!/usr/bin/env node
   2: // Fly connections memory v1 runner: one registered run. Checks every pin, runs each (seed, arm) job in a worker process
   3: // (at most `workers` at once, no retries), copies finished jobs on --resume-from, computes the graph-free baselines per
   4: // seed in this process, judges the run, and writes summary.json, the records index and the terminal manifest.
   5: // Usage (repo root): node --max-old-space-size=256 .codebase/scripts/neural-learning/run-fly-connections-memory-v1.mjs --config REG [--cpu-duty 1] [--resume-from OLDRUN]
   6: import assert from 'node:assert/strict';
   7: import { createHash } from 'node:crypto';
   8: import { spawn } from 'node:child_process';
   9: import { closeSync, copyFileSync, createReadStream, existsSync, mkdirSync, openSync, readdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs';
  10: import { join } from 'node:path';
  11: import { fileURLToPath } from 'node:url';
  12: import { parseArgs } from 'node:util';
  13: import os from 'node:os';
  14: import { createEyesV2, loadRetina } from '../../src/chess-input/eyes-v2.mjs';
  15: import { runStoreBaseline, uniformBaselines } from '../../src/neural-learning/fly-connections-baselines-v1.mjs';
  16: import { judgeRun } from '../../src/neural-learning/fly-connections-judge-v1.mjs';
  17: 
  18: const WORKER = fileURLToPath(new URL('./fly-connections-memory-v1-worker.mjs', import.meta.url));
  19: const STORE_KEYS = ['raw-pc', 'random-pc'];
  20: const CHESS_GROUPS = ['A', 'B', 'testA', 'testB'];
  21: 
  22: const { values: args } = parseArgs({ options: { config: { type: 'string' }, 'cpu-duty': { type: 'string', default: '1' }, 'resume-from': { type: 'string' } } });
  23: assert.equal(args['cpu-duty'], '1', 'cpu-duty must be 1');
  24: assert(args.config, 'Missing --config');
  25: 
  26: const sha = data => createHash('sha256').update(data).digest('hex');
  27: const fileSha = async path => { const h = createHash('sha256'); for await (const chunk of createReadStream(path)) h.update(chunk); return h.digest('hex'); };
  28: const writeAtomic = (path, text) => { writeFileSync(`${path}.partial`, text); renameSync(`${path}.partial`, path); };
  29: const alive = pid => { try { process.kill(pid, 0); return true; } catch (error) { return error.code === 'EPERM'; } };
  30: 
  31: // Byte copy of a job directory; every copied file's SHA-256 is compared with its source.
  32: function copyTree(src, dst, prefix = '') {
  33:   mkdirSync(dst, { recursive: true });
  34:   return readdirSync(src, { withFileTypes: true }).flatMap(entry => {
  35:     const from = join(src, entry.name), to = join(dst, entry.name), name = `${prefix}${entry.name}`;
  36:     if (entry.isDirectory()) return copyTree(from, to, `${name}/`);
  37:     copyFileSync(from, to);
  38:     const expected = sha(readFileSync(from));
  39:     assert.equal(sha(readFileSync(to)), expected, `Copy differs from its source: ${name}`);
  40:     return [{ file: name, sha256: expected }];
  41:   });
  42: }
  43: 
  44: const registration = readFileSync(args.config);
  45: const config = JSON.parse(registration.toString('utf8').replace(/^���/, ''));
  46: assert.equal(config.paused, false, 'Refusing a registration that is paused or does not declare paused: false');
  47: assert(Number.isSafeInteger(config.workers) && config.workers >= 1, 'workers must be a positive integer');
  48: for (const [path, expected] of Object.entries(config.pins)) assert.equal(await fileSha(path), expected, `Changed input ${path}`);
  49: const out = config.paths.run, jobsDir = join(out, 'jobs');
  50: assert(!existsSync(out), 'Fresh output required');
  51: mkdirSync(jobsDir, { recursive: true });
  52: 
  53: let manifest = { schema: 'fly-connections-memory-v1-run', status: 'running', pid: process.pid, argv: process.argv,
  54:   registrationSha256: sha(registration), pins: config.pins, volume: config.volume, chapter: config.chapter,
  55:   startedAt: new Date().toISOString(), endedAt: null, resumedFrom: null, jobs: [] };
  56: const writeManifest = patch => { manifest = { ...manifest, ...patch }; writeAtomic(join(out, 'manifest.json'), JSON.stringify(manifest, null, 2) + '\n'); };
  57: writeManifest({});
  58: 
  59: // Runner-process guard: every process stays within the registered RSS and free-memory limits.
  60: function guard() {
  61:   const rssMiB = process.memoryUsage().rss / 2 ** 20, freeMiB = os.freemem() / 2 ** 20;
  62:   assert(rssMiB <= config.limits.rssMiB && freeMiB >= config.limits.freeMiB,
  63:     `Runner resource guard: ${rssMiB.toFixed(0)} MiB RSS, ${freeMiB.toFixed(0)} MiB free`);
  64: }
  65: 
  66: const jobs = config.seeds.flatMap(seed => config.arms.map(arm => ({ seed, arm, name: `${seed}-${arm}`, exitCode: null, status: 'queued' })));
  67: const jobList = () => jobs.map(({ seed, arm, name, exitCode, status }) => ({ seed, arm, name, exitCode, status }));
  68: const anyFailed = () => jobs.some(job => job.status === 'failed');
  69: 
  70: // Launcher: at most config.workers worker processes. A nonzero exit starts no new worker; running ones are waited for.
  71: function startWorker(job) {
  72:   const dir = join(jobsDir, job.name);
  73:   mkdirSync(dir, { recursive: true });
  74:   const stdout = openSync(join(dir, 'stdout.txt'), 'a'), stderr = openSync(join(dir, 'stderr.txt'), 'a');
  75:   const child = spawn(process.execPath, ['--max-old-space-size=256', WORKER, '--config', args.config, '--seed', String(job.seed), '--arm', job.arm, '--dir', dir],
  76:     { stdio: ['ignore', stdout, stderr] });
  77:   closeSync(stdout);
  78:   closeSync(stderr);
  79:   job.status = 'running';
  80:   const done = new Promise(resolve => {
  81:     child.once('error', () => resolve({ job, code: -1 }));
  82:     child.once('exit', code => resolve({ job, code }));
  83:   });
  84:   return { job, child, done };
  85: }
  86: 
  87: async function runWorkers(queue) {
  88:   const active = [];
  89:   try {
  90:     while (active.length > 0 || (!anyFailed() && queue.length > 0)) {
  91:       guard();
  92:       while (!anyFailed() && queue.length > 0 && active.length < config.workers) active.push(startWorker(queue.shift()));
  93:       const { job, code } = await Promise.race(active.map(w => w.done));
  94:       active.splice(active.findIndex(w => w.job === job), 1);
  95:       job.exitCode = code;
  96:       job.status = code === 0 ? 'complete' : 'failed';
  97:       writeManifest({ jobs: jobList() });
  98:     }
  99:   } catch (error) {
 100:     for (const w of active) w.child.kill();
 101:     throw error;
 102:   }
 103:   for (const job of queue) job.status = 'not-started';
 104:   if (anyFailed()) throw Error(`Worker failed; exit codes: ${jobs.map(j => `${j.name}=${j.exitCode}`).join(' ')}`);
 105: }
 106: 
 107: // Resume: finished jobs are copied byte for byte; unfinished job directories are copied so their worker resumes from state.json.
 108: const resumedFrom = { run: null, finished: [], unfinished: [] };
 109: const queue = [];
 110: 
 111: try {
 112:   if (args['resume-from']) {
 113:     const old = args['resume-from'];
 114:     const oldManifest = JSON.parse(readFileSync(join(old, 'manifest.json'), 'utf8'));
 115:     assert.equal(oldManifest.registrationSha256, manifest.registrationSha256, 'Resume: the registration differs from the old run');
 116:     assert.notEqual(oldManifest.status, 'complete', 'Resume: the old run is complete');
 117:     assert(!(oldManifest.status === 'running' && alive(oldManifest.pid)), 'Resume: the old run still has a live process');
 118:     resumedFrom.run = old;
 119:   }
 120:   for (const job of jobs) {
 121:     const from = args['resume-from'] ? join(args['resume-from'], 'jobs', job.name) : null;
 122:     if (from && existsSync(join(from, 'result.json'))) {
 123:       resumedFrom.finished.push({ job: job.name, files: copyTree(from, join(jobsDir, job.name)) });
 124:       job.status = 'copied';
 125:     } else {
 126:       if (from && existsSync(from)) resumedFrom.unfinished.push({ job: job.name, files: copyTree(from, join(jobsDir, job.name)) });
 127:       queue.push(job);
 128:     }
 129:   }
 130:   writeManifest({ resumedFrom: args['resume-from'] ? resumedFrom : null, jobs: jobList() });
 131: 
 132:   await runWorkers(queue);
 133:   guard();
 134: 
 135:   // Baselines per seed (graph-free). baselines.perSeed[seed][storeKey][shuffled] = runStoreBaseline output; baselines.uniform[boardId] = uniformBaselines output.
 136:   const retina = loadRetina(config.paths.graph), eyes = createEyesV2(retina);
 137:   const boards = new Map();
